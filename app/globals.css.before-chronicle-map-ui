/* =========================================================
   HOW IT WORKS
   ========================================================= */

.ru-how-page {
  --how-bg: #06111a;
  --how-cream: #f5eddb;
  --how-muted: #89919a;
  --how-gold: #d8b568;
  --how-line: rgba(220, 193, 135, 0.18);

  position: relative;
  min-height: 100vh;
  overflow: hidden;

  background:
    radial-gradient(
      circle at 50% 20%,
      rgba(34, 66, 91, .28),
      transparent 34%
    ),
    var(--how-bg);

  color: var(--how-cream);
}

.ru-how-background {
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
}

.ru-how-image {
  position: absolute;
  inset: 0;

  background-image:
    linear-gradient(
      180deg,
      rgba(4, 13, 23, .30),
      rgba(4, 13, 23, .78)
    ),
    url("/assets/backgrounds/hub-bg.png");

  background-size: cover;
  background-position: center;

  opacity: .42;
  filter:
    saturate(.82)
    contrast(1.08)
    brightness(.72);

  transform: scale(1.04);

  animation: ruHowWorld 24s ease-in-out infinite alternate;
}

.ru-how-gradient {
  position: absolute;
  inset: 0;

  background:
    linear-gradient(
      90deg,
      rgba(3, 10, 17, .88),
      rgba(3, 10, 17, .18) 50%,
      rgba(3, 10, 17, .78)
    ),
    linear-gradient(
      180deg,
      rgba(3, 9, 16, .82),
      transparent 32%,
      rgba(3, 9, 16, .94)
    );
}

.ru-how-glow {
  position: absolute;

  width: 38vw;
  height: 38vw;

  border-radius: 50%;

  filter: blur(80px);

  opacity: .18;
}

.ru-how-glow-one {
  top: 8%;
  left: 28%;

  background: #1d5c89;
}

.ru-how-glow-two {
  bottom: 5%;
  right: 5%;

  background: #9c742d;
}

.ru-how-star {
  position: absolute;

  width: 3px;
  height: 3px;

  border-radius: 50%;
  background: #e8d39d;

  box-shadow: 0 0 12px rgba(232, 211, 157, .7);

  animation: ruHowTwinkle 3s ease-in-out infinite;
}

.ru-how-star-one {
  top: 22%;
  left: 14%;
}

.ru-how-star-two {
  top: 31%;
  right: 21%;
  animation-delay: .8s;
}

.ru-how-star-three {
  top: 58%;
  left: 9%;
  animation-delay: 1.4s;
}

.ru-how-star-four {
  top: 71%;
  right: 13%;
  animation-delay: 2s;
}

