}

/* ------------------------------------------------------------
   VOICE
   ------------------------------------------------------------ */

.ru-voice {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}

.ru-voice-button {
  display: inline-flex !important;
  align-items: center;
  gap: 9px;
  min-height: 40px !important;
  padding: 0 13px !important;
  border: 1px solid rgba(255, 255, 255, 0.12) !important;
  border-radius: 8px !important;
  background: rgba(255, 255, 255, 0.045) !important;
  color: rgba(255, 255, 255, 0.67) !important;
  font-size: 9px !important;
  font-weight: 800 !important;
  letter-spacing: 0.1em;
  cursor: pointer;
  transition:
    border-color 0.2s ease,
    background 0.2s ease;
}

.ru-voice-button:hover {
  border-color: rgba(255, 211, 120, 0.35) !important;
  background: rgba(255, 211, 120, 0.07) !important;
}

.ru-voice-icon {
  color: rgba(255, 211, 120, 0.9);
}

.ru-voice-error {
  font-size: 9px;
  color: rgba(255, 150, 150, 0.75);
}

/* ------------------------------------------------------------
   QUESTION
   ------------------------------------------------------------ */

.ru-story-question-card {
  width: 100%;
  max-width: 820px;
  margin-top: 28px;
  padding: 30px;
  border-top: 1px solid rgba(255, 210, 118, 0.25);
  border-bottom: 1px solid rgba(255, 255, 255, 0.07);
}

.ru-story-question-card h2 {
  max-width: 760px;
  margin: 0 0 22px;
  font-size: clamp(23px, 2.6vw, 34px);
  line-height: 1.18;
  letter-spacing: -0.025em;
  color: rgba(255, 255, 255, 0.91);
}

.ru-story-options {
  display: grid !important;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}

.ru-story-option {
  display: flex !important;
  align-items: center;
  gap: 14px;
  width: 100% !important;
  min-height: 62px;
  padding: 12px 16px !important;
  border: 1px solid rgba(255, 255, 255, 0.095) !important;
  border-radius: 11px !important;
  background: rgba(4, 9, 22, 0.52) !important;
  color: rgba(255, 255, 255, 0.72) !important;
  text-align: left;
  cursor: pointer;
  transition:
    transform 0.18s ease,
    border-color 0.18s ease,
    background 0.18s ease;
}

.ru-story-option > span {
  display: grid;
  place-items: center;
  flex: 0 0 auto;
  width: 28px;
  height: 28px;
  border: 1px solid rgba(255, 255, 255, 0.13);
  border-radius: 7px;
  font-size: 9px;
  font-weight: 900;
  color: rgba(255, 211, 120, 0.78);
}

.ru-story-option strong {
  font-size: 13px;
  line-height: 1.35;
}

.ru-story-option:hover:not(:disabled) {
  transform: translateY(-2px);
  border-color: rgba(255, 211, 120, 0.35) !important;
  background: rgba(255, 211, 120, 0.055) !important;
}

.ru-story-option.correct {
  border-color: rgba(113, 214, 145, 0.55) !important;
  background: rgba(113, 214, 145, 0.09) !important;
}

.ru-story-option.incorrect {
  border-color: rgba(245, 112, 112, 0.5) !important;
  background: rgba(245, 112, 112, 0.07) !important;
}

/* ------------------------------------------------------------
   ANSWER RESULT
   ------------------------------------------------------------ */

.ru-story-result {
  display: grid;
  grid-template-columns: 100px minmax(0, 1fr);
  align-items: center;
  gap: 22px;
  margin-top: 22px;
  padding: 18px 20px;
  border-radius: 14px;
  background: rgba(255, 255, 255, 0.035);
}

.ru-story-result-character {
  height: 125px;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  overflow: hidden;
}

.ru-story-result-character img {
  width: 105px !important;
  height: 125px !important;
  max-width: 105px !important;
  max-height: 125px !important;
  object-fit: contain !important;
  object-position: center bottom !important;
}

.ru-story-result > div:last-child > span {
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 0.2em;
}

.ru-story-result.correct > div:last-child > span {
  color: rgba(113, 214, 145, 0.9);
}

.ru-story-result.incorrect > div:last-child > span {
  color: rgba(245, 130, 130, 0.9);
}

.ru-story-result h3 {
  margin: 7px 0;
  font-size: 20px;
  line-height: 1.2;
}

.ru-story-result p {
  max-width: 650px;
  margin: 0;
  font-size: 13px;
  line-height: 1.65;
  color: rgba(255, 255, 255, 0.56);
}

/* ------------------------------------------------------------
   NEXT MOVE
   ------------------------------------------------------------ */

.ru-next-move {
  margin-top: 30px;
  padding: 30px;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
}

.ru-next-move h2 {
  margin: 0 0 20px;
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(25px, 3vw, 38px);
  font-weight: 500;
}

.ru-next-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
}

.ru-next-grid button {
  position: relative;
  min-height: 125px;
  padding: 19px;
  border: 1px solid rgba(255, 255, 255, 0.09);
  border-radius: 12px;
  background: rgba(5, 10, 23, 0.62);
  color: rgba(255, 255, 255, 0.8);
  text-align: left;
  cursor: pointer;
  transition:
    transform 0.2s ease,
    border-color 0.2s ease,
    background 0.2s ease;
}

.ru-next-grid button:hover {
  transform: translateY(-3px);
  border-color: rgba(255, 211, 120, 0.35);
  background: rgba(255, 211, 120, 0.055);
}

.ru-next-grid button > span {
  display: block;
  margin-bottom: 23px;
  font-size: 9px;
  color: rgba(255, 211, 120, 0.7);
}

.ru-next-grid button strong {
  display: block;
  font-size: 11px;
  letter-spacing: 0.12em;
}

.ru-next-grid button small {
  display: block;
  margin-top: 7px;
  font-size: 10px;
  color: rgba(255, 255, 255, 0.38);
}

/* ------------------------------------------------------------
   CURIOSITY
   ------------------------------------------------------------ */

.ru-curiosity-panel {
  margin-top: 20px;
  padding: 22px;
  border: 1px solid rgba(255, 211, 120, 0.12);
  border-radius: 12px;
  background: rgba(255, 211, 120, 0.025);
}

.ru-curiosity-header span {
  display: block;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 0.18em;
  color: rgba(255, 211, 120, 0.75);
}

.ru-curiosity-header small {
  display: block;
  margin-top: 5px;
  font-size: 8px;
  letter-spacing: 0.12em;
  color: rgba(255, 255, 255, 0.3);
}

.ru-curiosity-list {
  display: grid;
  gap: 7px;
  margin-top: 18px;
}

.ru-curiosity-list button {
  display: grid;
  grid-template-columns: 32px minmax(0, 1fr) 20px;
  align-items: center;
  gap: 10px;
  width: 100%;
  padding: 12px;
  border: 1px solid rgba(255, 255, 255, 0.07);
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.025);
  color: rgba(255, 255, 255, 0.64);
  text-align: left;
  font-size: 12px;
  cursor: pointer;
}

.ru-curiosity-list button:hover {
  border-color: rgba(255, 211, 120, 0.25);
}

.ru-curiosity-list button span {
  color: rgba(255, 211, 120, 0.65);
  font-size: 9px;
}

.ru-curiosity-list button b {
  color: rgba(255, 211, 120, 0.7);
}

.ru-curiosity-answer {
  margin-top: 18px;
  padding: 17px;
  border-left: 1px solid rgba(255, 211, 120, 0.45);
  background: rgba(255, 255, 255, 0.025);
}

.ru-curiosity-answer > span {
  font-size: 8px;
  font-weight: 900;
  letter-spacing: 0.18em;
  color: rgba(255, 211, 120, 0.65);
}

.ru-curiosity-answer p {
  margin: 9px 0 0;
  font-size: 13px;
  line-height: 1.65;
  color: rgba(255, 255, 255, 0.6);
}

/* ------------------------------------------------------------
   RESPONSIVE
   ------------------------------------------------------------ */

@media (max-width: 900px) {
  .ru-story-scene {
    padding: 35px 22px 65px;
  }

  .ru-story-shell {
    grid-template-columns: 190px minmax(0, 1fr);
    gap: 28px;
  }

  .ru-story-character-stage {
    width: 190px;
    height: 350px;
  }

  .ru-character-frame {
    width: 170px;
    height: 260px;
  }

  .ru-character-frame img {
    width: 165px !important;
    height: 250px !important;
    max-width: 165px !important;
    max-height: 250px !important;
  }

  .ru-character-orbit {
    width: 180px;
    height: 180px;
    top: 60px;
  }

  .ru-story-options {
    grid-template-columns: 1fr;
  }

  .ru-next-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 680px) {
  .ru-story-scene {
    padding: 25px 16px 50px;
  }

  .ru-story-shell {
    grid-template-columns: 1fr;
    gap: 15px;
  }

  .ru-story-character-stage {
    position: relative;
    top: auto;
    width: 100%;
    height: 190px;
    order: -1;
  }

  .ru-character-orbit {
    width: 145px;
    height: 145px;
    top: 0;
  }

  .ru-character-frame {
    width: 135px;
    height: 155px;
  }

  .ru-character-frame img {
    width: 130px !important;
    height: 155px !important;
    max-width: 130px !important;
    max-height: 155px !important;
  }

  .ru-character-name {
    margin-top: 2px;
  }

  .ru-story-header {
    flex-direction: column;
    gap: 14px;
  }

  .ru-story-confidence {
    text-align: left;
  }

  .ru-story-title {
    font-size: 42px !important;
  }

  .ru-story-card,
  .ru-story-question-card,
  .ru-next-move {
    padding: 21px;
  }

  .ru-story-card-footer {
    align-items: flex-start;
    flex-direction: column;
  }

  .ru-story-next {
    width: 100%;
    justify-content: space-between;
  }

  .ru-story-result {
    grid-template-columns: 75px minmax(0, 1fr);
  }

  .ru-story-result-character img {
    width: 78px !important;
    height: 100px !important;
    max-width: 78px !important;
    max-height: 100px !important;
  }
}


/* =========================================================
   REALITY UNKNOWN — CINEMATIC DISCOVERY REDESIGN
   One viewport. One state. One narrator.
   ========================================================= */

.ru-cinematic-story {
  position: relative;
  width: 100%;
  height: calc(100svh - 74px);
  min-height: 620px;
  overflow: hidden;
  display: flex;
  align-items: center;
  padding: 70px clamp(24px, 6vw, 100px) 45px;
  background:
    radial-gradient(
      circle at 65% 45%,
      rgba(101, 82, 192, 0.13),
      transparent 38%
    );
}

.ru-story-vignette {
  position: absolute;
  inset: 0;
  pointer-events: none;
  background:
    linear-gradient(
      90deg,
      rgba(2, 6, 17, .97) 0%,
      rgba(2, 6, 17, .74) 35%,
      rgba(2, 6, 17, .50) 65%,
      rgba(2, 6, 17, .90) 100%
    );
}

.ru-story-vignette::before {
  content: "";
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(
      rgba(255,255,255,.018) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(255,255,255,.018) 1px,
      transparent 1px
    );
  background-size: 48px 48px;
  mask-image: linear-gradient(
    to bottom,
    transparent,
    black 20%,
    black 80%,
    transparent
  );
}

.ru-story-vignette::after {
  content: "";
  position: absolute;
  inset: 0;
  box-shadow:
    inset 0 0 160px rgba(0,0,0,.72);
  pointer-events: none;
}

.ru-cinematic-top {
  position: absolute;
  z-index: 20;
  top: 25px;
  left: clamp(24px, 6vw, 100px);
  right: clamp(24px, 6vw, 100px);
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-family:
    "Inter",
    "Helvetica Neue",
    Arial,
    sans-serif;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: .32em;
  color: rgba(240,235,220,.42);
}

.ru-cinematic-content {
  position: relative;
  z-index: 3;
  width: min(1200px, 100%);
  margin: auto;
  display: grid;
  grid-template-columns: 330px minmax(0, 780px);
  align-items: center;
  justify-content: center;
  gap: clamp(45px, 6vw, 100px);
}

.ru-cinematic-character {
  position: relative;
  height: 560px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
}

.ru-cinematic-character img {
  position: relative;
  z-index: 4;
  width: min(310px, 100%);
  max-height: 490px;
