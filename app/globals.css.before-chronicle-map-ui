.ru-archive-cta b {
  font-size: 20px;
  font-weight: 400;
}

/* FOOTER */

.ru-archive-footer {
  position: relative;
  z-index: 5;

  width: min(1400px, calc(100% - 80px));

  min-height: 90px;

  margin: 0 auto;

  display: flex;
  align-items: center;
  justify-content: space-between;

  border-top: 1px solid var(--archive-line);

  color: rgba(245,237,219,.3);

  font-size: 8px;
  letter-spacing: .28em;
}

.ru-archive-footer a {
  color: var(--archive-gold);
}

/* ANIMATIONS */

@keyframes ruArchiveWorld {
  from {
    transform: scale(1.02);
  }

  to {
    transform: scale(1.09);
  }
}

@keyframes ruArchiveTwinkle {
  0%, 100% {
    opacity: .2;
    transform: scale(.7);
  }

  50% {
    opacity: 1;
    transform: scale(1.5);
  }
}

@keyframes ruArchiveScroll {
  0%, 100% {
    opacity: .25;
    transform: scaleY(.65);
    transform-origin: top;
  }

  50% {
    opacity: 1;
    transform: scaleY(1);
    transform-origin: top;
  }
}

/* RESPONSIVE */

@media (max-width: 900px) {

  .ru-archive-nav {
    width: calc(100% - 40px);
  }

  .ru-archive-nav-title {
    display: none;
  }

  .ru-archive-nav nav {
    gap: 18px;
  }

  .ru-archive-nav nav a:nth-child(2) {
    display: none;
  }

  .ru-archive-feature,
  .ru-archive-categories {
    width: calc(100% - 40px);
  }

  .ru-archive-category-heading {
    grid-template-columns: 1fr;
    gap: 25px;
  }

  .ru-archive-item {
    grid-template-columns: 50px 150px 1fr 35px;
  }

  .ru-archive-item-copy {
    grid-column: 3;
  }

  .ru-archive-item-arrow {
    grid-column: 4;
    grid-row: 1;
  }

}

@media (max-width: 650px) {

  .ru-archive-nav {
    min-height: 78px;
  }

  .ru-archive-brand {
    width: 55px;
  }

  .ru-archive-nav nav a {
    font-size: 8px;
  }

  .ru-archive-nav nav a:first-child {
    display: none;
  }

  .ru-archive-hero {
    min-height: 82vh;
  }

  .ru-archive-hero h1 {
    font-size: clamp(57px, 16vw, 90px);
  }

  .ru-archive-hero p {
    font-size: 14px;
  }

  .ru-archive-hero-meta {
    flex-wrap: wrap;
    line-height: 2;
  }

  .ru-archive-feature {
    padding-top: 70px;
  }

  .ru-archive-feature-frame {
    height: 560px;
  }

  .ru-archive-feature-copy {
    left: 25px;
    right: 25px;
    bottom: 30px;
  }

  .ru-archive-feature-copy h2 {
    font-size: 55px;
  }

  .ru-archive-feature-corner {
    top: 16px;
    right: 16px;

    width: 45px;
    height: 45px;
  }

  .ru-archive-categories {
    padding-top: 90px;
  }

  .ru-archive-category-heading h2 {
    font-size: 56px;
  }

  .ru-archive-item {
    grid-template-columns: 35px 1fr 30px;

    padding: 25px 0;
    gap: 15px;
  }

  .ru-archive-item-image {
    grid-column: 2;
    grid-row: 1;

    height: 170px;
  }

  .ru-archive-item-main {
    grid-column: 2;
    grid-row: 2;
  }

  .ru-archive-item-copy {
    grid-column: 2;
    grid-row: 3;
  }

  .ru-archive-item-arrow {
    grid-column: 3;
    grid-row: 1;
  }

  .ru-archive-footer {
    width: calc(100% - 40px);
  }

  .ru-archive-footer span:nth-child(2) {
    display: none;
  }

}


/* =========================================================
   ARCHIVE — CHARACTER THUMBNAILS
   Make character artwork clearer and more prominent
   ========================================================= */

.ru-archive-item-image {
  overflow: hidden;
  position: relative;
  background: #07111c;
}

.ru-archive-item-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;

  /* brighter character artwork */
  filter:
    brightness(1.12)
    contrast(1.04)
    saturate(1.08);

  transform: scale(1.06);

  transition:
    transform .65s cubic-bezier(.2,.8,.2,1),
    filter .5s ease;
}

/* subtle cinematic light over the artwork */
.ru-archive-item-image::after {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;

  background:
    linear-gradient(
      90deg,
      rgba(4,10,18,.05) 0%,
      rgba(4,10,18,0) 45%,
      rgba(4,10,18,.08) 100%
    );
}

/* hover */
.ru-archive-item:hover .ru-archive-item-image img {
  transform: scale(1.12);

  filter:
    brightness(1.2)
    contrast(1.06)
    saturate(1.12);
}

/* slightly larger thumbnails */
.ru-archive-item-image {
  width: 180px;
  height: 120px;
}

/* keep character subjects visually centered */
.ru-archive-item-image img {
  object-position: center center;
}

@media (max-width: 900px) {
  .ru-archive-item-image {
    width: 150px;
    height: 105px;
  }
}

@media (max-width: 640px) {
  .ru-archive-item-image {
    width: 100%;
    height: 220px;
  }

  .ru-archive-item-image img {
    transform: scale(1.03);
  }
}


/* Archive atmospheric background — reveal artwork */
.ru-archive-page {
  background:
    linear-gradient(
      180deg,
      rgba(3,10,18,.58) 0%,
      rgba(3,10,18,.70) 55%,
      rgba(2,8,14,.82) 100%
    );
}

.ru-archive-page .ru-world-image {
  opacity: .42;
  filter:
    brightness(.82)
    saturate(.9)
    contrast(1.05);
}


/* Character artwork should remain fully readable */
.ru-archive-character-image img {
  object-fit: contain;
  object-position: center bottom;
  padding: 4px;
}


/* =========================================================
   ARCHIVE — SHOW CHARACTER ARTWORK COMPLETELY
   ========================================================= */

/* Character entries: don't crop the artwork */
.ru-archive-item:nth-child(2) .ru-archive-item-image img,
.ru-archive-item:nth-child(3) .ru-archive-item-image img {
  object-fit: contain !important;
  object-position: center center !important;
  transform: scale(1.0) !important;

  filter:
    brightness(1.18)
    contrast(1.06)
    saturate(1.12) !important;
}

/* Give characters more visual room */
.ru-archive-item:nth-child(2) .ru-archive-item-image,
.ru-archive-item:nth-child(3) .ru-archive-item-image {
  height: 145px !important;
  min-height: 145px !important;
  background: rgba(5, 14, 24, 0.92);
}

/* Make the character image area feel like a framed collectible */
.ru-archive-item:nth-child(2) .ru-archive-item-image,
.ru-archive-item:nth-child(3) .ru-archive-item-image {
  border: 1px solid rgba(218, 180, 91, 0.22);
  box-shadow:
    inset 0 0 30px rgba(0, 0, 0, 0.35),
    0 10px 35px rgba(0, 0, 0, 0.18);
}

/* subtle premium hover */
.ru-archive-item:nth-child(2):hover .ru-archive-item-image img,
.ru-archive-item:nth-child(3):hover .ru-archive-item-image img {
  transform: scale(1.04) !important;
  filter:
    brightness(1.28)
    contrast(1.08)
    saturate(1.16) !important;
}

@media (max-width: 900px) {
  .ru-archive-item:nth-child(2) .ru-archive-item-image,
  .ru-archive-item:nth-child(3) .ru-archive-item-image {
    height: 125px !important;
    min-height: 125px !important;
  }
}

@media (max-width: 640px) {
  .ru-archive-item:nth-child(2) .ru-archive-item-image,
  .ru-archive-item:nth-child(3) .ru-archive-item-image {
    height: 220px !important;
    min-height: 220px !important;
  }
}


/* =========================================================
   REALITY UNKNOWN — HOW IT WORKS / PREMIUM EXPERIENCE
   ========================================================= */

.ru-how-page {
  --how-bg: #030b14;
  --how-cream: #f5eddb;
  --how-gold: #d8b568;
  --how-muted: #89929b;
  --how-line: rgba(218, 181, 104, 0.18);

  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: var(--how-bg);
  color: var(--how-cream);
}

/* ATMOSPHERE */

.ru-how-atmosphere {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 0;
  overflow: hidden;
}

.ru-how-bg-image {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(
      180deg,
      rgba(2, 8, 16, .42),
      rgba(2, 8, 16, .68)
    ),
    url("/assets/backgrounds/hub-bg.png") center / cover no-repeat;
  opacity: .34;
  transform: scale(1.04);
}

.ru-how-bg-overlay {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(
      circle at 50% 35%,
      transparent 0%,
      rgba(2, 8, 16, .2) 38%,
      rgba(2, 8, 16, .88) 100%
    );
}

.ru-how-blue-glow {
  position: absolute;
  width: 720px;
  height: 720px;
  left: 50%;
  top: 20%;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  background: rgba(32, 91, 160, .12);
  filter: blur(100px);
  animation: ruHowGlow 7s ease-in-out infinite alternate;
}

.ru-how-gold-glow {
  position: absolute;
  width: 400px;
  height: 400px;
  right: 5%;
  top: 35%;
  border-radius: 50%;
  background: rgba(216, 181, 104, .055);
  filter: blur(90px);
  animation: ruHowGlow 9s ease-in-out infinite alternate-reverse;
}

@keyframes ruHowGlow {
  from {
    transform: translate(-50%, -50%) scale(.9);
    opacity: .45;
  }
  to {
    transform: translate(-50%, -50%) scale(1.12);
    opacity: .85;
  }
}

/* PARTICLES */

.ru-how-particle {
  position: absolute;
  width: 3px;
  height: 3px;
  border-radius: 50%;
  background: var(--how-gold);
  box-shadow: 0 0 14px rgba(216, 181, 104, .8);
  animation: ruHowFloat 5s ease-in-out infinite;
}

.p1 { left: 17%; top: 24%; }
.p2 { left: 72%; top: 18%; animation-delay: 1s; }
.p3 { left: 83%; top: 54%; animation-delay: 2s; }
.p4 { left: 27%; top: 67%; animation-delay: 3s; }
.p5 { left: 59%; top: 78%; animation-delay: 1.5s; }

@keyframes ruHowFloat {
  0%, 100% {
    opacity: .25;
    transform: translateY(0);
  }
  50% {
    opacity: 1;
    transform: translateY(-14px);
  }
}

/* ORBITS */

.ru-how-orbit {
  position: absolute;
  border: 1px solid rgba(216, 181, 104, .11);
  border-radius: 50%;
  transform: rotate(-24deg);
}

.orbit-a {
  width: 760px;
  height: 290px;
  left: 50%;
  top: 38%;
  transform: translate(-50%, -50%) rotate(-28deg);
}

.orbit-b {
  width: 570px;
  height: 980px;
  left: 50%;
  top: 38%;
  transform: translate(-50%, -50%) rotate(31deg);
}

/* NAV */

.ru-how-nav {
  position: relative;
  z-index: 20;
  height: 92px;
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  padding: 0 4.5vw;
  border-bottom: 1px solid rgba(218, 181, 104, .1);
}

.ru-how-brand {
  display: flex;
  align-items: center;
  width: fit-content;
}

.ru-how-brand img {
  width: 82px;
  height: auto;
  object-fit: contain;
}

.ru-how-nav-title {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 9px;
  letter-spacing: .34em;
  color: var(--how-gold);
}

.ru-how-nav-title span {
  opacity: .55;
}

.ru-how-nav nav {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 34px;
}

.ru-how-nav nav a {
  position: relative;
  color: rgba(245, 237, 219, .72);
  text-decoration: none;
  font-size: 9px;
  letter-spacing: .25em;
  transition:
    color .3s ease,
    transform .3s ease;
}

.ru-how-nav nav a::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: -8px;
  height: 1px;
  background: var(--how-gold);
  transform: scaleX(0);
  transform-origin: right;
  transition: transform .35s ease;
}

.ru-how-nav nav a:hover {
  color: var(--how-cream);
  transform: translateY(-2px);
}

.ru-how-nav nav a:hover::after {
  transform: scaleX(1);
  transform-origin: left;
}

/* HERO */

.ru-how-hero {
  position: relative;
  z-index: 2;
  min-height: calc(100vh - 92px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80px 8vw 120px;
}

.ru-how-hero-copy {
  position: relative;
  z-index: 5;
  width: min(680px, 52vw);
  margin-right: 25vw;
}

.ru-how-eyebrow {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 30px;
  color: var(--how-gold);
  font-size: 9px;
  letter-spacing: .4em;
}

.ru-how-eyebrow i {
  width: 28px;
  height: 1px;
  background: var(--how-gold);
  opacity: .7;
}

.ru-how-hero h1 {
  margin: 0;
  font-family: Georgia, "Times New Roman", serif;
  font-weight: 400;
  font-size: clamp(76px, 8vw, 138px);
  line-height: .78;
  letter-spacing: -.065em;
}

.ru-how-hero h1 em,
.ru-how-hero h1 strong {
  display: block;
}

.ru-how-hero h1 em {
  color: rgba(245, 237, 219, .45);
  font-style: italic;
  font-weight: 400;
  padding-left: 8%;
}

.ru-how-hero h1 strong {
  color: var(--how-cream);
  font-weight: 400;
}

.ru-how-hero-copy > p {
  max-width: 540px;
  margin: 48px 0 0;
  color: rgba(245, 237, 219, .58);
  font-size: 15px;
  line-height: 1.8;
}

.ru-how-hero-meta {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-top: 38px;
  color: rgba(216, 181, 104, .7);
  font-size: 8px;
  letter-spacing: .28em;
}

.ru-how-hero-meta b {
  width: 34px;
  height: 1px;
  background: var(--how-line);
}

/* CHARACTER */

.ru-how-hero-art {
  position: absolute;
  z-index: 3;
  right: 7vw;
  bottom: 5%;
  width: min(470px, 34vw);
  display: flex;
  justify-content: center;
  align-items: flex-end;
}

.ru-how-hero-art img {
  position: relative;
  z-index: 2;
  width: 100%;
  height: auto;
  object-fit: contain;
  filter:
    drop-shadow(0 30px 60px rgba(0,0,0,.65))
    drop-shadow(0 0 30px rgba(40,110,190,.12));
  animation: ruHowCharacter 6s ease-in-out infinite;
}

@keyframes ruHowCharacter {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-12px);
  }
}

.ru-how-art-ring {
  position: absolute;
  width: 90%;
  aspect-ratio: 1;
  border-radius: 50%;
  border: 1px solid rgba(216, 181, 104, .18);
  box-shadow:
    0 0 80px rgba(30, 96, 170, .12),
    inset 0 0 60px rgba(30, 96, 170, .08);
  animation: ruHowRing 12s linear infinite;
}

@keyframes ruHowRing {
  to {
    transform: rotate(360deg);
  }
}

.ru-how-art-label {
  position: absolute;
  z-index: 4;
  right: -40px;
  bottom: 17%;
  display: flex;
  flex-direction: column;
  gap: 5px;
  padding-left: 14px;
  border-left: 1px solid var(--how-gold);
}

.ru-how-art-label small {
  color: var(--how-gold);
  font-size: 7px;
  letter-spacing: .3em;
}

.ru-how-art-label strong {
  color: var(--how-cream);
  font-size: 10px;
  letter-spacing: .18em;
}

/* SCROLL */

.ru-how-scroll {
  position: absolute;
  bottom: 35px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 12px;
  color: rgba(245, 237, 219, .42);
  font-size: 8px;
  letter-spacing: .3em;
}

.ru-how-scroll span {
  width: 30px;
  height: 1px;
  background: var(--how-gold);
}

.ru-how-scroll b {
  color: var(--how-gold);
  font-size: 14px;
  animation: ruHowArrow 1.5s ease-in-out infinite;
}

@keyframes ruHowArrow {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(5px); }
}

/* JOURNEY */

.ru-how-journey {
  position: relative;
  z-index: 3;
  width: min(1320px, 86vw);
  margin: 0 auto;
  padding: 160px 0 180px;
}

.ru-how-journey-heading {
  display: grid;
  grid-template-columns: 1fr .7fr;
  gap: 100px;
  align-items: end;
  margin-bottom: 90px;
}

.ru-how-journey-heading > div > span {
  color: var(--how-gold);
  font-size: 8px;
  letter-spacing: .4em;
}

.ru-how-journey-heading h2 {
  margin: 22px 0 0;
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(55px, 6vw, 92px);
  line-height: .88;
  letter-spacing: -.06em;
  font-weight: 400;
}

.ru-how-journey-heading h2 em {
  display: block;
  color: rgba(245, 237, 219, .42);
  font-style: italic;
}

.ru-how-journey-heading > p {
  max-width: 330px;
  margin: 0;
  color: var(--how-muted);
  font-size: 14px;
  line-height: 1.8;
}

/* TIMELINE */

.ru-how-timeline {
  position: relative;
}

.ru-how-timeline-line {
  position: absolute;
  left: 42px;
  top: 0;
  bottom: 0;
  width: 1px;
  background: linear-gradient(
    to bottom,
    transparent,
    var(--how-line) 8%,
    var(--how-line) 92%,
    transparent
  );
}

.ru-how-timeline-line span {
  position: sticky;
  top: 50%;
  display: block;
  width: 5px;
  height: 5px;
  margin-left: -2px;
  border-radius: 50%;
  background: var(--how-gold);
  box-shadow: 0 0 20px var(--how-gold);
}

.ru-how-step {
  position: relative;
  display: grid;
  grid-template-columns: 86px 1fr 40px;
  align-items: center;
  min-height: 190px;
  border-top: 1px solid var(--how-line);
  transition:
    background .45s ease,
    padding .45s ease;
}

.ru-how-step:last-child {
  border-bottom: 1px solid var(--how-line);
}

.ru-how-step:hover {
  background:
    linear-gradient(
      90deg,
      rgba(216,181,104,.045),
      transparent 70%
    );
  padding-left: 15px;
}

.ru-how-step-index {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  border: 1px solid rgba(216,181,104,.35);
  border-radius: 50%;
  background: var(--how-bg);
  transition: all .35s ease;
}

.ru-how-step:hover .ru-how-step-index {
  border-color: var(--how-gold);
  box-shadow: 0 0 30px rgba(216,181,104,.15);
}

.ru-how-step-index span {
  color: var(--how-gold);
  font-size: 8px;
  letter-spacing: .12em;
}

.ru-how-step-main {
  display: grid;
  grid-template-columns: .8fr 1.2fr;
  gap: 80px;
  align-items: center;
}

.ru-how-step-title small {
  color: var(--how-gold);
  font-size: 8px;
  letter-spacing: .32em;
}

.ru-how-step-title h3 {
  margin: 12px 0 0;
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(28px, 3vw, 43px);
  line-height: 1;
  font-weight: 400;
  letter-spacing: -.04em;
}

.ru-how-step-copy p {
  max-width: 500px;
  margin: 0;
  color: rgba(245,237,219,.53);
  font-size: 13px;
  line-height: 1.8;
}

.ru-how-step-copy em {
  display: block;
  margin-top: 15px;
  color: rgba(216,181,104,.68);
  font-family: Georgia, "Times New Roman", serif;
  font-size: 13px;
}

.ru-how-step-arrow {
  color: rgba(216,181,104,.5);
  font-size: 22px;
  transition:
    transform .35s ease,
    color .35s ease;
}

.ru-how-step:hover .ru-how-step-arrow {
  color: var(--how-gold);
  transform: translate(5px, -5px);
}

/* FINAL */

.ru-how-final {
  position: relative;
  z-index: 3;
  min-height: 780px;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  overflow: hidden;
  border-top: 1px solid var(--how-line);
}

.ru-how-final-ring {
  position: absolute;
  width: 650px;
  height: 650px;
  border: 1px solid rgba(216,181,104,.13);
  border-radius: 50%;
  animation: ruHowFinalRing 18s linear infinite;
}

.ru-how-final-ring::before,
.ru-how-final-ring::after {
  content: "";
  position: absolute;
  inset: 70px;
  border: 1px solid rgba(53,130,202,.1);
  border-radius: 50%;
}

.ru-how-final-ring::after {
  inset: 150px;
}

@keyframes ruHowFinalRing {
  to {
    transform: rotate(360deg);
  }
}

.ru-how-final > div:last-child {
  position: relative;
  z-index: 2;
}

.ru-how-final > div:last-child > span {
  color: var(--how-gold);
  font-size: 8px;
  letter-spacing: .4em;
}

.ru-how-final h2 {
  margin: 30px 0 0;
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(70px, 9vw, 140px);
  line-height: .78;
  letter-spacing: -.07em;
  font-weight: 400;
}

.ru-how-final h2 em {
  display: block;
  color: rgba(245,237,219,.42);
  font-style: italic;
}

.ru-how-final p {
  margin: 35px 0;
  color: var(--how-muted);
  font-size: 14px;
}

.ru-how-cta {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 35px;
  padding: 17px 25px 17px 30px;
  border: 1px solid rgba(216,181,104,.65);
  border-radius: 999px;
  color: var(--how-cream);
  text-decoration: none;
  font-size: 9px;
  letter-spacing: .28em;
  overflow: hidden;
  transition:
    color .35s ease,
    box-shadow .35s ease,
    transform .35s ease;
}

.ru-how-cta::before {
  content: "";
  position: absolute;
  inset: 0;
  background: var(--how-gold);
  transform: translateX(-102%);
  transition: transform .45s cubic-bezier(.22,1,.36,1);
}

.ru-how-cta:hover::before {
  transform: translateX(0);
}

.ru-how-cta:hover {
  color: #07101a;
  box-shadow: 0 0 45px rgba(216,181,104,.18);
  transform: translateY(-3px);
}

.ru-how-cta span,
.ru-how-cta b {
  position: relative;
  z-index: 2;
}

.ru-how-cta b {
  font-size: 17px;
  font-weight: 400;
}

/* FOOTER */

.ru-how-footer {
  position: relative;
  z-index: 3;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 25px 4.5vw;
  border-top: 1px solid var(--how-line);
  color: rgba(245,237,219,.35);
  font-size: 7px;
  letter-spacing: .3em;
}

.ru-how-footer a {
  color: var(--how-gold);
  text-decoration: none;
}

/* RESPONSIVE */

@media (max-width: 1000px) {
  .ru-how-nav {
    grid-template-columns: 1fr auto;
  }

  .ru-how-nav-title {
    display: none;
  }

  .ru-how-nav nav a:last-child {
    display: none;
  }

  .ru-how-hero {
    padding-top: 70px;
  }

  .ru-how-hero-copy {
    width: 60vw;
    margin-right: 25vw;
  }

  .ru-how-hero-art {
    right: -5vw;
    opacity: .72;
  }

  .ru-how-step-main {
    grid-template-columns: 1fr 1.2fr;
    gap: 35px;
  }
}

@media (max-width: 700px) {
  .ru-how-nav {
    height: 76px;
    padding: 0 20px;
  }

  .ru-how-brand img {
    width: 66px;
  }

  .ru-how-nav nav {
    gap: 16px;
  }

  .ru-how-nav nav a {
    font-size: 7px;
  }

  .ru-how-hero {
    min-height: calc(100vh - 76px);
    padding: 70px 25px 110px;
    align-items: center;
  }

  .ru-how-hero-copy {
    width: 100%;
    margin: 0;
    text-align: center;
  }

  .ru-how-eyebrow {
    justify-content: center;
  }

  .ru-how-hero h1 {
    font-size: clamp(58px, 16vw, 88px);
  }

  .ru-how-hero h1 em {
    padding-left: 0;
  }

  .ru-how-hero-copy > p {
    margin: 35px auto 0;
    max-width: 440px;
  }

  .ru-how-hero-meta {
    justify-content: center;
  }

  .ru-how-hero-art {
    width: 290px;
    right: 50%;
    bottom: -10%;
    transform: translateX(50%);
    opacity: .17;
  }

  .ru-how-art-label {
    display: none;
  }

  .ru-how-scroll {
    bottom: 25px;
  }

  .ru-how-journey {
    width: calc(100% - 40px);
    padding: 100px 0;
  }

  .ru-how-journey-heading {
    display: block;
    margin-bottom: 60px;
  }

  .ru-how-journey-heading h2 {
    font-size: 60px;
  }

  .ru-how-journey-heading > p {
    margin-top: 30px;
  }

  .ru-how-timeline-line {
    left: 21px;
  }

  .ru-how-step {
    grid-template-columns: 44px 1fr 20px;
    min-height: 220px;
  }

  .ru-how-step-main {
    display: block;
    padding-left: 15px;
  }

  .ru-how-step-copy {
    margin-top: 20px;
  }

  .ru-how-step-arrow {
    font-size: 17px;
  }

  .ru-how-final {
    min-height: 600px;
  }

  .ru-how-final-ring {
    width: 430px;
    height: 430px;
  }

  .ru-how-final h2 {
    font-size: 70px;
  }

  .ru-how-footer {
    flex-direction: column;
    gap: 12px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .ru-how-blue-glow,
  .ru-how-gold-glow,
  .ru-how-particle,
  .ru-how-hero-art img,
  .ru-how-art-ring,
  .ru-how-final-ring {
    animation: none;
  }
}


/* =========================================================
   REALITY UNKNOWN — ENTER REALITY
   GAME GATEWAY
   ========================================================= */

.ru-enter-page {
  --enter-bg: #020911;
  --enter-cream: #f5eddb;
  --enter-gold: #d8b568;
  --enter-blue: #4d9bd8;
  --enter-muted: #7d8992;

  position: relative;
  min-height: 100svh;
  overflow: hidden;

  background: var(--enter-bg);
  color: var(--enter-cream);
}

/* =========================================================
   WORLD
   ========================================================= */

.ru-enter-world {
  position: fixed;
  inset: 0;
  z-index: 0;
  overflow: hidden;
  pointer-events: none;
}

.ru-enter-world-image {
  position: absolute;
  inset: -4%;

  background:
    url("/assets/backgrounds/hub-bg.png")
    center / cover
    no-repeat;

  opacity: .48;

  filter:
    brightness(.58)
    saturate(.78)
    contrast(1.1);

  animation:
    ruEnterWorldMove 24s ease-in-out infinite alternate;
}

@keyframes ruEnterWorldMove {
  from {
    transform: scale(1.02);
  }

  to {
    transform: scale(1.08);
  }
}

.ru-enter-world-color {
  position: absolute;
  inset: 0;

  background:
    radial-gradient(
      circle at 50% 45%,
      rgba(37, 102, 158, .18),
      transparent 38%
    ),
    radial-gradient(
      circle at 80% 20%,
      rgba(216,181,104,.06),
      transparent 25%
    );
}

.ru-enter-vignette {
  position: absolute;
  inset: 0;

  background:
    radial-gradient(
      ellipse at center,
      transparent 18%,
      rgba(1,6,11,.78) 100%
    ),
    linear-gradient(
      180deg,
      rgba(1,6,11,.4),
      transparent 35%,
      rgba(1,6,11,.72)
    );
}

/* MIST */

.ru-enter-mist {
  position: absolute;

  width: 600px;
  height: 180px;

  border-radius: 50%;

  background: rgba(65, 124, 164, .07);

  filter: blur(50px);

  animation:
    ruEnterMist 12s ease-in-out infinite alternate;
}

.mist-one {
  left: -10%;
  bottom: 15%;
}

.mist-two {
  right: -15%;
  top: 30%;
  animation-delay: 3s;
}

@keyframes ruEnterMist {
  from {
    transform: translateX(-40px);
    opacity: .35;
  }

  to {
    transform: translateX(80px);
    opacity: .75;
  }
}

/* STARS */

.ru-enter-star {
  position: absolute;

  width: 2px;
  height: 2px;

  border-radius: 50%;

  background: var(--enter-gold);

  box-shadow:
    0 0 12px rgba(216,181,104,.9);

  animation:
    ruEnterStar 4s ease-in-out infinite;
}

.star-one { left: 13%; top: 24%; }
.star-two { left: 82%; top: 17%; animation-delay: 1s; }
.star-three { left: 8%; top: 72%; animation-delay: 2s; }
.star-four { left: 91%; top: 63%; animation-delay: 3s; }
.star-five { left: 62%; top: 10%; animation-delay: .5s; }

@keyframes ruEnterStar {
  0%,100% {
    opacity: .2;
    transform: scale(.6);
  }

  50% {
    opacity: 1;
    transform: scale(1.5);
  }
}

/* =========================================================
   HEADER
   ========================================================= */

.ru-enter-header {
  position: relative;
  z-index: 20;

  height: 88px;

  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;

  padding: 0 4.5vw;

  border-bottom:
    1px solid rgba(216,181,104,.11);
}

.ru-enter-logo {
  width: 72px;
}

.ru-enter-logo img {
  width: 100%;
  height: auto;
}

.ru-enter-status {
  display: flex;
  align-items: center;
  gap: 9px;

  color: rgba(245,237,219,.43);

  font-size: 7px;
  letter-spacing: .32em;
}

.ru-enter-status-dot {
  width: 5px;
  height: 5px;

  border-radius: 50%;

  background: var(--enter-gold);

  box-shadow:
    0 0 12px rgba(216,181,104,.8);

  animation:
    ruEnterPulse 2s ease-in-out infinite;
}

@keyframes ruEnterPulse {
  50% {
    opacity: .35;
  }
}

.ru-enter-archive {
  justify-self: end;

  color: var(--enter-gold);

  font-size: 8px;
  letter-spacing: .28em;
  text-decoration: none;
}

.ru-enter-archive span {
  display: inline-block;
  margin-left: 8px;

  font-size: 15px;

  transition:
    transform .3s ease;
}

.ru-enter-archive:hover span {
  transform: translate(3px,-3px);
}

/* =========================================================
   SIDE HUD
   ========================================================= */

.ru-enter-side {
  position: absolute;
  z-index: 10;

  top: 50%;

  display: flex;
  align-items: center;
  gap: 12px;

  color: rgba(245,237,219,.25);

  font-size: 7px;
  letter-spacing: .3em;

  writing-mode: vertical-rl;
}

.ru-enter-side i {
  width: 1px;
  height: 45px;

  background: rgba(216,181,104,.35);
}

.left-side {
  left: 25px;
  transform: translateY(-50%);
}

.right-side {
  right: 25px;
  transform: translateY(-50%) rotate(180deg);
}

/* =========================================================
   MAIN
   ========================================================= */

.ru-enter-main {
  position: relative;
  z-index: 5;

  min-height:
    calc(100svh - 138px);

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  padding: 40px 24px 80px;
}

/* EYEBROW */

.ru-enter-eyebrow {
  display: flex;
  align-items: center;
  gap: 14px;

  color: var(--enter-gold);

  font-size: 8px;
  letter-spacing: .42em;
}

.ru-enter-eyebrow span {
  width: 32px;
  height: 1px;

  background: rgba(216,181,104,.65);
}

/* =========================================================
   CHARACTER
   ========================================================= */

.ru-enter-character {
  position: absolute;

  width: min(410px, 34vw);

  right: 13%;
  bottom: 2%;

  display: flex;
  justify-content: center;
  align-items: flex-end;

  pointer-events: none;
}

.ru-enter-character img {
  position: relative;
  z-index: 3;

  width: 100%;
  height: auto;

  object-fit: contain;

  filter:
    drop-shadow(0 35px 65px rgba(0,0,0,.75))
    drop-shadow(0 0 35px rgba(56,130,186,.16));

  animation:
    ruEnterCharacterFloat 6s ease-in-out infinite;
}

@keyframes ruEnterCharacterFloat {
  0%,100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-12px);
  }
}

.ru-enter-character-glow {
  position: absolute;

  width: 90%;
  aspect-ratio: 1;

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      rgba(47,118,174,.22),
      transparent 67%
    );

  filter: blur(12px);
}

.ru-enter-character-ring {
  position: absolute;

  border: 1px solid rgba(216,181,104,.17);

  border-radius: 50%;
}

.ring-one {
  width: 92%;
  aspect-ratio: 1;

  animation:
    ruEnterRing 16s linear infinite;
}

.ring-two {
  width: 70%;
  aspect-ratio: 1;

  border-color: rgba(62,133,186,.14);

  animation:
    ruEnterRing 11s linear infinite reverse;
}

@keyframes ruEnterRing {
  to {
    transform: rotate(360deg);
  }
}

.ru-enter-character-tag {
  position: absolute;

  z-index: 5;

  right: -15px;
  bottom: 25%;

  display: flex;
  flex-direction: column;

  padding-left: 12px;

  border-left:
    1px solid var(--enter-gold);
}

.ru-enter-character-tag span {
  color: var(--enter-gold);

  font-size: 6px;
  letter-spacing: .3em;
}

.ru-enter-character-tag strong {
  margin-top: 4px;

  color: var(--enter-cream);

  font-family:
    Georgia,
    serif;

  font-size: 20px;

  font-weight: 400;
}

/* =========================================================
   COPY
   ========================================================= */

.ru-enter-copy {
  position: relative;
  z-index: 10;

  width: min(700px, 80vw);

  text-align: center;

  margin-top: 25px;
}

.ru-enter-copy h1 {
  margin: 20px 0 0;

  display: flex;
  flex-direction: column;

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size: clamp(90px, 11vw, 170px);

  line-height: .72;

  font-weight: 400;

  letter-spacing: -.075em;

  text-shadow:
    0 20px 50px rgba(0,0,0,.45);
}

.ru-enter-copy h1 em {
  color: rgba(245,237,219,.45);

  font-style: italic;
}

.ru-enter-copy p {
  width: min(470px, 100%);

  margin: 42px auto 0;

  color: rgba(245,237,219,.55);

  font-size: 14px;
  line-height: 1.8;
}

/* =========================================================
   DISCOVER BUTTON
   ========================================================= */

.ru-enter-discover {
  position: relative;

  margin-top: 35px;

  width: 235px;
  height: 58px;

  border:
    1px solid rgba(216,181,104,.72);

  border-radius: 999px;

  background:
    rgba(4,13,22,.62);

  color: var(--enter-cream);

  cursor: pointer;

  overflow: hidden;

  transition:
    transform .35s ease,
    box-shadow .35s ease,
    border-color .35s ease;
}

.ru-enter-discover:hover {
  transform: translateY(-4px);

  border-color: var(--enter-gold);

  box-shadow:
    0 0 45px rgba(216,181,104,.15);
}

.ru-enter-button-inner {
  position: relative;
  z-index: 3;

  height: 100%;

  display: flex;
  align-items: center;
  justify-content: center;

  gap: 14px;

  font-size: 8px;
  letter-spacing: .22em;
}

.ru-enter-button-icon {
  color: var(--enter-gold);

  font-size: 15px;

  animation:
    ruEnterIcon 2.5s ease-in-out infinite;
}

@keyframes ruEnterIcon {
  50% {
    transform: scale(1.25);
    opacity: .65;
  }
}

.ru-enter-button-inner b {
  color: var(--enter-gold);

  font-size: 18px;

  font-weight: 400;

  transition:
    transform .3s ease;
}

.ru-enter-discover:hover
.ru-enter-button-inner b {
  transform: translateX(4px);
}

.ru-enter-button-orbit {
  position: absolute;

  width: 100px;
  height: 100px;

  left: -20px;
  top: -25px;

  border-radius: 50%;

  border:
    1px solid rgba(216,181,104,.12);

  animation:
    ruEnterButtonOrbit 8s linear infinite;
}

@keyframes ruEnterButtonOrbit {
  to {
    transform: rotate(360deg);
  }
}

/* DETECTED */

.ru-enter-detected {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 10px;

  margin-top: 15px;

  color: rgba(216,181,104,.72);

  font-size: 7px;
  letter-spacing: .22em;
}

.ru-enter-detected span {
  width: 4px;
  height: 4px;

  border-radius: 50%;

  background: var(--enter-gold);

  box-shadow:
    0 0 12px var(--enter-gold);
}

/* =========================================================
   SCANNER
   ========================================================= */

.ru-enter-scanner {
  position: absolute;

  width: 180px;
  height: 180px;

  left: 15%;
  top: 36%;

  opacity: .55;

  transition:
    opacity .5s ease,
    transform .5s ease;
}

.ru-enter-scanner.scanner-active {
  opacity: 1;
  transform: scale(1.08);
}

.scanner-corner {
  position: absolute;

  width: 25px;
  height: 25px;

  border-color: rgba(216,181,104,.65);
  border-style: solid;
}

.corner-tl {
  top: 0;
  left: 0;
  border-width: 1px 0 0 1px;
}

.corner-tr {
  top: 0;
  right: 0;
  border-width: 1px 1px 0 0;
}

.corner-bl {
  bottom: 0;
  left: 0;
  border-width: 0 0 1px 1px;
}

.corner-br {
  right: 0;
  bottom: 0;
  border-width: 0 1px 1px 0;
}

.scanner-crosshair {
  position: absolute;

  left: 50%;
  top: 50%;

  width: 45px;
  height: 45px;

  transform: translate(-50%, -50%);

  border:
    1px solid rgba(216,181,104,.38);

  border-radius: 50%;
}

.scanner-crosshair::before,
.scanner-crosshair::after {
  content: "";

  position: absolute;

  background: rgba(216,181,104,.45);
}

.scanner-crosshair::before {
  left: 50%;
  top: -13px;
  bottom: -13px;
  width: 1px;
}

.scanner-crosshair::after {
  top: 50%;
  left: -13px;
  right: -13px;
  height: 1px;
}

.scanner-crosshair span {
  position: absolute;

  width: 3px;
  height: 3px;

  border-radius: 50%;

  background: var(--enter-gold);
}

.scanner-crosshair span:first-child {
  left: 50%;
  top: -4px;
}

.scanner-crosshair span:last-child {
  right: -4px;
  top: 50%;
}

.scanner-scan-line {
  position: absolute;

  left: 15px;
  right: 15px;

  height: 1px;

  top: 15px;

  background:
    linear-gradient(
      90deg,
      transparent,
      var(--enter-gold),
      transparent
    );

  box-shadow:
    0 0 10px rgba(216,181,104,.5);

  animation:
    ruEnterScanner 3s ease-in-out infinite;
}

@keyframes ruEnterScanner {
  0%,100% {
    transform: translateY(0);
    opacity: .25;
  }

  50% {
    transform: translateY(145px);
    opacity: 1;
  }
}

.scanner-label {
  position: absolute;

  left: 0;
  bottom: -32px;

  display: flex;
  gap: 9px;

  font-size: 6px;
  letter-spacing: .25em;
}

.scanner-label span {
  color: rgba(245,237,219,.3);
}

.scanner-label strong {
  color: var(--enter-gold);
  font-weight: 500;
}

/* =========================================================
   BOTTOM DATA
   ========================================================= */

.ru-enter-bottom {
  position: absolute;

  left: 50%;
  bottom: 20px;

  transform: translateX(-50%);

  display: flex;
  align-items: center;

  gap: 60px;
}

.ru-enter-bottom > div {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.ru-enter-bottom small {
  color: rgba(245,237,219,.28);

  font-size: 6px;
  letter-spacing: .3em;
}

.ru-enter-bottom strong {
  color: rgba(245,237,219,.7);

  font-size: 8px;
  letter-spacing: .18em;
  font-weight: 500;
}

.ru-enter-bottom .online {
  color: var(--enter-gold);
}

/* =========================================================
   FOOTER
   ========================================================= */

.ru-enter-footer {
  position: relative;
  z-index: 10;

  height: 50px;

  display: flex;
  justify-content: space-between;
  align-items: center;

  padding: 0 4.5vw;

  border-top:
    1px solid rgba(216,181,104,.09);

  color: rgba(245,237,219,.3);

  font-size: 7px;
  letter-spacing: .25em;
}

.ru-enter-footer a {
  color: rgba(216,181,104,.65);
  text-decoration: none;

  transition:
    color .3s ease;
}

.ru-enter-footer a:hover {
  color: var(--enter-cream);
}

/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 1000px) {

  .ru-enter-character {
    right: -8%;
    width: 360px;
    opacity: .42;
  }

  .ru-enter-scanner {
    left: 7%;
  }

  .ru-enter-copy {
    margin-right: 8%;
  }
}

@media (max-width: 700px) {

  .ru-enter-header {
    height: 74px;
    padding: 0 20px;
  }

  .ru-enter-logo {
    width: 60px;
  }

  .ru-enter-status {
    display: none;
  }

  .ru-enter-archive {
    font-size: 7px;
  }

  .ru-enter-side {
    display: none;
  }

  .ru-enter-main {
    min-height: calc(100svh - 124px);
    padding: 45px 20px 90px;
  }

  .ru-enter-eyebrow {
    font-size: 7px;
  }

  .ru-enter-copy {
    width: 100%;
    margin: 0;
  }

  .ru-enter-copy h1 {
    font-size: clamp(78px, 22vw, 125px);
  }

  .ru-enter-copy p {
    width: min(390px, 90%);
    margin-top: 35px;
    font-size: 13px;
  }

  .ru-enter-character {
    width: 280px;
    right: 50%;
    bottom: -5%;
    transform: translateX(50%);
    opacity: .16;
  }

  .ru-enter-character-tag {
    display: none;
  }

  .ru-enter-scanner {
    width: 125px;
    height: 125px;
    left: 20px;
    top: 27%;
    opacity: .35;
  }

  .ru-enter-bottom {
    gap: 25px;
    bottom: 18px;
  }

  .ru-enter-footer {
    padding: 0 20px;
  }

  .ru-enter-footer span {
    display: none;
  }

}

@media (prefers-reduced-motion: reduce) {

  .ru-enter-world-image,
  .ru-enter-mist,
  .ru-enter-star,
  .ru-enter-status-dot,
  .ru-enter-character img,
  .ru-enter-character-ring,
  .ru-enter-button-icon,
  .ru-enter-button-orbit,
  .scanner-scan-line {
    animation: none;
  }

}


/* =========================================================
   REALITY UNKNOWN — PREMIUM GAME EXPERIENCE
   ========================================================= */



:root {
  --ru-ink: #030710;
  --ru-panel: rgba(5, 12, 24, 0.78);
  --ru-panel-strong: rgba(3, 9, 19, 0.92);
  --ru-cream: #f4ead4;
  --ru-muted: #aeb6c5;
  --ru-gold: #d5ae55;
  --ru-gold-bright: #f0ca6a;
  --ru-line: rgba(213, 174, 85, 0.28);
  --ru-blue: #5b8cff;
}

.ru-game {
  min-height: 100svh;
  position: relative;
  overflow: hidden;
  background: #02060e;
  color: var(--ru-cream);
  font-family: "Manrope", sans-serif;
  isolation: isolate;
}

.ru-game-background {
  position: fixed;
  inset: 0;
  z-index: -5;
  background:
    radial-gradient(circle at 50% 30%, rgba(29, 58, 120, .30), transparent 38%),
    radial-gradient(circle at 15% 80%, rgba(17, 65, 86, .20), transparent 35%),
    linear-gradient(180deg, #030916 0%, #02050b 100%);
}

.ru-game-background::after {
  content: "";
  position: absolute;
  inset: 0;
  background:
    linear-gradient(rgba(255,255,255,.025) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.025) 1px, transparent 1px);
  background-size: 90px 90px;
  mask-image: linear-gradient(to bottom, black, transparent 90%);
}

.ru-game-noise {
  position: fixed;
  inset: 0;
  z-index: 10;
  pointer-events: none;
  opacity: .035;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.6'/%3E%3C/svg%3E");
}

.ru-game-header {
  position: fixed;
  z-index: 20;
  top: 0;
  left: 0;
  right: 0;
  height: 88px;
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  padding: 0 42px;
  border-bottom: 1px solid rgba(255,255,255,.08);
  background: linear-gradient(
    180deg,
    rgba(2,7,17,.96),
    rgba(2,7,17,.62),
    transparent
  );
  backdrop-filter: blur(12px);
}

.ru-game-brand {
  display: flex;
  align-items: center;
}

.ru-game-brand img {
  width: 76px;
  height: auto;
  object-fit: contain;
  filter: drop-shadow(0 0 18px rgba(91,140,255,.20));
}

.ru-game-chapter {
  display: flex;
  gap: 10px;
  align-items: baseline;
  font-size: 9px;
  letter-spacing: .28em;
  color: #858fa1;
}

.ru-game-chapter strong {
  color: var(--ru-gold-bright);
  font-size: 13px;
  font-weight: 700;
}

.ru-game-xp {
  justify-self: end;
  text-align: right;
}

.ru-game-xp span,
.ru-game-xp strong {
  display: block;
}

.ru-game-xp span {
  font-size: 8px;
  letter-spacing: .28em;
  color: #7f8898;
}

.ru-game-xp strong {
  margin-top: 5px;
  font-size: 12px;
  letter-spacing: .12em;
  color: var(--ru-gold-bright);
}

.ru-game-content {
  min-height: 100svh;
  padding: 118px 42px 90px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ru-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  color: var(--ru-gold-bright);
  font-family: "Manrope", sans-serif;
  font-size: 9px;
  line-height: 1;
  letter-spacing: .36em;
  font-weight: 700;
  text-transform: uppercase;
}

.ru-eyebrow::before,
.ru-eyebrow::after {
  content: "";
  width: 30px;
  height: 1px;
  background: var(--ru-gold);
  opacity: .65;
}

.ru-world-screen,
.ru-target-screen {
  width: min(1280px, 100%);
  display: grid;
  grid-template-columns: .72fr 1.28fr;
  gap: 50px;
  align-items: center;
}

.ru-game-intro {
  max-width: 540px;
  padding-left: 10px;
}

.ru-game-intro h1,
.ru-analysis-screen h1,
.ru-story-content h1,
.ru-mission-panel h1,
.ru-target-header h1,
.ru-result-screen h1 {
  margin: 24px 0 22px;
  font-family: "Cormorant Garamond", Georgia, serif;
  font-size: clamp(58px, 6vw, 98px);
  line-height: .83;
  letter-spacing: -.045em;
  font-weight: 600;
  color: var(--ru-cream);
}

.ru-game-intro h1 em,
.ru-analysis-screen h1 em,
.ru-story-content h1 em,
.ru-target-header h1 em,
.ru-result-screen h1 em {
  display: block;
  color: #7d8798;
  font-weight: 500;
}

.ru-game-intro p,
.ru-analysis-screen p,
.ru-story-content p,
.ru-result-screen p {
  max-width: 530px;
  color: #adb5c3;
  font-size: 15px;
  line-height: 1.9;
}

.ru-camera {
  width: 100%;
}

.ru-camera-frame {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 10;
  overflow: hidden;
  border: 1px solid rgba(213,174,85,.35);
  background: #01040a;
  box-shadow:
    0 30px 90px rgba(0,0,0,.55),
    inset 0 0 80px rgba(25,63,130,.12);
}

.ru-camera-video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  background: #02060d;
}

.ru-camera-vignette {
  position: absolute;
  inset: 0;
  pointer-events: none;
  background:
    radial-gradient(circle at center, transparent 35%, rgba(0,0,0,.42) 100%),
    linear-gradient(180deg, rgba(0,0,0,.25), transparent 35%, rgba(0,0,0,.55));
}

.ru-camera-grid {
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: .22;
  background:
    linear-gradient(rgba(255,255,255,.12) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.12) 1px, transparent 1px);
  background-size: 70px 70px;
}

.ru-camera-corners {
  position: absolute;
  inset: 28px;
  pointer-events: none;
}

.ru-camera-corners span {
  position: absolute;
  width: 42px;
  height: 42px;
  border-color: var(--ru-gold-bright);
  border-style: solid;
  opacity: .8;
}

.ru-camera-corners span:nth-child(1) {
  left: 0;
  top: 0;
  border-width: 1px 0 0 1px;
}

.ru-camera-corners span:nth-child(2) {
  right: 0;
  top: 0;
  border-width: 1px 1px 0 0;
}

.ru-camera-corners span:nth-child(3) {
  left: 0;
  bottom: 0;
  border-width: 0 0 1px 1px;
}

.ru-camera-corners span:nth-child(4) {
  right: 0;
  bottom: 0;
  border-width: 0 1px 1px 0;
}

.ru-camera-reticle {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 130px;
  height: 130px;
  transform: translate(-50%, -50%);
  display: grid;
  place-items: center;
  pointer-events: none;
}

.ru-camera-reticle-ring {
  position: absolute;
  inset: 0;
  border: 1px solid rgba(240,202,106,.72);
  border-radius: 50%;
  box-shadow:
    0 0 0 12px rgba(213,174,85,.04),
    0 0 50px rgba(213,174,85,.12);
  animation: ru-reticle-pulse 2.6s ease-in-out infinite;
}

.ru-camera-reticle-cross::before,
.ru-camera-reticle-cross::after {
  content: "";
  position: absolute;
  background: rgba(240,202,106,.75);
}

.ru-camera-reticle-cross::before {
  width: 1px;
  height: 160px;
}

.ru-camera-reticle-cross::after {
  width: 160px;
  height: 1px;
}

.ru-camera-reticle-core {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--ru-gold-bright);
  box-shadow: 0 0 18px var(--ru-gold-bright);
}

.ru-camera-scanline {
  position: absolute;
  left: 10%;
  right: 10%;
  height: 1px;
  top: 18%;
  background: linear-gradient(
    90deg,
    transparent,
    var(--ru-gold-bright),
    transparent
  );
  box-shadow: 0 0 18px rgba(240,202,106,.7);
  animation: ru-scan 3.5s ease-in-out infinite;
}

.ru-camera-topline {
  position: absolute;
  left: 28px;
  top: 24px;
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 8px;
  letter-spacing: .22em;
  color: #aab1bf;
}

.ru-camera-topline strong {
  color: var(--ru-gold-bright);
}

.ru-camera-live-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #78e6b0;
  box-shadow: 0 0 14px #78e6b0;
  animation: ru-live 1.5s infinite;
}

.ru-camera-bottom {
  position: absolute;
  left: 24px;
  right: 24px;
  bottom: 22px;
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 20px;
}

.ru-camera-bottom small,
.ru-camera-bottom strong {
  display: block;
}

.ru-camera-bottom small {
  margin-bottom: 7px;
  color: var(--ru-gold-bright);
  font-size: 8px;
  letter-spacing: .25em;
}

.ru-camera-bottom strong {
  font-size: 13px;
  color: white;
  letter-spacing: .01em;
}

.ru-camera-capture {
  flex: 0 0 auto;
  height: 52px;
  padding: 0 23px;
  border: 1px solid rgba(240,202,106,.65);
  background: rgba(4,10,20,.72);
  color: var(--ru-cream);
  display: flex;
  align-items: center;
  gap: 12px;
  cursor: pointer;
  font: 700 9px "Manrope", sans-serif;
  letter-spacing: .2em;
  transition: .3s ease;
}

.ru-camera-capture:hover:not(:disabled) {
  background: var(--ru-gold);
  color: #07101d;
  box-shadow: 0 0 35px rgba(213,174,85,.25);
}

.ru-camera-capture:disabled {
  opacity: .4;
  cursor: not-allowed;
}

.ru-camera-capture-inner {
  width: 12px;
  height: 12px;
  border: 1px solid currentColor;
  border-radius: 50%;
  box-shadow: inset 0 0 0 3px rgba(255,255,255,.08);
}

.ru-camera-loading,
.ru-camera-error {
  position: absolute;
  inset: 0;
  display: grid;
  place-items: center;
  align-content: center;
  text-align: center;
  background: rgba(2,6,14,.84);
  backdrop-filter: blur(12px);
}

.ru-camera-loading {
  gap: 18px;
  color: #c5ccd8;
  font-size: 12px;
  letter-spacing: .1em;
}

.ru-camera-spinner {
  width: 48px;
  height: 48px;
  border: 1px solid rgba(213,174,85,.22);
  border-top-color: var(--ru-gold-bright);
  border-radius: 50%;
  animation: ru-spin 1s linear infinite;
}

.ru-camera-error {
  padding: 30px;
}

.ru-camera-error-icon {
  width: 45px;
  height: 45px;
  display: grid;
  place-items: center;
  margin-bottom: 16px;
  border: 1px solid rgba(220,100,100,.5);
  border-radius: 50%;
  color: #ff9b9b;
}

.ru-camera-error strong {
  font-size: 12px;
  letter-spacing: .18em;
}

.ru-camera-error p {
  max-width: 430px;
  margin: 10px 0 20px;
  color: #9ea7b6;
  font-size: 12px;
  line-height: 1.7;
}

.ru-camera-retry {
  padding: 12px 18px;
  border: 1px solid var(--ru-line);
  background: transparent;
  color: var(--ru-gold-bright);
  cursor: pointer;
  font: 700 9px "Manrope";
  letter-spacing: .16em;
}

.ru-analysis-screen,
.ru-result-screen {
  width: min(850px, 100%);
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.ru-analysis-screen h1,
.ru-result-screen h1 {
  font-size: clamp(70px, 8vw, 120px);
}

.ru-analysis-orbit {
  position: absolute;
  width: 340px;
  height: 340px;
  left: 50%;
  top: 48%;
  transform: translate(-50%, -50%);
  opacity: .55;
  pointer-events: none;
}

.ru-analysis-orbit div {
  position: absolute;
  inset: 0;
  border: 1px solid rgba(91,140,255,.16);
  border-radius: 50%;
}

.ru-analysis-orbit div:nth-child(1) {
  transform: rotateX(70deg);
  animation: ru-orbit 5s linear infinite;
}

.ru-analysis-orbit div:nth-child(2) {
  transform: rotateY(70deg);
  animation: ru-orbit 7s linear infinite reverse;
}

.ru-analysis-orbit div:nth-child(3) {
  inset: 70px;
  border-color: rgba(213,174,85,.2);
  animation: ru-spin 4s linear infinite;
}

.ru-analysis-status {
  width: min(400px, 100%);
  height: 3px;
  margin: 25px 0;
  display: flex;
  gap: 4px;
}

.ru-analysis-status span {
  flex: 1;
  background: rgba(213,174,85,.15);
  animation: ru-progress 1.4s ease-in-out infinite;
}

.ru-analysis-status span:nth-child(2) { animation-delay: .15s; }
.ru-analysis-status span:nth-child(3) { animation-delay: .3s; }
.ru-analysis-status span:nth-child(4) { animation-delay: .45s; }
.ru-analysis-status span:nth-child(5) { animation-delay: .6s; }

.ru-story-screen,
.ru-mission-screen {
  width: min(1250px, 100%);
  min-height: 600px;
  position: relative;
  display: grid;
  grid-template-columns: .8fr 1.2fr;
  align-items: center;
  gap: 40px;
}

.ru-story-character,
.ru-mission-character {
  position: relative;
  align-self: stretch;
  min-height: 550px;
}

.ru-character-image {
  object-fit: contain;
  object-position: center bottom;
  filter:
    drop-shadow(0 30px 35px rgba(0,0,0,.7))
    drop-shadow(0 0 45px rgba(48,83,145,.14));
  animation: ru-character-enter 1.1s cubic-bezier(.2,.8,.2,1);
}

.ru-story-content,
.ru-mission-panel {
  position: relative;
  z-index: 2;
  max-width: 650px;
}

.ru-story-content h1,
.ru-mission-panel h1 {
  font-size: clamp(62px, 6.5vw, 102px);
}

.ru-dialogue {
  position: relative;
  margin: 35px 0;
  padding: 22px 28px 22px 48px;
  border-left: 1px solid var(--ru-gold);
  background: linear-gradient(
    90deg,
    rgba(213,174,85,.07),
    transparent
  );
}

.ru-dialogue-mark {
  position: absolute;
  left: 16px;
  top: 11px;
  color: var(--ru-gold);
  font: 500 40px "Cormorant Garamond";
}

.ru-dialogue p {
  margin: 0;
  color: var(--ru-cream);
  font: italic 500 23px/1.5 "Cormorant Garamond", serif;
}

.ru-primary-button {
  height: 56px;
  min-width: 210px;
  padding: 0 25px;
  display: inline-flex;
  align-items: center;
  justify-content: space-between;
  gap: 28px;
  border: 1px solid rgba(213,174,85,.65);
  background: rgba(4,10,20,.6);
  color: var(--ru-cream);
  cursor: pointer;
  font: 700 9px "Manrope", sans-serif;
  letter-spacing: .22em;
  transition: .35s ease;
}

.ru-primary-button b {
  font-size: 18px;
  color: var(--ru-gold-bright);
  transition: transform .3s ease;
}

.ru-primary-button:hover {
  background: var(--ru-gold);
  color: #06101d;
  box-shadow: 0 12px 45px rgba(213,174,85,.22);
  transform: translateY(-2px);
}

.ru-primary-button:hover b {
  transform: translateX(5px);
}

.ru-objective,
.ru-clue {
  margin-top: 24px;
  padding: 21px 24px;
  border: 1px solid rgba(255,255,255,.08);
  background: rgba(3,9,19,.66);
  backdrop-filter: blur(15px);
}

.ru-objective small,
.ru-clue small {
  display: block;
  margin-bottom: 10px;
  color: var(--ru-gold-bright);
  font-size: 8px;
  font-weight: 700;
  letter-spacing: .25em;
}

.ru-objective strong {
  display: block;
  color: white;
  font-size: 17px;
  line-height: 1.6;
}

.ru-clue p {
  margin: 0;
  color: #aeb7c6;
  font: italic 18px/1.5 "Cormorant Garamond", serif;
}

.ru-target-screen {
  grid-template-columns: 1fr;
  max-width: 1050px;
}

.ru-target-header {
  text-align: center;
}

.ru-target-header h1 {
  font-size: clamp(58px, 6vw, 90px);
}

.ru-target-screen .ru-camera {
  max-width: 900px;
  margin: 10px auto 0;
}

.ru-result-symbol {
  width: 90px;
  height: 90px;
  margin-bottom: 28px;
  display: grid;
  place-items: center;
  border: 1px solid var(--ru-gold);
  border-radius: 50%;
  color: var(--ru-gold-bright);
  font-size: 30px;
  box-shadow:
    0 0 60px rgba(213,174,85,.16),
    inset 0 0 30px rgba(213,174,85,.05);
  animation: ru-success-symbol 1s ease both;
}

.ru-reward {
  margin: 32px 0;
}

.ru-reward small {
  display: block;
  margin-bottom: 7px;
  color: #778195;
  font-size: 8px;
  letter-spacing: .3em;
}

.ru-reward strong {
  font: 600 38px "Cormorant Garamond", serif;
  color: var(--ru-gold-bright);
}

.ru-game-error {
  grid-column: 1 / -1;
  margin-top: -10px;
  padding: 12px 18px;
  border: 1px solid rgba(230,100,100,.25);
  background: rgba(100,20,20,.12);
  display: flex;
  gap: 15px;
  justify-content: center;
  color: #ffb1b1;
  font-size: 11px;
}

.ru-game-error strong {
  letter-spacing: .12em;
}

.ru-game-footer {
  position: fixed;
  z-index: 20;
  bottom: 0;
  left: 0;
  right: 0;
  height: 52px;
  padding: 0 38px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1px solid rgba(255,255,255,.07);
  background: linear-gradient(
    0deg,
    rgba(2,7,17,.95),
    transparent
  );
  color: #596274;
  font-size: 7px;
  letter-spacing: .25em;
}

@keyframes ru-reticle-pulse {
  0%,100% { transform: scale(.92); opacity: .55; }
  50% { transform: scale(1.06); opacity: 1; }
}

@keyframes ru-scan {
  0% { top: 15%; opacity: 0; }
  15% { opacity: 1; }
  85% { opacity: 1; }
  100% { top: 84%; opacity: 0; }
}

@keyframes ru-live {
  0%,100% { opacity: .4; }
  50% { opacity: 1; }
}

@keyframes ru-spin {
  to { transform: rotate(360deg); }
}

@keyframes ru-orbit {
  to { transform: rotate(360deg) rotateX(70deg); }
}

@keyframes ru-progress {
  0%,100% { opacity: .2; transform: scaleX(.65); }
  50% { opacity: 1; transform: scaleX(1); background: var(--ru-gold); }
}

@keyframes ru-character-enter {
  from {
    opacity: 0;
    transform: translateY(35px) scale(.97);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes ru-success-symbol {
  from {
    opacity: 0;
    transform: scale(.6) rotate(-30deg);
  }
  to {
    opacity: 1;
    transform: scale(1) rotate(0);
  }
}

