/* CAMERA */

.ru-new-camera {
  position: relative;

  flex: 1;

  min-height: 560px;

  overflow: hidden;

  border:
    1px solid
    rgba(219,184,87,.35);

  background: #020710;

  box-shadow:
    0 35px 90px rgba(0,0,0,.45);
}

.ru-new-camera-video {
  position: absolute;
  inset: 0;

  width: 100%;
  height: 100%;

  object-fit: cover;

  filter:
    brightness(.82)
    contrast(1.04)
    saturate(.9);
}

.ru-new-camera-vignette {
  position: absolute;
  inset: 0;

  pointer-events: none;

  background:
    radial-gradient(
      circle,
      transparent 35%,
      rgba(0,0,0,.48) 100%
    );

  z-index: 2;
}

.ru-new-camera-grid {
  position: absolute;
  inset: 0;

  z-index: 3;

  pointer-events: none;

  opacity: .18;

  background:
    linear-gradient(
      rgba(218,184,87,.08) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(218,184,87,.08) 1px,
      transparent 1px
    );

  background-size: 90px 90px;
}

.ru-new-camera-reticle {
  position: absolute;

  left: 20%;
  right: 20%;
  top: 12%;
  bottom: 20%;

  z-index: 5;

  pointer-events: none;

  border:
    1px solid
    rgba(225,192,99,.16);
}

.ru-new-camera-reticle span {
  position: absolute;

  width: 35px;
  height: 35px;

  border-color: rgba(230,196,103,.85);
}

.ru-new-camera-reticle span:nth-child(1) {
  left: -1px;
  top: -1px;
  border-left: 2px solid;
  border-top: 2px solid;
}

.ru-new-camera-reticle span:nth-child(2) {
  right: -1px;
  top: -1px;
  border-right: 2px solid;
  border-top: 2px solid;
}

.ru-new-camera-reticle span:nth-child(3) {
  left: -1px;
  bottom: -1px;
  border-left: 2px solid;
  border-bottom: 2px solid;
}

.ru-new-camera-reticle span:nth-child(4) {
  right: -1px;
  bottom: -1px;
  border-right: 2px solid;
  border-bottom: 2px solid;
}

.ru-new-camera-top,
