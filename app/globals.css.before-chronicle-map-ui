@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Manrope:wght@400;500;600;700;800&display=swap');

:root {
  --ru-void: #071016;
  --ru-night: #0B1720;
  --ru-night-soft: #12222C;

  --ru-sky: #55B5EC;
  --ru-sky-soft: #9DD8F5;

  --ru-gold: #D6B66A;
  --ru-gold-soft: #EAD8A4;

  --ru-parchment: #F4ECD9;
  --ru-mist: #DCEBF0;
  --ru-white: #FFFFFF;

  --ru-panel: rgba(7, 16, 22, 0.46);
  --ru-panel-strong: rgba(7, 16, 22, 0.72);

  --ru-line: rgba(244, 236, 217, 0.2);

  --ru-radius-panel: 24px;
  --ru-radius-control: 999px;

  --ru-shadow-cinematic:
    0 28px 80px rgba(0, 0, 0, 0.3),
    0 2px 14px rgba(0, 0, 0, 0.12);
}

* {
  box-sizing: border-box;
}

html {
  background: var(--ru-void);
  color-scheme: dark;
}

body {
  margin: 0;
  min-width: 320px;

  background: var(--ru-void);
  color: var(--ru-parchment);

  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

button,
input,
textarea,
select {
  font: inherit;
}

button {
  color: inherit;
}

::selection {
  background: rgba(214, 182, 106, 0.28);
  color: var(--ru-white);
}

/* =========================================
   WORLD
========================================= */

.ru-shell {
  position: relative;
  min-height: 100svh;
  isolation: isolate;
  overflow: hidden;
  background: var(--ru-void);
}

.ru-shell-content {
  position: relative;
  z-index: 10;
  min-height: 100svh;
}

.ru-world-background {
  position: absolute;
  inset: 0;
  z-index: 0;
  overflow: hidden;
  background: var(--ru-void);
}

.ru-world-image {
  object-fit: cover;
  object-position: center;

  transform: scale(1.035);

  filter:
    saturate(0.92)
    contrast(0.96);

  animation:
    ru-world-drift 18s
    ease-in-out
    infinite
    alternate;
}

.ru-world-sky,
.ru-world-vignette,
.ru-world-grain,
.ru-world-bloom {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.ru-world-sky {
  background:
    linear-gradient(
      180deg,
      rgba(3, 11, 16, 0.15) 0%,
      rgba(3, 11, 16, 0.02) 35%,
      rgba(3, 11, 16, 0.16) 72%,
      rgba(3, 11, 16, 0.62) 100%
    );
}

.ru-world-vignette {
  background:
    radial-gradient(
      ellipse at center,
      transparent 36%,
      rgba(2, 8, 12, 0.12) 68%,
      rgba(2, 8, 12, 0.58) 100%
    );
}

.ru-world-grain {
  opacity: 0.08;

  background-image:
    url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.32'/%3E%3C/svg%3E");

  mix-blend-mode: soft-light;
}

.ru-world-bloom {
  background:
    radial-gradient(
      circle at 66% 24%,
      rgba(255, 235, 168, 0.15),
      transparent 24%
    ),
    radial-gradient(
      circle at 28% 58%,
      rgba(105, 205, 255, 0.08),
      transparent 28%
    );

  mix-blend-mode: screen;
}

@keyframes ru-world-drift {
  from {
    transform:
      scale(1.035)
      translate3d(0, 0, 0);
  }

  to {
    transform:
      scale(1.065)
      translate3d(-0.7%, -0.35%, 0);
  }
}

/* =========================================
   ATMOSPHERE
========================================= */

.ru-atmosphere {
  position: absolute;
  inset: 0;
  z-index: 5;
  overflow: hidden;
  pointer-events: none;
}

.ru-orb {
  position: absolute;

  border-radius: 50%;

  filter: blur(60px);

  opacity: 0.22;

  animation:
    ru-orb-float 9s
    ease-in-out
    infinite
    alternate;
}

.ru-orb-one {
  width: 280px;
  height: 280px;

  right: 12%;
  top: 12%;

  background: rgba(157, 216, 245, 0.25);
}

.ru-orb-two {
  width: 220px;
  height: 220px;

  left: 10%;
  bottom: 12%;

  background: rgba(214, 182, 106, 0.15);

  animation-delay: -3s;
}

.ru-particle {
  position: absolute;

  width: 3px;
  height: 3px;

  border-radius: 50%;

  background:
    rgba(244, 236, 217, 0.65);

  box-shadow:
    0 0 16px rgba(244, 236, 217, 0.8);

  animation:
    ru-particle-drift 8s
    linear
    infinite;
}

.ru-particle-one {
  left: 18%;
  bottom: 22%;
  animation-delay: -1s;
}

.ru-particle-two {
  left: 62%;
  bottom: 34%;
  animation-delay: -4s;
}

.ru-particle-three {
  right: 21%;
  bottom: 18%;
  animation-delay: -6s;
}

@keyframes ru-orb-float {
  from {
    transform:
      translate3d(0, 0, 0);
  }

  to {
    transform:
      translate3d(14px, -18px, 0);
  }
}

@keyframes ru-particle-drift {
  0% {
    transform:
      translate3d(0, 16px, 0);

    opacity: 0;
  }

  20% {
    opacity: 0.7;
  }

  80% {
    opacity: 0.3;
  }

  100% {
    transform:
      translate3d(18px, -90px, 0);

    opacity: 0;
  }
}

/* =========================================
   GLASS
========================================= */

.ru-glass-panel {
  border:
    1px solid var(--ru-line);

  border-radius:
    var(--ru-radius-panel);

  background:
    linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.11),
      rgba(255, 255, 255, 0.035)
    );

  box-shadow:
    var(--ru-shadow-cinematic);

  backdrop-filter:
    blur(22px)
    saturate(125%);

  -webkit-backdrop-filter:
    blur(22px)
    saturate(125%);
}

/* =========================================
   BUTTON
========================================= */

.ru-button {
  position: relative;

  display: inline-flex;

  min-height: 52px;

  align-items: center;
  justify-content: center;

  gap: 14px;

  overflow: hidden;

  border:
    1px solid
    rgba(234, 216, 164, 0.62);

  border-radius:
    var(--ru-radius-control);

  padding:
    0 22px 0 24px;

  cursor: pointer;

  background:
    rgba(7, 16, 22, 0.52);

  color:
    var(--ru-parchment);

  font-size: 12px;
  font-weight: 750;

  letter-spacing: 0.12em;

  text-transform: uppercase;

  box-shadow:
    0 12px 40px rgba(0, 0, 0, 0.18),
    inset 0 0 0 1px rgba(255, 255, 255, 0.04);

  backdrop-filter:
    blur(16px);

  transition:
    transform 180ms ease,
    border-color 180ms ease,
    background 180ms ease,
    box-shadow 180ms ease;
}

.ru-button:hover {
  transform: translateY(-2px);

  border-color:
    rgba(255, 241, 188, 0.9);

  box-shadow:
    0 18px 52px rgba(0, 0, 0, 0.24),
    0 0 32px rgba(214, 182, 106, 0.12);
}

.ru-button:active {
  transform: translateY(0);
}

.ru-button-primary {
  background:
    rgba(7, 16, 22, 0.64);
}

.ru-button-ghost {
  border-color:
    rgba(244, 236, 217, 0.28);
}

.ru-button-shine {
  position: absolute;

  inset:
    0 auto 0 -40%;

  width: 25%;

  transform:
    skewX(-18deg);

  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.2),
      transparent
    );

  transition:
    left 600ms ease;
}

.ru-button:hover .ru-button-shine {
  left: 120%;
}

.ru-button-label,
.ru-button-arrow {
  position: relative;
  z-index: 1;
}

.ru-button-arrow {
  color:
    var(--ru-gold-soft);

  font-size: 17px;
  line-height: 1;
}

/* =========================================
   XP
========================================= */

.ru-xp {
  width: min(260px, 100%);
}

.ru-xp-topline {
  display: flex;

  align-items: center;
  justify-content: space-between;

  margin-bottom: 7px;

  color:
    rgba(244, 236, 217, 0.78);

  font-size: 10px;
  font-weight: 700;

  letter-spacing: 0.12em;

  text-transform: uppercase;
}

.ru-xp-track {
  height: 4px;

  overflow: hidden;

  border-radius: 99px;

  background:
    rgba(244, 236, 217, 0.16);
}

.ru-xp-fill {
  height: 100%;

  border-radius: inherit;

  background:
    linear-gradient(
      90deg,
      var(--ru-gold),
      var(--ru-gold-soft)
    );

  box-shadow:
    0 0 14px
    rgba(214, 182, 106, 0.5);

  transition:
    width 500ms
    cubic-bezier(.22, 1, .36, 1);
}

/* =========================================
   RESPONSIVE
========================================= */

@media (max-width: 700px) {
  .ru-world-image {
    object-position: 58% center;
  }

  .ru-button {
    min-height: 50px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .ru-world-image,
  .ru-orb,
  .ru-particle {
    animation: none;
  }

  .ru-button,
  .ru-button-shine,
  .ru-xp-fill {
    transition: none;
  }
}

/* =========================================
   LANDING PAGE
========================================= */

.ru-landing-header {
  position: absolute;
  z-index: 30;

  top: 0;
  left: 0;
  right: 0;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 28px 42px;
}

.ru-brand {
  display: inline-flex;
  align-items: center;

  text-decoration: none;

  filter:
    drop-shadow(0 8px 22px rgba(0, 0, 0, 0.32));
}

.ru-brand-logo {
  width: auto;
  height: 42px;

  object-fit: contain;
}

.ru-landing-nav {
  display: flex;
  align-items: center;
  gap: 34px;
}

.ru-landing-nav a {
  position: relative;

  color: rgba(244, 236, 217, 0.76);

  font-size: 10px;
  font-weight: 700;

  letter-spacing: 0.16em;
  text-transform: uppercase;

  text-decoration: none;

  transition:
    color 180ms ease;
}

.ru-landing-nav a::after {
  content: "";

  position: absolute;

  left: 0;
  right: 0;
  bottom: -7px;

  height: 1px;

  transform: scaleX(0);
  transform-origin: center;

  background: var(--ru-gold-soft);

  transition:
    transform 220ms ease;
}

.ru-landing-nav a:hover {
  color: var(--ru-white);
}

.ru-landing-nav a:hover::after {
  transform: scaleX(1);
}

.ru-menu-button {
  display: none;

  width: 46px;
  height: 46px;

  align-items: center;
  justify-content: center;
  flex-direction: column;

  gap: 6px;

  border:
    1px solid rgba(244, 236, 217, 0.24);

  border-radius: 50%;

  background:
    rgba(7, 16, 22, 0.38);

  backdrop-filter: blur(14px);

  cursor: pointer;
}

.ru-menu-button span {
  display: block;

  width: 17px;
  height: 1px;

  background:
    rgba(244, 236, 217, 0.82);
}


/* =========================================
   HERO
========================================= */

.ru-landing-hero {
  position: relative;

  min-height: 100svh;

  display: grid;
  place-items: center;

  overflow: hidden;

  padding:
    130px 24px
    100px;
}

.ru-hero-light {
  position: absolute;

  width: min(800px, 80vw);
  height: min(600px, 70vh);

  left: 50%;
  top: 48%;

  transform:
    translate(-50%, -50%);

  background:
    radial-gradient(
      ellipse,
      rgba(116, 186, 224, 0.13),
      transparent 67%
    );

  filter: blur(10px);

  pointer-events: none;
}

.ru-hero-content {
  position: relative;
  z-index: 5;

  width: min(950px, 100%);

  text-align: center;

  animation:
    ru-hero-enter 1.1s
    cubic-bezier(.16, 1, .3, 1)
    both;
}

.ru-hero-eyebrow {
  display: flex;

  align-items: center;
  justify-content: center;

  gap: 13px;

  margin-bottom: 22px;

  color:
    var(--ru-gold-soft);

  font-size: 10px;
  font-weight: 700;

  letter-spacing: 0.34em;

  text-transform: uppercase;
}

.ru-eyebrow-line {
  width: 34px;
  height: 1px;

  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(234, 216, 164, 0.65)
    );
}

.ru-eyebrow-line:last-child {
  transform: rotate(180deg);
}

.ru-hero-title {
  margin: 0;

  color:
    var(--ru-white);

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size:
    clamp(62px, 8.3vw, 124px);

  font-weight: 500;

  line-height:
    0.88;

  letter-spacing:
    -0.065em;

  text-shadow:
    0 14px 50px rgba(0, 0, 0, 0.4);
}

.ru-hero-title em {
  color:
    rgba(255, 255, 255, 0.94);

  font-style: italic;

  font-weight: 400;
}

.ru-hero-description {
  width: min(530px, 100%);

  margin:
    30px auto
    34px;

  color:
    rgba(244, 236, 217, 0.72);

  font-size: 15px;

  line-height: 1.75;

  text-shadow:
    0 4px 18px rgba(0, 0, 0, 0.4);
}

.ru-scroll-cue {
  position: absolute;

  z-index: 10;

  bottom: 28px;
  left: 50%;

  transform:
    translateX(-50%);

  display: flex;

  align-items: center;
  gap: 11px;

  color:
    rgba(244, 236, 217, 0.48);

  font-size: 8px;
  font-weight: 700;

  letter-spacing: 0.25em;

  text-transform: uppercase;
}

.ru-scroll-line {
  width: 30px;
  height: 1px;

  background:
    rgba(244, 236, 217, 0.35);
}

@keyframes ru-hero-enter {
  from {
    opacity: 0;

    transform:
      translateY(28px)
      scale(0.985);

    filter:
      blur(5px);
  }

  to {
    opacity: 1;

    transform:
      translateY(0)
      scale(1);

    filter:
      blur(0);
  }
}


/* =========================================
   LANDING RESPONSIVE
========================================= */

@media (max-width: 760px) {
  .ru-landing-header {
    padding:
      20px 20px;
  }

  .ru-brand-logo {
    height: 35px;
  }

  .ru-landing-nav {
    display: none;
  }

  .ru-menu-button {
    display: flex;
  }

  .ru-landing-hero {
    padding:
      120px 20px
      90px;
  }

  .ru-hero-eyebrow {
    font-size: 8px;
    letter-spacing: 0.25em;
  }

  .ru-hero-title {
    font-size:
      clamp(55px, 15vw, 82px);

    line-height:
      0.91;
  }

  .ru-hero-description {
    font-size: 14px;

    margin-top: 26px;
  }

  .ru-scroll-cue {
    bottom: 20px;
  }
}

/* =========================================
   CINEMATIC LANDING EXPERIENCE
========================================= */

.ru-hero-content {
  position: relative;
  z-index: 10;

  display: flex;
  flex-direction: column;
  align-items: center;

  width: min(1000px, 100%);

  text-align: center;
}

.ru-center-logo {
  position: relative;

  display: flex;
  align-items: center;
  justify-content: center;

  width: 310px;
  height: 100px;

  margin-bottom: 18px;
}

.ru-hero-logo {
  position: relative;
  z-index: 2;

  width: 310px;
  height: auto;

  object-fit: contain;

  filter:
    drop-shadow(0 10px 28px rgba(0, 0, 0, 0.45))
    drop-shadow(0 0 25px rgba(214, 182, 106, 0.14));
}

.ru-logo-aura {
  position: absolute;

  width: 210px;
  height: 100px;

  border-radius: 50%;

  background:
    radial-gradient(
      ellipse,
      rgba(234, 216, 164, 0.17),
      transparent 70%
    );

  filter: blur(22px);

  animation:
    ru-logo-breathe 4s ease-in-out infinite;
}

@keyframes ru-logo-breathe {
  0%,
  100% {
    opacity: 0.45;
    transform: scale(0.9);
  }

  50% {
    opacity: 0.8;
    transform: scale(1.08);
  }
}

.ru-parallax-glow {
  position: absolute;

  width: 720px;
  height: 500px;

  left: 50%;
  top: 48%;

  transform: translate(-50%, -50%);

  border-radius: 50%;

  background:
    radial-gradient(
      ellipse,
      rgba(91, 175, 222, 0.13),
      transparent 67%
    );

  filter: blur(30px);

  pointer-events: none;
}

.ru-hero-orbit {
  position: absolute;

  border:
    1px solid rgba(234, 216, 164, 0.08);

  border-radius: 50%;

  pointer-events: none;
}

.ru-hero-orbit-one {
  width: 760px;
  height: 260px;

  left: 50%;
  top: 51%;

  transform:
    translate(-50%, -50%)
    rotate(-8deg);

  animation:
    ru-orbit-rotate 22s
    linear
    infinite;
}

.ru-hero-orbit-two {
  width: 950px;
  height: 340px;

  left: 50%;
  top: 51%;

  transform:
    translate(-50%, -50%)
    rotate(9deg);

  animation:
    ru-orbit-rotate-reverse 28s
    linear
    infinite;
}

@keyframes ru-orbit-rotate {
  from {
    transform:
      translate(-50%, -50%)
      rotate(-8deg);
  }

  to {
    transform:
      translate(-50%, -50%)
      rotate(352deg);
  }
}

@keyframes ru-orbit-rotate-reverse {
  from {
    transform:
      translate(-50%, -50%)
      rotate(9deg);
  }

  to {
    transform:
      translate(-50%, -50%)
      rotate(-351deg);
  }
}

.ru-hero-corner {
  position: absolute;

  bottom: 42px;

  display: flex;
  flex-direction: column;

  gap: 5px;

  color:
    rgba(244, 236, 217, 0.42);

  font-size: 8px;
  font-weight: 700;

  letter-spacing: 0.2em;

  text-transform: uppercase;
}

.ru-hero-corner-left {
  left: 42px;
}

.ru-hero-corner-right {
  right: 42px;
  text-align: right;
}

.ru-hero-corner span:first-child {
  color:
    rgba(234, 216, 164, 0.65);
}

.ru-eyebrow-line-right {
  transform: rotate(180deg);
}

.ru-scroll-cue {
  position: absolute;

  z-index: 15;

  left: 50%;
  bottom: 28px;

  display: flex;

  align-items: center;

  gap: 10px;

  transform: translateX(-50%);

  color:
    rgba(244, 236, 217, 0.52);

  font-size: 8px;
  font-weight: 700;

  letter-spacing: 0.22em;

  text-decoration: none;

  text-transform: uppercase;
}

.ru-scroll-line {
  width: 28px;
  height: 1px;

  background:
    rgba(244, 236, 217, 0.35);
}

.ru-scroll-arrow {
  color:
    var(--ru-gold-soft);

  font-size: 13px;
}


/* =========================================
   STORY SECTION
========================================= */

.ru-story-section {
  position: relative;

  min-height: 100svh;

  display: flex;
  align-items: center;

  padding:
    160px 8vw;

  background:
    linear-gradient(
      180deg,
      #071016 0%,
      #0a1720 100%
    );
}

.ru-story-inner {
  width: min(900px, 100%);
}

.ru-section-number {
  display: block;

  margin-bottom: 30px;

  color:
    var(--ru-gold);

  font-size: 9px;
  font-weight: 700;

  letter-spacing: 0.28em;

  text-transform: uppercase;
}

.ru-story-title {
  margin: 0;

  color:
    var(--ru-parchment);

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size:
    clamp(58px, 8vw, 116px);

  font-weight: 400;

  line-height: 0.9;

  letter-spacing: -0.055em;
}

.ru-story-title em {
  color:
    rgba(244, 236, 217, 0.62);

  font-style: italic;
}

.ru-story-copy {
  max-width: 590px;

  margin:
    48px 0 0;

  color:
    rgba(220, 235, 240, 0.62);

  font-size: 16px;

  line-height: 1.9;
}


/* =========================================
   JOURNEY
========================================= */

.ru-journey-section {
  position: relative;

  padding:
    160px 8vw;

  background:
    #0a1720;
}

.ru-journey-header {
  display: grid;

  grid-template-columns:
    1fr 1.5fr;

  gap: 80px;

  margin-bottom: 100px;
}

.ru-journey-header h2 {
  margin: 0;

  color:
    var(--ru-parchment);

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size:
    clamp(58px, 7vw, 100px);

  font-weight: 400;

  line-height: 0.91;

  letter-spacing: -0.055em;
}

.ru-journey-header h2 em {
  color:
    rgba(244, 236, 217, 0.55);

  font-style: italic;
}

.ru-journey-list {
  border-top:
    1px solid
    rgba(244, 236, 217, 0.12);
}

.ru-journey-row {
  display: grid;

  grid-template-columns:
    80px
    minmax(160px, 0.7fr)
    1.5fr
    50px;

  align-items: center;

  min-height: 120px;

  border-bottom:
    1px solid
    rgba(244, 236, 217, 0.12);

  transition:
    padding 300ms ease,
    background 300ms ease;
}

.ru-journey-row:hover {
  padding-left: 18px;
  padding-right: 18px;

  background:
    rgba(255, 255, 255, 0.025);
}

.ru-journey-number {
  color:
    var(--ru-gold);

  font-size: 10px;
  font-weight: 700;

  letter-spacing: 0.15em;
}

.ru-journey-row h3 {
  margin: 0;

  color:
    var(--ru-parchment);

  font-size: 18px;

  font-weight: 600;

  letter-spacing: 0.12em;
}

.ru-journey-row p {
  margin: 0;

  color:
    rgba(220, 235, 240, 0.5);

  font-size: 14px;

  line-height: 1.6;
}

.ru-journey-arrow {
  color:
    rgba(234, 216, 164, 0.7);

  font-size: 22px;

  text-align: right;

  transition:
    transform 220ms ease;
}

.ru-journey-row:hover .ru-journey-arrow {
  transform:
    translate(4px, -4px);
}


/* =========================================
   KNOWLEDGE
========================================= */

.ru-knowledge-section {
  position: relative;

  min-height: 100svh;

  display: flex;
  align-items: center;

  overflow: hidden;

  padding:
    150px 8vw;

  background:
    url("/assets/backgrounds/hub-bg.png")
    center / cover
    fixed;
}

.ru-knowledge-overlay {
  position: absolute;
  inset: 0;

  background:
    linear-gradient(
      90deg,
      rgba(4, 12, 17, 0.95) 0%,
      rgba(4, 12, 17, 0.78) 48%,
      rgba(4, 12, 17, 0.35) 100%
    );
}

.ru-knowledge-content {
  position: relative;
  z-index: 2;

  width: min(850px, 100%);
}

.ru-knowledge-content h2,
.ru-knowledge-content h3 {
  margin: 0;

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-weight: 400;

  letter-spacing: -0.05em;
}

.ru-knowledge-content h2 {
  color:
    rgba(244, 236, 217, 0.68);

  font-size:
    clamp(52px, 6.5vw, 94px);

  line-height: 0.95;
}

.ru-knowledge-divider {
  width: 70px;
  height: 1px;

  margin:
    38px 0;

  background:
    var(--ru-gold);
}

.ru-knowledge-content h3 {
  color:
    var(--ru-white);

  font-size:
    clamp(54px, 7vw, 105px);

  line-height: 0.9;
}

.ru-knowledge-content p {
  max-width: 510px;

  margin-top: 38px;

  color:
    rgba(244, 236, 217, 0.62);

  font-size: 15px;

  line-height: 1.8;
}


/* =========================================
   FINAL CTA
========================================= */

.ru-final-section {
  position: relative;

  min-height: 80svh;

  display: grid;

  place-items: center;

  overflow: hidden;

  background:
    radial-gradient(
      circle at center,
      #142d3a 0%,
      #09151d 48%,
      #050b10 100%
    );

  text-align: center;
}

.ru-final-section::before {
  content: "";

  position: absolute;

  width: 700px;
  height: 700px;

  left: 50%;
  top: 50%;

  transform:
    translate(-50%, -50%);

  border:
    1px solid
    rgba(234, 216, 164, 0.08);

  border-radius: 50%;

  box-shadow:
    0 0 120px
    rgba(85, 181, 236, 0.06);
