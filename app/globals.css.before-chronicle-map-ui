.ru-about-intro h1 {
  margin: 0;

  max-width: 980px;

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size:
    clamp(68px, 8vw, 126px);

  font-weight: 400;

  line-height:
    0.87;

  letter-spacing:
    -0.065em;
}

.ru-about-intro h1 em {
  color:
    rgba(220, 213, 196, 0.62);

  font-style: italic;

  font-weight: 400;
}

.ru-about-lead {
  max-width: 670px;

  margin:
    clamp(55px, 7vh, 80px)
    0
    0;

  color:
    rgba(232, 230, 222, 0.67);

  font-size:
    clamp(14px, 1.15vw, 17px);

  line-height: 1.8;

  letter-spacing: 0.01em;
}

.ru-about-secondary {
  margin:
    10px
    0
    0;

  color:
    rgba(213, 181, 112, 0.75);

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size:
    clamp(14px, 1.1vw, 16px);

  font-style: italic;
}


/* ---------------------------------------------------------
   STATEMENT
--------------------------------------------------------- */

.ru-about-statement {
  position: relative;

  z-index: 2;

  width:
    min(1100px, 86vw);

  margin:
    0 auto;

  padding:
    160px 0 210px;
}

.ru-about-statement-line {
  width: 100%;

  height: 1px;

  margin-bottom: 90px;

  background:
    linear-gradient(
      90deg,
      rgba(226, 195, 126, 0.45),
      rgba(255, 255, 255, 0.04),
      transparent
    );
}

.ru-about-statement-content {
  margin-left: 12%;
}

.ru-about-section-number,
.ru-about-principles-heading span {
  display: block;

  margin-bottom: 32px;

  color:
    #d5b66d;

  font-size: 8px;

  font-weight: 700;

  letter-spacing: 0.34em;
}

.ru-about-statement h2 {
  margin: 0;

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size:
    clamp(64px, 7vw, 108px);

  font-weight: 400;

  line-height:
    0.9;

  letter-spacing:
    -0.065em;
}

.ru-about-statement h2 em {
  color:
    rgba(226, 220, 205, 0.52);

  font-style: italic;
}

.ru-about-statement p {
  max-width: 510px;

  margin:
    55px
    0
    0;

  color:
    rgba(230, 228, 219, 0.55);

  font-size: 14px;

  line-height: 1.8;
}


/* ---------------------------------------------------------
   PRINCIPLES
--------------------------------------------------------- */

.ru-about-principles {
  position: relative;

  z-index: 2;

  width:
    min(1240px, 88vw);

  margin:
    0 auto;

  padding:
    80px 0 180px;

  display: grid;

  grid-template-columns:
    0.7fr 1.7fr;

  gap: 100px;
}

.ru-about-principles-heading p {
  margin: 0;

  color:
    rgba(235, 230, 217, 0.72);

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size:
    clamp(25px, 2.2vw, 34px);

  line-height: 1.1;
}

.ru-about-principles-list {
  border-top:
    1px solid rgba(255,255,255,0.09);
}

.ru-about-principle {
  position: relative;

  min-height: 150px;

  padding:
    35px
    50px
    35px
    0;

  display: grid;

  grid-template-columns:
    70px 170px 1fr 30px;

  align-items: start;

  gap: 20px;

  border-bottom:
    1px solid rgba(255,255,255,0.09);

  transition:
    background 350ms ease,
    padding 350ms ease;
}

.ru-about-principle:hover {
  padding-left: 18px;

  background:
    linear-gradient(
      90deg,
      rgba(218, 183, 104, 0.055),
      transparent
    );
}

.ru-about-principle-number {
  color:
    #c9a95e;

  font-size: 8px;

  letter-spacing: 0.2em;
}

.ru-about-principle h3 {
  margin: 0;

  color:
    rgba(245, 239, 226, 0.9);

  font-size: 11px;

  letter-spacing: 0.2em;
}

.ru-about-principle p {
  margin: 0;

  max-width: 430px;

  color:
    rgba(230, 227, 218, 0.5);

  font-size: 12px;

  line-height: 1.7;
}

.ru-about-principle-arrow {
  color:
    #d6b66d;

  font-size: 18px;

  transition:
    transform 300ms ease;
}

.ru-about-principle:hover
.ru-about-principle-arrow {
  transform:
    translate(4px, -4px);
}


/* ---------------------------------------------------------
   CLOSING
--------------------------------------------------------- */

.ru-about-closing {
  position: relative;

  z-index: 2;

  min-height: 700px;

  display: flex;

  align-items: center;

  justify-content: center;

  text-align: center;

  border-top:
    1px solid rgba(255,255,255,0.05);

  background:
    radial-gradient(
      circle at center,
      rgba(50, 76, 105, 0.14),
      transparent 55%
    );
}

.ru-about-closing > div {
  display: flex;

  flex-direction: column;

  align-items: center;
}

.ru-about-closing span:first-child {
  margin-bottom: 30px;

  color:
    #d6b66d;

  font-size: 8px;

  font-weight: 700;

  letter-spacing: 0.35em;
}

.ru-about-closing h2 {
  margin: 0;

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size:
    clamp(64px, 7vw, 110px);

  font-weight: 400;

  line-height: 0.9;

  letter-spacing:
    -0.06em;
}

.ru-about-closing h2 em {
  color:
    rgba(227, 218, 199, 0.5);

  font-style: italic;
}

.ru-about-enter {
  margin-top: 55px;

  display: inline-flex;

  align-items: center;

  gap: 25px;

  min-width: 245px;

  height: 52px;

  padding: 0 24px;

  justify-content: center;

  border:
    1px solid rgba(218, 187, 119, 0.7);

  border-radius: 999px;

  color:
    #f4ead7;

  font-size: 8px;

  font-weight: 700;

  letter-spacing: 0.22em;

  text-decoration: none;

  transition:
    background 300ms ease,
    box-shadow 300ms ease,
    transform 300ms ease;
}

.ru-about-enter:hover {
  transform:
    translateY(-3px);

  background:
    rgba(218, 187, 119, 0.08);

  box-shadow:
    0 0 30px rgba(218, 187, 119, 0.12);
}

.ru-about-enter span:last-child {
  color: #dfbf78;

  font-size: 16px;

  transition:
    transform 300ms ease;
}

.ru-about-enter:hover span:last-child {
  transform:
    translateX(5px);
}


/* ---------------------------------------------------------
   FOOTER
--------------------------------------------------------- */

.ru-about-footer {
  position: relative;

  z-index: 3;

  min-height: 90px;

  padding:
    0 clamp(24px, 5vw, 76px);

  display: flex;

  align-items: center;

  justify-content: space-between;

  border-top:
    1px solid rgba(255,255,255,0.06);

  color:
    rgba(230, 224, 210, 0.4);

  font-size: 7px;

  letter-spacing: 0.28em;
}


/* ---------------------------------------------------------
   RESPONSIVE
--------------------------------------------------------- */

@media (max-width: 900px) {

  .ru-about-intro {
    width: 84vw;
  }

  .ru-about-statement-content {
    margin-left: 0;
  }

  .ru-about-principles {
    grid-template-columns: 1fr;

    gap: 60px;
  }

  .ru-about-principle {
    grid-template-columns:
      50px 130px 1fr 25px;
  }
}


@media (max-width: 650px) {

  .ru-about-header {
    height: 76px;

    padding:
      0 20px;
  }

  .ru-about-page-label {
    display: none;
  }

  .ru-about-back span:last-child {
    display: none;
  }

  .ru-about-next {
    font-size: 7px;
  }

  .ru-about-intro {
    width: 88vw;

    min-height:
      calc(100svh - 76px);

    padding:
      80px 0 100px;
  }

  .ru-about-intro-label {
    margin-bottom: 24px;
  }

  .ru-about-intro h1 {
    font-size:
      clamp(52px, 14vw, 76px);

    line-height: 0.9;
  }

  .ru-about-lead {
    margin-top: 45px;

    font-size: 13px;
  }

  .ru-about-statement {
    width: 88vw;

    padding:
      110px 0 130px;
  }

  .ru-about-statement h2 {
    font-size:
      clamp(50px, 13vw, 70px);
  }

  .ru-about-statement p {
    margin-top: 40px;

    font-size: 12px;
  }

  .ru-about-principles {
    width: 88vw;

    padding:
      60px 0 120px;
  }

  .ru-about-principle {
    display: block;

    min-height: 0;

    padding: 30px 0;
  }

  .ru-about-principle-number {
    display: block;

    margin-bottom: 16px;
  }

  .ru-about-principle h3 {
    margin-bottom: 16px;
  }

  .ru-about-principle p {
    padding-right: 20px;
  }

  .ru-about-principle-arrow {
    position: absolute;

    top: 30px;

    right: 0;
  }

  .ru-about-closing {
    min-height: 560px;
  }

  .ru-about-closing h2 {
    font-size:
      clamp(48px, 13vw, 68px);
  }

  .ru-about-enter {
    min-width: 220px;

    margin-top: 40px;
  }

  .ru-about-footer {
    min-height: 75px;

    font-size: 6px;
  }

  .ru-about-footer span:last-child {
    display: none;
  }
}

@media (prefers-reduced-motion: reduce) {

  .ru-about-orbit,
  .ru-about-star {
    animation: none;
  }
}


/* =========================================================
   REALITY UNKNOWN — PREMIUM ABOUT EXPERIENCE
   ========================================================= */

.ru-about {
  --about-cream: #f3ecdc;
  --about-muted: rgba(231, 226, 214, .58);
  --about-gold: #d7b56b;
  --about-blue: #4ebfff;

  position: relative;
  min-height: 100vh;
  overflow: hidden;

  background:
    radial-gradient(
      circle at 50% 20%,
      rgba(44, 79, 125, .22),
      transparent 35%
    ),
    #06111a;

  color: var(--about-cream);
}


/* =========================================================
   GLOBAL ATMOSPHERE
   ========================================================= */

.ru-about-bg {
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
}

.ru-about-bg-image {
  position: absolute;
  inset: 0;

  background-image:
    linear-gradient(
      180deg,
      rgba(3, 9, 17, .75),
      rgba(3, 12, 20, .9)
    ),
    url("/assets/backgrounds/hub-bg.png");

  background-size: cover;
  background-position: center;

  opacity: .24;

  filter: saturate(.7) contrast(1.05);

  transform: scale(1.04);

  animation: ruAboutBackground 18s ease-in-out infinite alternate;
}

@keyframes ruAboutBackground {
  from {
    transform: scale(1.04);
  }

  to {
    transform: scale(1.09);
  }
}

.ru-about-bg-glow {
  position: absolute;

  width: 700px;
  height: 700px;

  left: 50%;
  top: 20%;

  transform: translate(-50%, -50%);

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      rgba(45, 119, 184, .15),
      transparent 65%
    );

  filter: blur(20px);
}

.ru-about-grid {
  position: absolute;
  inset: 0;

  opacity: .08;

  background-image:
    linear-gradient(
      rgba(255,255,255,.08) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(255,255,255,.08) 1px,
      transparent 1px
    );

  background-size:
    90px 90px;

  mask-image:
    linear-gradient(
      to bottom,
      black,
      transparent 80%
    );
}

.ru-about-particle {
  position: absolute;

  width: 3px;
  height: 3px;

  border-radius: 50%;

  background: #e3c87e;

  box-shadow:
    0 0 18px rgba(224, 191, 105, .9);

  animation:
    ruAboutParticle 5s ease-in-out infinite;
}

.ru-about-particle.p1 {
  top: 18%;
  left: 18%;
}

.ru-about-particle.p2 {
  top: 33%;
  right: 20%;
  animation-delay: 1s;
}

.ru-about-particle.p3 {
  top: 68%;
  left: 30%;
  animation-delay: 2s;
}

.ru-about-particle.p4 {
  top: 80%;
  right: 27%;
  animation-delay: 3s;
}

@keyframes ruAboutParticle {
  0%,100% {
    opacity: .15;
    transform: scale(.6);
  }

  50% {
    opacity: 1;
    transform: scale(1.5);
  }
}


/* =========================================================
   NAVIGATION
   ========================================================= */

.ru-about-nav {
  position: absolute;

  top: 0;
  left: 0;
  right: 0;

  height: 94px;

  padding:
    0 clamp(28px, 5vw, 78px);

  display: flex;
  align-items: center;
  justify-content: space-between;

  z-index: 20;

  border-bottom:
    1px solid rgba(255,255,255,.06);

  background:
    linear-gradient(
      180deg,
      rgba(3,9,18,.45),
      transparent
    );
}

.ru-about-brand {
  display: block;

  width: 110px;

  transition:
    transform .35s ease,
    filter .35s ease;
}

.ru-about-brand:hover {
  transform: translateY(-2px) scale(1.03);

  filter:
    drop-shadow(
      0 0 15px
      rgba(75,190,255,.25)
    );
}

.ru-about-brand img {
  width: 100%;
  height: auto;
  display: block;
}

.ru-about-location {
  position: absolute;

  left: 50%;

  transform:
    translateX(-50%);

  display: flex;
  align-items: center;
  gap: 10px;

  color:
    rgba(231,226,214,.62);

  font-size: 8px;
  font-weight: 700;

  letter-spacing: .35em;
}

.ru-about-location-dot {
  width: 5px;
  height: 5px;

  border-radius: 50%;

  background: var(--about-gold);

  box-shadow:
    0 0 12px rgba(215,181,107,.7);
}

.ru-about-nav-next {
  display: flex;
  align-items: center;
  gap: 15px;

  color:
    rgba(244,237,220,.82);

  text-decoration: none;

  font-size: 8px;
  font-weight: 700;

  letter-spacing: .25em;

  transition: color .25s ease;
}

.ru-about-nav-next strong {
  color: var(--about-gold);

  font-size: 17px;

  transition:
    transform .25s ease;
}

.ru-about-nav-next:hover {
  color: white;
}

.ru-about-nav-next:hover strong {
  transform: translateX(5px);
}


/* =========================================================
   RIGHT RAIL
   ========================================================= */

.ru-about-rail {
  position: fixed;

  right:
    clamp(25px, 4vw, 65px);

  top: 50%;

  transform:
    translateY(-50%);

  z-index: 15;

  display: flex;
  flex-direction: column;
  gap: 26px;

  align-items: center;
}

.ru-about-rail-line {
  position: absolute;

  top: 12px;
  bottom: 12px;

  width: 1px;

  background:
    linear-gradient(
      to bottom,
      transparent,
      rgba(215,181,107,.65),
      transparent
    );
}

.ru-about-rail-item {
  position: relative;

  width: 70px;

  display: flex;
  flex-direction: column;

  align-items: center;

  gap: 5px;
}

.ru-about-rail-item span {
  font-size: 7px;

  color:
    rgba(235,229,214,.35);

  letter-spacing: .15em;
}

.ru-about-rail-item i {
  width: 7px;
  height: 7px;

  border: 1px solid
    rgba(215,181,107,.65);

  border-radius: 50%;

  background: #07131c;

  transition:
    background .3s ease,
    box-shadow .3s ease,
    transform .3s ease;
}

.ru-about-rail-item label {
  font-size: 6px;

  letter-spacing: .22em;

  color:
    rgba(235,229,214,.35);
}

.ru-about-rail-item.active i,
.ru-about-rail-item:hover i {
  background: var(--about-gold);

  box-shadow:
    0 0 16px
    rgba(215,181,107,.55);

  transform: scale(1.25);
}

.ru-about-rail-item.active label,
.ru-about-rail-item:hover label {
  color: var(--about-cream);
}


/* =========================================================
   HERO
   ========================================================= */

.ru-about-hero {
  position: relative;

  z-index: 2;

  min-height: 100svh;

  padding:
    150px 12vw 100px;

  display: flex;
  align-items: center;
  justify-content: center;

  text-align: center;

  overflow: hidden;
}

.ru-about-hero-orbit {
  position: absolute;

  width: min(720px, 65vw);
  height: min(720px, 65vw);

  border:
    1px solid
    rgba(104,164,206,.12);

  border-radius: 50%;

  animation:
    ruAboutOrbit 22s linear infinite;
}

.ru-about-hero-orbit::before {
  content: "";

  position: absolute;

  inset: 14%;

  border:
    1px solid
    rgba(215,181,107,.09);

  border-radius: 50%;
}

@keyframes ruAboutOrbit {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

.ru-about-hero-content {
  position: relative;

  z-index: 3;

  max-width: 1050px;

  display: flex;
  flex-direction: column;
  align-items: center;
}

.ru-about-kicker {
  display: flex;
  align-items: center;
  gap: 14px;

  margin-bottom: 24px;

  color: var(--about-gold);

  font-size: 8px;
  font-weight: 700;

  letter-spacing: .4em;
}

.ru-about-kicker span {
  width: 34px;
  height: 1px;

  background:
    rgba(215,181,107,.6);
}

.ru-about-logo-large {
  width: 180px;

  margin-bottom: 25px;

  filter:
    drop-shadow(
      0 0 22px
      rgba(63,185,255,.16)
    );

  animation:
    ruAboutLogoFloat 5s ease-in-out infinite;
}

.ru-about-logo-large img {
  display: block;
  width: 100%;
}

@keyframes ruAboutLogoFloat {
  0%,100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-7px);
  }
}

.ru-about-hero h1 {
  margin: 0;

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-weight: 400;

  font-size:
    clamp(66px, 8.5vw, 132px);

  line-height: .84;

  letter-spacing:
    -.07em;
}

.ru-about-hero h1 em {
  color:
    rgba(231,226,213,.52);

  font-style: italic;
}

.ru-about-hero-copy {
  max-width: 620px;

  margin:
    48px auto 0;

  color:
    rgba(234,229,219,.66);

  font-size:
    clamp(13px, 1.2vw, 17px);

  line-height: 1.8;
}

.ru-about-hero-rule {
  margin-top: 32px;

  display: flex;
  align-items: center;
  gap: 14px;

  color:
    rgba(215,181,107,.68);

  font-size: 7px;
  letter-spacing: .28em;
}

.ru-about-hero-rule span {
  width: 45px;
  height: 1px;

  background:
    rgba(215,181,107,.4);
}

.ru-about-scroll {
  position: absolute;

  bottom: 34px;
  left: 50%;

  transform: translateX(-50%);

  display: flex;
  flex-direction: column;
  align-items: center;

  gap: 8px;

  color:
    rgba(231,226,214,.42);

  font-size: 7px;
  letter-spacing: .28em;
}

.ru-about-scroll-icon {
  color: var(--about-gold);

  font-size: 17px;

  animation:
    ruAboutScroll 1.7s ease-in-out infinite;
}

@keyframes ruAboutScroll {
  0%,100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(7px);
  }
}


/* =========================================================
   DIFFERENCE
   ========================================================= */

.ru-about-difference {
  position: relative;

  z-index: 2;

  width: min(1320px, 84vw);

  margin: 0 auto;

  padding:
    180px 0;
}

.ru-about-section-index,
.ru-about-eyebrow {
  color: var(--about-gold);

  font-size: 8px;

  font-weight: 700;

  letter-spacing: .34em;
}

.ru-about-difference-layout {
  margin-top: 60px;

  display: grid;

  grid-template-columns:
    1fr 1fr;

  gap: 90px;

  align-items: center;
}

.ru-about-difference-title h2 {
  margin: 25px 0 0;

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size:
    clamp(55px, 6vw, 92px);

  line-height: .9;

  font-weight: 400;

  letter-spacing: -.065em;
}

.ru-about-difference-title h2 em {
  color:
    rgba(226,220,207,.48);

  font-style: italic;
}

.ru-about-divider {
  width: 70px;

  height: 1px;

  margin:
    48px 0;

  background:
    linear-gradient(
      90deg,
      var(--about-gold),
      transparent
    );
}

.ru-about-difference-title h3 {
  margin: 0;

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size:
    clamp(34px, 4vw, 58px);

  font-weight: 400;

  line-height: .96;

  letter-spacing: -.045em;

  color:
    rgba(225,219,207,.58);
}

.ru-about-difference-title h3 strong {
  color: var(--about-cream);

  font-weight: 400;
}

.ru-about-difference-visual {
  position: relative;
}

.ru-about-image-frame {
  position: relative;

  aspect-ratio: 1 / 1.08;

  overflow: hidden;

  border:
    1px solid
    rgba(215,181,107,.2);

  background: #07131d;

  box-shadow:
    0 30px 100px
    rgba(0,0,0,.4);
}

.ru-about-image-frame::before {
  content: "";

  position: absolute;

  inset: 15px;

  border:
    1px solid
    rgba(255,255,255,.09);

  z-index: 3;

  pointer-events: none;
}

.ru-about-image-frame img {
  width: 100%;
  height: 100%;

  object-fit: cover;

  display: block;

  filter:
    brightness(.65)
    saturate(.75);

  transition:
    transform 1s cubic-bezier(.2,.8,.2,1),
    filter 1s ease;
}

.ru-about-image-frame:hover img {
  transform: scale(1.06);

  filter:
    brightness(.78)
    saturate(.95);
}

.ru-about-image-overlay {
  position: absolute;

  inset: 0;

  z-index: 2;

  background:
    linear-gradient(
      180deg,
      transparent 35%,
      rgba(2,8,15,.85)
    );
}

.ru-about-image-caption {
  position: absolute;

  left: 40px;
  right: 40px;
  bottom: 38px;

  z-index: 4;

  display: flex;
  flex-direction: column;
  gap: 9px;
}

.ru-about-image-caption span {
  color: var(--about-gold);

  font-size: 7px;

  letter-spacing: .3em;
}

.ru-about-image-caption strong {
  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size: 28px;

  font-weight: 400;

  letter-spacing: -.03em;
}

.ru-about-image-corner {
  position: absolute;

  right: 38px;
  top: 32px;

  z-index: 5;

  width: 35px;
  height: 35px;

  border:
    1px solid
    rgba(215,181,107,.45);

  display: grid;
  place-items: center;

  color: var(--about-gold);

  font-size: 15px;
}


/* =========================================================
   BELIEF
   ========================================================= */

.ru-about-belief {
  position: relative;

  z-index: 2;

  min-height: 850px;

  display: flex;
  align-items: center;
  justify-content: center;

  text-align: center;

  overflow: hidden;

  border-top:
    1px solid rgba(255,255,255,.05);

  border-bottom:
    1px solid rgba(255,255,255,.05);

  background:
    radial-gradient(
      circle at center,
      rgba(34,75,112,.23),
      transparent 55%
    );
}

.ru-about-belief-ring {
  position: absolute;

  width: min(800px, 75vw);
  height: min(800px, 75vw);

  border:
    1px solid
    rgba(75,174,228,.11);

  border-radius: 50%;

  animation:
    ruAboutRing 18s linear infinite;
}

.ru-about-belief-ring::after {
  content: "";

  position: absolute;

  inset: 14%;

  border:
    1px solid
    rgba(215,181,107,.08);

  border-radius: 50%;
}

@keyframes ruAboutRing {
  from {
    transform: rotate(0deg) scale(1);
  }

  50% {
    transform: rotate(180deg) scale(1.04);
  }

  to {
    transform: rotate(360deg) scale(1);
  }
}

.ru-about-belief-content {
  position: relative;

  z-index: 3;
}

.ru-about-belief h2 {
  margin:
    32px 0 0;

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size:
    clamp(65px, 8vw, 125px);

  font-weight: 400;

  line-height: .84;

  letter-spacing: -.07em;
}

.ru-about-belief h2 em {
  color:
    rgba(227,220,207,.48);

  font-style: italic;
}

.ru-about-belief p {
  max-width: 500px;

  margin:
    55px auto 0;

  color:
    rgba(231,226,216,.54);

  font-size: 14px;

  line-height: 1.8;
}


/* =========================================================
   JOURNEY
   ========================================================= */

.ru-about-journey {
  position: relative;

  z-index: 2;

  width: min(1320px, 84vw);

  margin: auto;

  padding:
    180px 0;
}

.ru-about-journey-heading {
  display: flex;

  justify-content: space-between;

  align-items: flex-end;

  gap: 80px;
}

.ru-about-journey-heading h2 {
  margin:
    28px 0 0;

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size:
    clamp(65px, 7vw, 108px);

  line-height: .86;

  font-weight: 400;

  letter-spacing: -.065em;
}

.ru-about-journey-heading h2 em {
  color:
    rgba(225,218,205,.48);

  font-style: italic;
}

.ru-about-journey-heading p {
  margin: 0 0 8px;

  color:
    rgba(231,226,216,.48);

  font-size: 13px;

  line-height: 1.8;

  text-align: right;
}

.ru-about-chapters {
  margin-top: 100px;

  border-top:
    1px solid
    rgba(255,255,255,.09);
}

.ru-about-chapter {
