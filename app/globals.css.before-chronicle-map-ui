  margin-top: 25px;

  font-family: Georgia, "Times New Roman", serif;

  font-size: clamp(52px, 6vw, 92px);
  line-height: .9;
  letter-spacing: -.055em;
  font-weight: 500;
}

.ru-how-steps-heading h2 em {
  display: block;

  color: rgba(245,237,219,.42);
  font-style: italic;
}

.ru-how-steps-heading > p {
  align-self: end;

  max-width: 330px;

  color: var(--how-muted);

  font-size: 14px;
  line-height: 1.8;
}

/* STEP ROW */

.ru-how-step {
  position: relative;

  min-height: 170px;

  display: grid;
  grid-template-columns: 90px 280px 1fr 50px;
  align-items: center;
  gap: 35px;

  border-bottom: 1px solid var(--how-line);

  transition:
    padding .45s ease,
    background .45s ease;
}

.ru-how-step::before {
  content: "";

  position: absolute;
  inset: 0;

  background:
    linear-gradient(
      90deg,
      rgba(216,181,104,.06),
      transparent 60%
    );

  opacity: 0;

  transition: opacity .45s ease;

  pointer-events: none;
}

.ru-how-step:hover {
  padding-left: 18px;
}

.ru-how-step:hover::before {
  opacity: 1;
}

.ru-how-step-number {
  color: var(--how-gold);

  font-size: 9px;
  letter-spacing: .25em;
}

.ru-how-step-title span {
  color: rgba(245,237,219,.45);

  font-size: 9px;
  font-weight: 700;
  letter-spacing: .3em;
}

.ru-how-step-title h3 {
  margin-top: 10px;

  font-family: Georgia, "Times New Roman", serif;

  font-size: 31px;
  font-weight: 500;
  letter-spacing: -.03em;
}

.ru-how-step-copy {
  display: grid;
  grid-template-columns: minmax(200px, 1fr) 230px;
  gap: 45px;
}

.ru-how-step-copy p {
  color: rgba(245,237,219,.55);

  font-size: 13px;
  line-height: 1.75;
}

.ru-how-step-copy span {
  align-self: center;

  color: rgba(216,181,104,.65);

  font-family: Georgia, "Times New Roman", serif;
  font-size: 13px;
  font-style: italic;
}

.ru-how-step-arrow {
  color: var(--how-gold);

  font-size: 23px;

  transition:
    transform .4s ease,
    color .3s ease;
}

.ru-how-step:hover .ru-how-step-arrow {
  transform: translate(5px, -5px);
  color: var(--how-cream);
}

/* FINAL */

.ru-how-final {
  position: relative;
  z-index: 2;

  min-height: 90vh;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  text-align: center;

  overflow: hidden;

  border-top: 1px solid var(--how-line);
}

.ru-how-orbit {
  position: absolute;

  width: min(680px, 75vw);
  height: min(680px, 75vw);

  border: 1px solid rgba(216,181,104,.12);

  border-radius: 50%;

  transform: rotate(-18deg);

  box-shadow:
    0 0 100px rgba(32,104,151,.08);
}

.ru-how-orbit::after {
  content: "";

  position: absolute;

  inset: 14% -20%;

  border: 1px solid rgba(216,181,104,.08);

  border-radius: 50%;

  transform: rotate(50deg);
}

.ru-how-final > *:not(.ru-how-orbit) {
  position: relative;
  z-index: 2;
}

.ru-how-final .ru-how-section-label {
  margin-bottom: 30px;
}

.ru-how-final h2 {
  display: flex;
  flex-direction: column;

  font-family: Georgia, "Times New Roman", serif;

  font-size: clamp(65px, 9vw, 135px);
  line-height: .82;
  letter-spacing: -.065em;
  font-weight: 500;
}

.ru-how-final h2 em {
  color: rgba(245,237,219,.4);
  font-style: italic;
}

.ru-how-final p {
  margin-top: 30px;

  color: rgba(245,237,219,.55);
}

.ru-how-cta {
  margin-top: 40px;

  min-width: 210px;
  height: 58px;

  padding: 0 24px;

  display: flex;
  align-items: center;
  justify-content: center;
  gap: 30px;

  border: 1px solid rgba(216,181,104,.7);
  border-radius: 999px;

  color: var(--how-cream);

  font-size: 10px;
  font-weight: 700;
  letter-spacing: .28em;

  transition:
    background .35s ease,
    box-shadow .35s ease,
    transform .35s ease;
}

.ru-how-cta:hover {
  background: rgba(216,181,104,.08);

  box-shadow:
    0 0 35px rgba(216,181,104,.18);

  transform: translateY(-4px);
}

.ru-how-cta b {
  font-size: 20px;
  font-weight: 400;
}

/* FOOTER */

.ru-how-footer {
  position: relative;
  z-index: 5;

  width: min(1400px, calc(100% - 80px));
  margin: 0 auto;

  min-height: 90px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  border-top: 1px solid var(--how-line);

  color: rgba(245,237,219,.34);

  font-size: 8px;
  letter-spacing: .3em;
}

.ru-how-footer a {
  color: var(--how-gold);
}

/* ANIMATION */

@keyframes ruHowWorld {
  from {
    transform: scale(1.04);
  }

  to {
    transform: scale(1.10);
  }
}

@keyframes ruHowTwinkle {
  0%, 100% {
    opacity: .25;
    transform: scale(.7);
  }

  50% {
    opacity: 1;
    transform: scale(1.5);
  }
}

@keyframes ruHowScroll {
  0%, 100% {
    opacity: .35;
    transform: scaleY(.65);
    transform-origin: top;
  }

  50% {
    opacity: 1;
    transform: scaleY(1);
    transform-origin: top;
  }
}

/* RESPONSIVE */

@media (max-width: 900px) {
  .ru-how-nav {
    width: calc(100% - 40px);
  }

  .ru-how-nav-center {
    display: none;
  }

  .ru-how-links {
    gap: 18px;
  }

  .ru-how-links a:nth-child(2) {
    display: none;
  }

  .ru-how-steps {
    width: calc(100% - 40px);
  }

  .ru-how-steps-heading {
    grid-template-columns: 1fr;
    gap: 30px;
  }

  .ru-how-step {
    grid-template-columns: 55px 1fr 40px;
    gap: 18px;
    padding: 35px 0;
  }

  .ru-how-step-copy {
    grid-column: 2 / 4;
  }

  .ru-how-step-arrow {
    grid-column: 3;
    grid-row: 1;
  }
}

@media (max-width: 600px) {
  .ru-how-nav {
    min-height: 78px;
  }

  .ru-how-brand {
    width: 56px;
  }

  .ru-how-links a {
    font-size: 8px;
  }

  .ru-how-links a:first-child {
    display: none;
  }

  .ru-how-intro {
    min-height: 82vh;
    padding-top: 60px;
  }

  .ru-how-intro h1 {
    font-size: clamp(58px, 17vw, 92px);
  }

  .ru-how-intro p {
    font-size: 14px;
  }

  .ru-how-steps {
    padding-top: 90px;
    padding-bottom: 110px;
  }

  .ru-how-steps-heading h2 {
    font-size: 55px;
  }

  .ru-how-step {
    grid-template-columns: 42px 1fr;
    gap: 14px;
  }

  .ru-how-step-arrow {
    display: none;
  }

  .ru-how-step-copy {
    grid-column: 2;
    display: block;
  }

  .ru-how-step-copy span {
    display: block;
    margin-top: 15px;
  }

  .ru-how-footer {
    width: calc(100% - 40px);
    font-size: 7px;
  }

  .ru-how-footer span:nth-child(2) {
    display: none;
  }
}


