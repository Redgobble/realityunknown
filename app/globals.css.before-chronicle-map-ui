/* =========================================================
   DECORATIVE ORBITS
   ========================================================= */

.ru-start-orbit {
  position: absolute !important;
  width: 420px !important;
  height: 420px !important;
  left: 50% !important;
  top: 50% !important;
  transform: translate(-50%, -50%) !important;
  border: 1px solid rgba(218, 181, 83, 0.09) !important;
  border-radius: 50% !important;
  pointer-events: none !important;
}

.ru-start-orbit::before,
.ru-start-orbit::after {
  content: "" !important;
  position: absolute !important;
  inset: 55px !important;
  border: 1px solid rgba(218, 181, 83, 0.07) !important;
  border-radius: 50% !important;
}

.ru-start-orbit::after {
  inset: 120px !important;
}

.ru-start-orbit span {
  position: absolute !important;
  width: 5px !important;
  height: 5px !important;
  border-radius: 50% !important;
  background: #d9b55d !important;
  box-shadow: 0 0 12px rgba(217, 181, 93, 0.65) !important;
}

.ru-start-orbit span:nth-child(1) {
  left: 50% !important;
  top: -3px !important;
}

.ru-start-orbit span:nth-child(2) {
  right: 16% !important;
  bottom: 11% !important;
}

.ru-start-orbit span:nth-child(3) {
  left: 14% !important;
  bottom: 16% !important;
}

/* corner brackets */
.ru-start-corner {
  position: absolute !important;
  width: 38px !important;
  height: 38px !important;
  opacity: 0.55 !important;
}

.ru-start-corner::before,
.ru-start-corner::after {
  content: "" !important;
  position: absolute !important;
  background: rgba(221, 184, 88, 0.65) !important;
}

.ru-start-corner-tl {
  top: 24px !important;
  left: 24px !important;
  border-top: 1px solid rgba(221, 184, 88, 0.45) !important;
  border-left: 1px solid rgba(221, 184, 88, 0.45) !important;
}

.ru-start-corner-tr {
  top: 24px !important;
  right: 24px !important;
  border-top: 1px solid rgba(221, 184, 88, 0.45) !important;
  border-right: 1px solid rgba(221, 184, 88, 0.45) !important;
}

.ru-start-corner-bl {
  bottom: 24px !important;
  left: 24px !important;
  border-bottom: 1px solid rgba(221, 184, 88, 0.45) !important;
  border-left: 1px solid rgba(221, 184, 88, 0.45) !important;
}

.ru-start-corner-br {
  bottom: 24px !important;
  right: 24px !important;
  border-bottom: 1px solid rgba(221, 184, 88, 0.45) !important;
  border-right: 1px solid rgba(221, 184, 88, 0.45) !important;
}

/* =========================================================
   ANIMATIONS
   ========================================================= */

@keyframes ru-start-pulse {
  0%, 100% {
    transform: scale(0.8);
    opacity: 0.65;
  }

  50% {
    transform: scale(1.25);
    opacity: 1;
  }
}

@keyframes ru-start-beam {
  0%, 100% {
    transform: translateY(-190px);
    opacity: 0;
  }

  30% {
