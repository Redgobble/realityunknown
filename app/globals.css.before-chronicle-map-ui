      135deg,
      rgba(4, 8, 15, 0.96),
      rgba(8, 12, 21, 0.82)
    );

  border: 1px solid rgba(226, 187, 99, 0.54);

  box-shadow:
    0 8px 24px rgba(0, 0, 0, 0.5),
    inset 0 1px 0 rgba(255, 235, 179, 0.06);

  backdrop-filter: blur(10px);

  letter-spacing: 0.2em;
}

.rx2-map-node-label.rx2-map-start span,
.rx2-map-node-label.rx2-map-end span {
  display: grid;
  place-items: center;

  width: 25px;
  height: 25px;

  border: 1px solid rgba(239, 203, 118, 0.8);

  color: #ffe5a3;

  font-size: 10px;
  font-weight: 700;

  background: rgba(255, 206, 99, 0.06);
}

.rx2-map-node-label.rx2-map-start strong,
.rx2-map-node-label.rx2-map-end strong {
  color: rgba(255, 239, 198, 0.96);
  font-size: 10px;
  letter-spacing: 0.24em;
}


/* Start = warm beacon */
.rx2-map-node-label.rx2-map-start::before {
  content: "";
  position: absolute;

  width: 9px;
  height: 9px;

  left: -5px;

  border-radius: 50%;

  background: #ffe19a;

  box-shadow:
    0 0 7px rgba(255, 231, 158, 1),
    0 0 20px rgba(255, 181, 47, 0.72);

  animation: rx4-origin-pulse 2s ease-in-out infinite;
}


/* End = cool live beacon */
.rx2-map-node-label.rx2-map-end {
  border-color: rgba(92, 190, 255, 0.48);
}

.rx2-map-node-label.rx2-map-end span {
  border-color: rgba(105, 203, 255, 0.75);
  color: #a9e2ff;
  background: rgba(56, 164, 255, 0.08);
}

.rx2-map-node-label.rx2-map-end strong {
  color: #bce9ff;
}

.rx2-map-node-label.rx2-map-end::before {
  content: "";
  position: absolute;

  width: 9px;
  height: 9px;

  left: -5px;

  border-radius: 50%;

  background: #72d1ff;

  box-shadow:
    0 0 7px rgba(120, 220, 255, 1),
    0 0 22px rgba(37, 146, 255, 0.8);

  animation: rx4-live-pulse 1.8s ease-in-out infinite;
}

@keyframes rx4-origin-pulse {
  0%,
  100% {
    transform: scale(0.85);
    opacity: 0.75;
  }

  50% {
    transform: scale(1.3);
    opacity: 1;
  }
}

@keyframes rx4-live-pulse {
  0%,
  100% {
    transform: scale(0.8);
    opacity: 0.65;
  }

  50% {
    transform: scale(1.35);
    opacity: 1;
  }
}


/* ============================================================
   DISCOVERY LEGEND
   ============================================================ */

.rx4-map-legend {
  position: absolute;
  left: 18px;
  bottom: 18px;
  z-index: 12;

  display: flex;
  align-items: center;
  gap: 13px;

  padding: 8px 12px;

  background: rgba(3, 7, 14, 0.78);
  border: 1px solid rgba(222, 183, 95, 0.18);

  backdrop-filter: blur(12px);

  box-shadow:
    0 10px 30px rgba(0, 0, 0, 0.32);

  color: rgba(231, 216, 180, 0.68);

  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    sans-serif;

  font-size: 7px;
  letter-spacing: 0.16em;
}

.rx4-legend-title {
  color: rgba(255, 221, 145, 0.72);
  font-weight: 700;
}

.rx4-map-legend > span:not(.rx4-legend-title) {
  display: inline-flex;
  align-items: center;
  gap: 5px;
}

.rx4-legend-icon {
  display: inline-block;
  width: 8px;
  height: 8px;

  border: 1px solid rgba(255, 218, 137, 0.8);
  background: rgba(255, 218, 137, 0.08);
}

.rx4-legend-icon.monument {
  transform: rotate(45deg);
}

.rx4-legend-icon.tomb {
  border-radius: 5px 5px 1px 1px;
}

.rx4-legend-icon.archaeology {
  clip-path: polygon(
    50% 0%,
    100% 25%,
    82% 100%,
    18% 100%,
    0% 25%
  );
}

.rx4-legend-icon.attraction {
  clip-path: polygon(
    50% 0%,
    61% 36%,
    100% 36%,
    69% 59%,
    81% 100%,
    50% 75%,
    19% 100%,
    31% 59%,
    0% 36%,
    39% 36%
  );
}


/* ------------------------------------------------------------
   Keep the existing old circle marker styling from interfering
   ------------------------------------------------------------ */

.rx2-map-node {
  display: none !important;
}


/* ------------------------------------------------------------
   Map should remain atmospheric but readable
   ------------------------------------------------------------ */

.rx2-map {
  position: relative;
  overflow: hidden;
}

.rx2-map::before {
  background:
    linear-gradient(
      180deg,
      rgba(2, 6, 14, 0.08),
      rgba(0, 0, 0, 0.26)
    ),
    radial-gradient(
      circle at 48% 45%,
      rgba(30, 70, 125, 0.04),
      transparent 55%
    ) !important;
}


/* ------------------------------------------------------------
   Responsive legend
   ------------------------------------------------------------ */

@media (max-width: 900px) {
  .rx4-map-legend {
    gap: 7px;
    padding: 7px 9px;
    font-size: 6px;
  }

  .rx4-map-legend .rx4-legend-title {
    display: none;
  }
}

@media (max-width: 620px) {
  .rx4-map-legend {
    display: none;
  }
}


/* ------------------------------------------------------------
   Reduced motion
   ------------------------------------------------------------ */

@media (prefers-reduced-motion: reduce) {
  .rx4-discovery *,
  .rx4-anchor-pulse,
  .rx4-leader,
  .rx4-map-node-label::before {
    animation: none !important;
  }
}

