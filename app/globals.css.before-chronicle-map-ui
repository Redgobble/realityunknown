  inset: -20px;
}

.ru-start-core i {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--ru-gold);
  box-shadow:
    0 0 12px rgba(217,182,94,.9),
    0 0 30px rgba(217,182,94,.35);
  animation: ru-core-pulse 2s infinite;
}

.ru-start-card h2 {
  position: relative;
  z-index: 3;
  margin: 0;
  font-family: "Cormorant Garamond", Georgia, serif;
  font-size: clamp(58px,5vw,78px);
  line-height: .84;
  letter-spacing: -.05em;
}

.ru-start-card p {
  position: relative;
  z-index: 3;
  max-width: 450px;
  margin: 22px 20px 28px;
  color: #7e899d;
  font-size: 12px;
  line-height: 1.75;
}

.ru-start-card > button {
  position: relative;
  z-index: 3;
  min-width: 230px;
  height: 55px;
  padding: 0 20px;
  border: 1px solid rgba(217,182,94,.65);
  background: rgba(8,14,27,.9);
  color: var(--ru-cream);
  font-size: 8px;
  font-weight: 800;
  letter-spacing: .24em;
  cursor: pointer;
  transition: .2s ease;
}

.ru-start-card > button i {
  display: inline-block;
  width: 7px;
  height: 7px;
  margin-right: 13px;
  border-radius: 50%;
  background: var(--ru-gold);
  box-shadow: 0 0 12px rgba(217,182,94,.8);
}

.ru-start-card > button span {
  margin-left: 14px;
  color: var(--ru-gold);
  font-size: 15px;
}

.ru-start-card > button:hover {
  transform: translateY(-3px);
  border-color: #f0cf70;
  box-shadow: 0 18px 45px rgba(0,0,0,.4);
}

.ru-start-corner {
  position: absolute;
  width: 34px;
  height: 34px;
  border-color: rgba(217,182,94,.42);
  z-index: 4;
}

.ru-start-corner.tl {
  top: 22px;
  left: 22px;
  border-top: 1px solid;
  border-left: 1px solid;
}

.ru-start-corner.tr {
  top: 22px;
  right: 22px;
  border-top: 1px solid;
  border-right: 1px solid;
}

.ru-start-corner.bl {
  bottom: 22px;
  left: 22px;
  border-bottom: 1px solid;
  border-left: 1px solid;
}

.ru-start-corner.br {
  bottom: 22px;
  right: 22px;
  border-bottom: 1px solid;
  border-right: 1px solid;
}

/* ============================================================
   CAMERA
   ============================================================ */

.ru-camera-shell {
  position: relative;
  width: 100%;
  height: 100%;
  min-height: 560px;
  overflow: hidden;
  background: #000;
  border: 1px solid rgba(217,182,94,.45);
}

.ru-camera-video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  background: #02050b;
}

.ru-camera-overlay {
  position: absolute;
  inset: 0;
  z-index: 2;
}

.ru-camera-overlay::before {
  content: "";
  position: absolute;
  inset: 0;
  background:
    linear-gradient(
      90deg,
      rgba(0,0,0,.22),
      transparent 25%,
      transparent 75%,
      rgba(0,0,0,.22)
    ),
    linear-gradient(
      0deg,
      rgba(0,0,0,.55),
      transparent 30%,
      transparent 70%,
      rgba(0,0,0,.3)
    );
}

.ru-camera-topbar {
  position: absolute;
  top: 20px;
  left: 20px;
  right: 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: white;
  font-size: 7px;
  font-weight: 800;
  letter-spacing: .25em;
}

.ru-camera-live {
  display: flex;
  align-items: center;
  gap: 8px;
}

.ru-camera-live i {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #68dc95;
  box-shadow: 0 0 10px rgba(104,220,149,.8);
}

.ru-camera-mode {
  color: var(--ru-gold);
}

.ru-camera-reticle {
  position: absolute;
  left: 12%;
  right: 12%;
  top: 15%;
  bottom: 20%;
  border: 1px solid rgba(225,194,111,.22);
}

.ru-camera-reticle .tl,
.ru-camera-reticle .tr,
.ru-camera-reticle .bl,
.ru-camera-reticle .br {
  position: absolute;
  width: 38px;
  height: 38px;
  border-color: rgba(230,195,102,.85);
}

.ru-camera-reticle .tl {
  left: -1px;
  top: -1px;
  border-top: 2px solid;
  border-left: 2px solid;
}

.ru-camera-reticle .tr {
  right: -1px;
  top: -1px;
  border-top: 2px solid;
  border-right: 2px solid;
}

.ru-camera-reticle .bl {
  left: -1px;
  bottom: -1px;
  border-bottom: 2px solid;
  border-left: 2px solid;
}

.ru-camera-reticle .br {
  right: -1px;
  bottom: -1px;
  border-bottom: 2px solid;
  border-right: 2px solid;
}

.ru-camera-crosshair {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 90px;
  height: 90px;
  transform: translate(-50%,-50%);
  border: 1px solid rgba(226,194,106,.35);
  border-radius: 50%;
}

.ru-camera-crosshair::before,
.ru-camera-crosshair::after {
  content: "";
  position: absolute;
  background: rgba(226,194,106,.55);
}

.ru-camera-crosshair::before {
  left: -28px;
  right: -28px;
  top: 50%;
  height: 1px;
}

.ru-camera-crosshair::after {
  top: -28px;
  bottom: -28px;
  left: 50%;
  width: 1px;
}

.ru-camera-crosshair i {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 6px;
  height: 6px;
  transform: translate(-50%,-50%);
  border-radius: 50%;
  background: #e7c263;
  box-shadow: 0 0 15px rgba(231,194,99,.8);
}

.ru-camera-scanline {
  position: absolute;
  left: 12%;
  right: 12%;
  top: 20%;
  height: 1px;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(230,195,102,.8),
    transparent
  );
  animation: ru-camera-scan 4s ease-in-out infinite;
}

.ru-camera-bottom {
  position: absolute;
  left: 20px;
  right: 20px;
  bottom: 20px;
  display: flex;
  align-items: end;
  justify-content: space-between;
}

.ru-camera-bottom small {
  display: block;
  margin-bottom: 6px;
  color: var(--ru-gold);
  font-size: 6px;
  letter-spacing: .28em;
}

.ru-camera-bottom strong {
  display: block;
  color: white;
  font-size: 9px;
  letter-spacing: .12em;
}

.ru-camera-capture-button {
  min-width: 220px;
  height: 56px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  border: 1px solid rgba(225,194,106,.78);
  background: rgba(4,10,22,.90);
  color: white;
  font-size: 8px;
  font-weight: 800;
  letter-spacing: .2em;
  cursor: pointer;
}

.ru-camera-capture-button > span:last-child {
  color: var(--ru-gold);
  font-size: 16px;
}

.ru-camera-capture-button:disabled {
  opacity: .5;
  cursor: wait;
}

.ru-camera-capture-ring {
  width: 25px;
  height: 25px;
  border: 1px solid rgba(225,194,106,.8);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ru-camera-capture-ring i {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--ru-gold);
  box-shadow: 0 0 10px rgba(217,182,94,.8);
}

.ru-camera-close {
  position: absolute;
  right: 18px;
  top: 55px;
  z-index: 5;
  border: 0;
  background: rgba(0,0,0,.45);
  color: rgba(255,255,255,.75);
  padding: 8px 10px;
  font-size: 7px;
  letter-spacing: .2em;
  cursor: pointer;
}

.ru-camera-error-overlay {
  position: absolute;
  inset: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(2,7,17,.84);
  backdrop-filter: blur(10px);
}

.ru-camera-error-card {
  width: min(420px,90%);
  padding: 40px;
  border: 1px solid rgba(217,182,94,.3);
  background: #060d1d;
  text-align: center;
}

.ru-camera-error-card small {
  color: var(--ru-gold);
  font-size: 7px;
  letter-spacing: .3em;
}

.ru-camera-error-card h2 {
  margin: 15px 0 10px;
  font-family: "Cormorant Garamond",Georgia,serif;
  font-size: 48px;
}

.ru-camera-error-card p {
  color: #8994a8;
  font-size: 12px;
  line-height: 1.7;
}

.ru-camera-error-card div {
  display: flex;
  gap: 10px;
  margin-top: 25px;
}

.ru-camera-error-card button {
  flex: 1;
  height: 45px;
  border: 1px solid rgba(217,182,94,.4);
  background: #0a1222;
  color: var(--ru-cream);
  font-size: 7px;
  font-weight: 800;
  letter-spacing: .18em;
  cursor: pointer;
}

/* ============================================================
   ANALYSIS
   ============================================================ */

.ru-analysis-screen,
.ru-validation-screen {
  position: relative;
  z-index: 2;
  min-height: calc(100svh - 82px);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.ru-analysis-ring {
  width: 150px;
  height: 150px;
  margin-bottom: 40px;
  border: 1px solid rgba(217,182,94,.25);
  border-radius: 50%;
  position: relative;
  animation: ru-orbit-spin 8s linear infinite;
}

.ru-analysis-ring::before,
.ru-analysis-ring::after {
  content: "";
  position: absolute;
  border-radius: 50%;
  border: 1px solid rgba(217,182,94,.12);
}

.ru-analysis-ring::before {
  inset: 22px;
}

.ru-analysis-ring::after {
  inset: 55px;
}

.ru-analysis-ring span {
  position: absolute;
  left: 50%;
  top: -4px;
  width: 8px;
  height: 8px;
  transform: translateX(-50%);
  border-radius: 50%;
  background: var(--ru-gold);
  box-shadow: 0 0 20px rgba(217,182,94,.9);
}

.ru-analysis-screen h1,
.ru-validation-screen h1 {
  margin: 25px 0;
  font-family: "Cormorant Garamond",Georgia,serif;
  font-size: clamp(70px,7vw,110px);
  line-height: .78;
  letter-spacing: -.055em;
}

.ru-analysis-screen h1 em,
.ru-validation-screen h1 em {
  color: #8490a8;
  font-style: italic;
}

.ru-analysis-screen p,
.ru-validation-screen p {
  max-width: 500px;
  color: #7e899d;
  font-size: 13px;
  line-height: 1.8;
}

.ru-analysis-status {
  margin-top: 30px;
  color: var(--ru-gold);
  font-size: 8px;
  font-weight: 800;
  letter-spacing: .25em;
}

.ru-analysis-status i {
  display: inline-block;
  width: 6px;
  height: 6px;
  margin-right: 9px;
  border-radius: 50%;
  background: var(--ru-gold);
  animation: ru-core-pulse 1.3s infinite;
}

/* ============================================================
   STORY
   ============================================================ */

.ru-story-screen {
  position: relative;
  z-index: 2;
  min-height: calc(100svh - 82px);
  display: grid;
  grid-template-columns: .8fr 1.2fr;
  align-items: center;
  padding: 30px 9vw 90px;
  overflow: hidden;
}

.ru-story-character {
  height: 78vh;
  display: flex;
  align-items: end;
  justify-content: center;
}

.ru-story-character img {
  max-width: 95%;
  height: 100%;
  object-fit: contain;
  filter: drop-shadow(0 35px 70px rgba(0,0,0,.65));
  animation: ru-character-float 6s ease-in-out infinite;
}

.ru-story-content {
  max-width: 720px;
}

.ru-story-content h1 {
  margin: 24px 0 28px;
  font-family: "Cormorant Garamond",Georgia,serif;
  font-size: clamp(70px,7vw,115px);
  line-height: .78;
  letter-spacing: -.055em;
}

.ru-dialogue-box {
  max-width: 650px;
  padding: 25px 30px;
  border-left: 1px solid var(--ru-gold);
  background: linear-gradient(
    90deg,
    rgba(10,18,35,.75),
    transparent
  );
}

.ru-dialogue-box small {
  color: var(--ru-gold);
  font-size: 7px;
  font-weight: 800;
  letter-spacing: .3em;
}

.ru-dialogue-box p {
  margin: 10px 0 0;
  color: #b8c0cf;
  font-family: "Cormorant Garamond",Georgia,serif;
  font-size: 25px;
  font-style: italic;
  line-height: 1.25;
}

/* ============================================================
   CHOICE
   ============================================================ */

.ru-choice-screen {
  position: relative;
  z-index: 2;
  min-height: calc(100svh - 82px);
  display: grid;
  grid-template-columns: .75fr 1.25fr;
  align-items: center;
  padding: 30px 8vw 90px;
}

.ru-choice-character {
  height: 75vh;
  display: flex;
  align-items: end;
  justify-content: center;
}

.ru-choice-character img {
  max-width: 90%;
  height: 100%;
  object-fit: contain;
  filter: drop-shadow(0 30px 65px rgba(0,0,0,.7));
}

.ru-choice-content h1 {
  margin: 24px 0 20px;
  font-family: "Cormorant Garamond",Georgia,serif;
  font-size: clamp(68px,6vw,100px);
  line-height: .78;
  letter-spacing: -.055em;
}

.ru-choice-content h1 em {
  color: #8490a8;
  font-style: italic;
}

.ru-choice-question {
  max-width: 600px;
  color: #9aa4b6;
  font-family: "Cormorant Garamond",Georgia,serif;
  font-size: 22px;
  font-style: italic;
}

.ru-choice-grid {
  display: grid;
  grid-template-columns: repeat(3,1fr);
  gap: 12px;
  margin-top: 30px;
}

.ru-choice-grid button {
  position: relative;
  min-height: 145px;
  padding: 20px;
  text-align: left;
  border: 1px solid rgba(119,143,184,.18);
  background: rgba(5,12,26,.76);
  color: var(--ru-cream);
  cursor: pointer;
  transition: .22s ease;
}

.ru-choice-grid button:hover,
.ru-choice-grid button.active {
  transform: translateY(-5px);
  border-color: rgba(217,182,94,.6);
  background: rgba(14,24,46,.9);
  box-shadow: 0 18px 40px rgba(0,0,0,.28);
}

.ru-choice-grid small {
  display: block;
  margin-bottom: 25px;
  color: var(--ru-gold);
  font-size: 7px;
  letter-spacing: .2em;
}

.ru-choice-grid strong {
  display: block;
  max-width: 160px;
  font-family: "Cormorant Garamond",Georgia,serif;
  font-size: 22px;
  line-height: 1;
}

.ru-choice-grid span {
  position: absolute;
  right: 18px;
  bottom: 16px;
  color: var(--ru-gold);
}

/* ============================================================
   MISSION
   ============================================================ */

.ru-mission-screen {
  position: relative;
  z-index: 2;
  min-height: calc(100svh - 82px);
  width: min(1350px,calc(100% - 90px));
  margin: auto;
  display: grid;
  grid-template-columns: 1fr .95fr;
  align-items: center;
  gap: 80px;
  padding: 50px 0 90px;
}

.ru-mission-left h1 {
  margin: 24px 0;
  font-family: "Cormorant Garamond",Georgia,serif;
  font-size: clamp(70px,6vw,105px);
  line-height: .8;
  letter-spacing: -.055em;
}

.ru-mission-story {
  max-width: 570px;
  color: #929caf;
  font-size: 14px;
  line-height: 1.85;
}

.ru-history {
  max-width: 570px;
  margin-top: 28px;
  padding: 20px 22px;
  border-left: 1px solid var(--ru-gold);
  background: rgba(9,17,34,.55);
}

.ru-history small,
.ru-clue small,
.ru-target small {
  color: var(--ru-gold);
  font-size: 7px;
  font-weight: 800;
  letter-spacing: .27em;
}

.ru-history p {
  margin: 8px 0 0;
  color: #9da7b8;
  font-size: 12px;
  line-height: 1.7;
}

.ru-riddle-card {
  padding: 42px;
  border: 1px solid rgba(217,182,94,.25);
  background:
    radial-gradient(
      circle at 50% 0%,
      rgba(35,59,111,.2),
      transparent 50%
    ),
    rgba(4,10,22,.92);
  box-shadow: 0 30px 80px rgba(0,0,0,.25);
}

.ru-riddle-card > span {
  color: var(--ru-gold);
  font-size: 7px;
  font-weight: 800;
  letter-spacing: .32em;
}

.ru-riddle-card h2 {
  margin: 22px 0;
  font-family: "Cormorant Garamond",Georgia,serif;
  font-size: 39px;
  line-height: 1.05;
  font-weight: 500;
}

.ru-clue,
.ru-target {
  margin-top: 22px;
  padding: 18px;
  border: 1px solid rgba(121,145,186,.14);
  background: rgba(8,15,30,.72);
}

.ru-clue p {
  margin: 8px 0 0;
  color: #aab3c2;
  font-family: "Cormorant Garamond",Georgia,serif;
  font-size: 21px;
  font-style: italic;
}

.ru-target strong {
  display: block;
  margin-top: 8px;
  color: var(--ru-cream);
  font-size: 13px;
}

.ru-target p {
  margin: 8px 0 0;
  color: #7f8b9f;
  font-size: 11px;
  line-height: 1.6;
}

.ru-riddle-card .ru-primary-button {
  margin-top: 24px;
  width: 100%;
}

/* ============================================================
   TARGET
   ============================================================ */

.ru-target-screen {
  position: relative;
  z-index: 2;
  min-height: calc(100svh - 82px);
  width: min(1500px,calc(100% - 90px));
  margin: auto;
  display: grid;
  grid-template-columns: .6fr 1.4fr;
  align-items: center;
  gap: 55px;
  padding: 45px 0 90px;
}

.ru-target-copy h1 {
  margin: 25px 0;
  font-family: "Cormorant Garamond",Georgia,serif;
  font-size: clamp(72px,6vw,105px);
  line-height: .78;
  letter-spacing: -.055em;
}

.ru-target-copy h1 em {
  color: #8792aa;
  font-style: italic;
}

.ru-target-copy p {
  color: #8490a4;
  font-size: 12px;
}

.ru-target-copy > strong {
  display: block;
  margin: 10px 0;
  color: var(--ru-cream);
  font-family: "Cormorant Garamond",Georgia,serif;
  font-size: 29px;
}

.ru-target-copy > small {
  display: block;
  max-width: 350px;
  color: #68758a;
  font-size: 11px;
  line-height: 1.6;
}

.ru-target-camera {
  height: min(650px,calc(100svh - 190px));
  min-height: 560px;
}

/* ============================================================
   VALIDATION
   ============================================================ */

.ru-validation-image {
  position: absolute;
  inset: 0;
  opacity: .13;
}

.ru-validation-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: blur(10px);
}

.ru-validation-content {
  position: relative;
  z-index: 3;
}

.ru-validation-loader {
  display: flex;
  justify-content: center;
  gap: 10px;
  margin: 30px 0;
}

.ru-validation-loader i {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--ru-gold);
  animation: ru-loader 1s infinite;
}

.ru-validation-loader i:nth-child(2) {
  animation-delay: .15s;
}

.ru-validation-loader i:nth-child(3) {
  animation-delay: .3s;
}

/* ============================================================
   RESULT
   ============================================================ */

.ru-result-screen {
  position: relative;
  z-index: 2;
  min-height: calc(100svh - 82px);
  display: grid;
  grid-template-columns: .75fr .7fr 1fr;
  align-items: center;
  padding: 30px 7vw 90px;
  overflow: hidden;
}

.ru-result-art {
  position: absolute;
  left: 0;
  top: 0;
  width: 52%;
  height: 100%;
  opacity: .17;
  pointer-events: none;
}

.ru-result-art img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.ru-result-character {
  position: relative;
  z-index: 3;
  height: 75vh;
  display: flex;
  align-items: end;
  justify-content: center;
}

.ru-result-character img {
  max-width: 100%;
  height: 100%;
  object-fit: contain;
  filter: drop-shadow(0 35px 70px rgba(0,0,0,.7));
  animation: ru-character-float 6s ease-in-out infinite;
}

.ru-result-copy {
  position: relative;
  z-index: 4;
  max-width: 650px;
}

.ru-result-copy h1 {
  margin: 25px 0;
  font-family: "Cormorant Garamond",Georgia,serif;
  font-size: clamp(72px,7vw,112px);
  line-height: .78;
  letter-spacing: -.055em;
}

.ru-result-copy h1 em {
  color: #8792aa;
  font-style: italic;
}

.ru-result-copy p {
  max-width: 500px;
  color: #8f9aac;
  font-size: 13px;
  line-height: 1.8;
}

.ru-xp-reward {
  display: inline-flex;
  align-items: baseline;
  gap: 14px;
  margin: 8px 0 15px;
}

.ru-xp-reward span {
  color: var(--ru-gold);
  font-size: 7px;
  font-weight: 800;
  letter-spacing: .25em;
}

.ru-xp-reward strong {
  color: var(--ru-cream);
  font-family: "Cormorant Garamond",Georgia,serif;
  font-size: 37px;
}

.ru-retry-clue {
