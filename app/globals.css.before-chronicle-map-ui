}


/* ============================================================
   YOU / LIVE GPS MARKER
   ============================================================ */

.rx2-map-shell [class*="you"],
.rx2-map-shell [class*="live"],
.rx2-map-stage [class*="you"],
.rx2-map-stage [class*="live"],
.rx2-route-map [class*="you"],
.rx2-route-map [class*="live"],
.rx2-map [class*="you"],
