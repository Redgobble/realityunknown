  align-items: center;
  gap: 12px;
  padding: 14px 16px;
  border: 1px solid rgba(255,255,255,.09);
  background: rgba(255,255,255,.025);
  color: rgba(245,242,234,.84);
  text-align: left;
  cursor: pointer;
  transition: .25s ease;
}

.ru-memory-option:hover:not(:disabled) {
  border-color: rgba(202,166,79,.42);
  background: rgba(202,166,79,.055);
  transform: translateY(-2px);
}

.ru-memory-option > span {
  width: 29px;
  height: 29px;
  display: grid;
  place-items: center;
  border: 1px solid rgba(202,166,79,.25);
  color: #caa64f;
  font-size: 9px;
}

.ru-memory-option strong {
  font-size: 13px;
  line-height: 1.35;
}

.ru-memory-option i {
  font-style: normal;
  color: rgba(255,255,255,.25);
}

.ru-memory-option.correct {
  border-color: rgba(80,190,125,.58);
  background: rgba(80,190,125,.07);
}

.ru-memory-option.incorrect {
  border-color: rgba(220,85,85,.58);
  background: rgba(220,85,85,.07);
}

.ru-reaction-card {
  width: min(820px, 100%);
  display: grid;
  grid-template-columns: 210px 1fr;
  align-items: center;
  gap: 30px;
  padding: 30px;
  border: 1px solid rgba(255,255,255,.10);
  background:
    linear-gradient(
      145deg,
      rgba(14,21,39,.96),
      rgba(5,9,19,.98)
    );
  box-shadow: 0 50px 130px rgba(0,0,0,.65);
}

.ru-reaction-character {
  height: 280px;
  display: grid;
  place-items: end center;
}

.ru-reaction-character img {
  width: 190px;
  height: 270px;
  object-fit: contain;
  filter: drop-shadow(0 25px 35px rgba(0,0,0,.55));
}

.ru-reaction-status {
  font-size: 9px;
  font-weight: 800;
  letter-spacing: .28em;
  color: #caa64f;
}

.ru-reaction-card h2 {
  margin: 9px 0;
  font-family: Georgia, serif;
  font-size: clamp(30px, 4vw, 48px);
  font-weight: 400;
  line-height: 1.04;
  color: #f4efe4;
}

.ru-reaction-card p {
  max-width: 500px;
  margin: 0;
  line-height: 1.65;
  color: rgba(225,222,214,.55);
}

.ru-reaction-next {
  margin-top: 25px;
}

.ru-next-modal {
  max-width: 980px;
}

.ru-next-eyebrow {
  display: block;
  font-size: 8px;
  font-weight: 800;
  letter-spacing: .30em;
  text-transform: uppercase;
  color: #caa64f;
}

.ru-next-actions {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 11px;
  margin-top: 35px;
}

.ru-next-actions button {
  position: relative;
  min-height: 185px;
  padding: 22px;
  text-align: left;
  border: 1px solid rgba(255,255,255,.09);
  background: rgba(255,255,255,.025);
  color: #f2eee4;
  cursor: pointer;
  transition: .3s ease;
}

.ru-next-actions button:hover {
  border-color: rgba(202,166,79,.45);
  background: rgba(202,166,79,.055);
  transform: translateY(-5px);
}

.ru-next-actions span {
  display: block;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: .22em;
  color: #caa64f;
}

.ru-next-actions strong {
  display: block;
  margin-top: 42px;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: .17em;
}

.ru-next-actions small {
  display: block;
  max-width: 190px;
  margin-top: 9px;
  font-size: 10px;
  line-height: 1.5;
  color: rgba(225,222,214,.42);
}

.ru-next-actions i {
  position: absolute;
  right: 18px;
  bottom: 18px;
  font-style: normal;
  font-size: 19px;
  color: #caa64f;
}

.ru-more-modal {
  max-width: 900px;
}

.ru-memory-top button {
  width: 34px;
  height: 34px;
  border: 1px solid rgba(255,255,255,.11);
  background: transparent;
  color: rgba(255,255,255,.55);
  font-size: 20px;
  cursor: pointer;
}

.ru-curiosity-list {
  display: grid;
  gap: 8px;
  margin-top: 28px;
}

.ru-curiosity-list button {
  min-height: 60px;
  display: grid;
  grid-template-columns: 35px 1fr 20px;
  align-items: center;
  gap: 12px;
  padding: 10px 14px;
  border: 1px solid rgba(255,255,255,.08);
  background: rgba(255,255,255,.025);
  color: rgba(240,237,229,.80);
  text-align: left;
  cursor: pointer;
  transition: .2s ease;
}

.ru-curiosity-list button:hover {
  border-color: rgba(202,166,79,.40);
  background: rgba(202,166,79,.05);
}

.ru-curiosity-list button span {
  color: #caa64f;
  font-size: 8px;
  letter-spacing: .15em;
}

.ru-curiosity-list button strong {
  font-size: 12px;
  line-height: 1.4;
}

.ru-curiosity-list button i {
  font-style: normal;
  color: #caa64f;
}

.ru-more-answer {
  margin-top: 20px;
  padding: 20px;
  border-left: 1px solid #caa64f;
  background: rgba(202,166,79,.035);
}

.ru-more-answer > span {
  font-size: 8px;
  font-weight: 800;
  letter-spacing: .25em;
  color: #caa64f;
}

.ru-more-answer h3 {
  margin: 8px 0;
  font-family: Georgia, serif;
  font-size: 24px;
  font-weight: 400;
  color: #f2eee5;
}

.ru-more-answer p {
  margin: 0;
  line-height: 1.65;
  color: rgba(225,222,214,.60);
}

.ru-back-next {
  margin-top: 22px;
}

.ru-story-close {
  position: absolute;
  z-index: 50;
  right: 25px;
  bottom: 25px;
  border: 0;
  background: transparent;
  color: rgba(255,255,255,.28);
  font-size: 8px;
  letter-spacing: .20em;
  cursor: pointer;
}

@keyframes ru-character-hover {
  0%, 100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-9px);
  }
}

@keyframes ru-orbit-spin {
  to {
    transform: rotate(360deg);
  }
}

@keyframes ru-story-enter {
  from {
    opacity: 0;
    transform: translateY(12px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes ru-panel-in {
  from {
    opacity: 0;
    transform: scale(.985);
  }

  to {
    opacity: 1;
    transform: scale(1);
  }
}

@media (max-width: 900px) {
  .ru-cinematic-story {
    height: calc(100svh - 64px);
    min-height: 650px;
    padding: 65px 20px 25px;
    align-items: flex-end;
  }

  .ru-cinematic-content {
    grid-template-columns: 1fr;
    width: 100%;
  }

  .ru-cinematic-character {
    position: absolute;
    right: -30px;
    top: 20px;
    width: 230px;
    height: 280px;
    opacity: .27;
    pointer-events: none;
  }

  .ru-cinematic-character img {
    width: 220px;
    max-height: 280px;
  }

  .ru-character-ring {
    width: 220px;
    height: 220px;
    top: 30px;
  }

  .ru-cinematic-dialogue h1 {
    font-size: clamp(40px, 10vw, 58px);
  }

  .ru-dialogue-text {
    font-size: 20px;
  }

  .ru-dialogue-footer {
    align-items: stretch;
    flex-direction: column;
  }

  .ru-primary-next {
    width: 100%;
  }

  .ru-memory-options {
    grid-template-columns: 1fr;
  }

  .ru-next-actions {
    grid-template-columns: 1fr;
  }

  .ru-next-actions button {
    min-height: 110px;
  }

  .ru-next-actions strong {
    margin-top: 18px;
  }

  .ru-reaction-card {
    grid-template-columns: 110px 1fr;
    gap: 18px;
    padding: 20px;
  }

  .ru-reaction-character {
    height: 190px;
  }

  .ru-reaction-character img {
    width: 105px;
    height: 185px;
  }
}

@media (max-width: 560px) {
  .ru-cinematic-top {
    font-size: 6px;
    letter-spacing: .20em;
  }

  .ru-dialogue-panel,
  .ru-memory-card,
  .ru-next-modal,
  .ru-more-modal {
    padding: 21px;
  }

  .ru-cinematic-dialogue h1 {
    font-size: 39px;
  }

  .ru-dialogue-text {
    font-size: 18px;
  }

  .ru-reaction-card {
    grid-template-columns: 1fr;
  }

  .ru-reaction-character {
    height: 125px;
  }

  .ru-reaction-character img {
    width: 90px;
    height: 125px;
  }
}

