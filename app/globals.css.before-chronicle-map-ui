/* ============================================================
   MAP FRAME — PREMIUM GLASS
   ============================================================ */

.rx2-map-shell,
.rx2-map-stage,
.rx2-route-map,
.rx2-map {
  border: 1px solid rgba(219, 178, 84, 0.26) !important;
