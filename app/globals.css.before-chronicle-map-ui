.rx2-final {
  padding: 160px 0 110px;
  text-align: center;
}

.rx2-final > span {
  color: rgba(225, 216, 199, 0.26);
  font-size: 8px;
  letter-spacing: 0.46em;
}

.rx2-final h3 {
  margin: 25px auto 15px;
  max-width: 850px;
  color: #f1eadc;
  font-size: clamp(58px, 7vw, 108px);
