/* =========================================================
   REALITY UNKNOWN — DISCOVERY SCREEN OVERRIDE
   ========================================================= */

.ru-discovery {
  position: relative !important;
  width: 100% !important;
  min-height: 100svh !important;
  overflow: hidden !important;
  background:
    radial-gradient(
      circle at 72% 42%,
      rgba(32, 67, 130, 0.30),
      transparent 34%
    ),
    radial-gradient(
      circle at 25% 75%,
      rgba(21, 43, 85, 0.28),
      transparent 38%
    ),
    #030912 !important;
}

/* Never allow the logo to become a giant background */
.ru-discovery::before {
  content: "" !important;
  position: absolute !important;
  inset: 0 !important;
  background-image:
    linear-gradient(
      rgba(3, 9, 18, 0.72),
      rgba(3, 9, 18, 0.92)
    ),
    url("/assets/backgrounds/hub-bg.png") !important;
  background-size: cover !important;
  background-position: center !important;
  opacity: 1 !important;
  z-index: 0 !important;
  pointer-events: none !important;
}

.ru-discovery::after {
  content: "" !important;
  position: absolute !important;
  inset: 0 !important;
  background:
    linear-gradient(
      90deg,
      rgba(3, 9, 18, 0.96) 0%,
      rgba(3, 9, 18, 0.68) 38%,
      rgba(3, 9, 18, 0.40) 100%
    ) !important;
  z-index: 1 !important;
  pointer-events: none !important;
}

/* Everything inside discovery must sit above atmosphere */
.ru-discovery > * {
  position: relative !important;
  z-index: 2 !important;
}

/* Main discovery layout */
.ru-discovery-shell {
  position: relative !important;
  z-index: 3 !important;
  width: min(1440px, calc(100% - 72px)) !important;
  min-height: calc(100svh - 92px) !important;
  margin: 0 auto !important;
  padding: 110px 0 70px !important;
  display: grid !important;
  grid-template-columns: minmax(330px, 0.78fr) minmax(600px, 1.22fr) !important;
  align-items: center !important;
  gap: 72px !important;
}

/* Left storytelling area */
.ru-discovery-copy {
  max-width: 540px !important;
}

.ru-discovery-copy h1 {
  margin: 18px 0 24px !important;
  font-family: "Cormorant Garamond", Georgia, serif !important;
  font-size: clamp(72px, 7vw, 118px) !important;
  line-height: 0.82 !important;
  letter-spacing: -0.055em !important;
  font-weight: 600 !important;
  color: #f6edda !important;
}

.ru-discovery-copy h1 span {
  display: block !important;
  color: rgba(197, 205, 224, 0.68) !important;
  font-style: italic !important;
  font-weight: 500 !important;
}

.ru-discovery-copy p {
  max-width: 470px !important;
  margin: 0 !important;
  color: rgba(222, 229, 241, 0.72) !important;
  font-family: "Manrope", Arial, sans-serif !important;
  font-size: 16px !important;
  line-height: 1.8 !important;
}

/* Camera / game viewport */
.ru-discovery-camera {
  position: relative !important;
  width: 100% !important;
  min-width: 0 !important;
  aspect-ratio: 16 / 10 !important;
  min-height: 520px !important;
  border: 1px solid rgba(207, 169, 73, 0.42) !important;
  background: #050b14 !important;
  box-shadow:
    0 30px 100px rgba(0, 0, 0, 0.58),
    inset 0 0 70px rgba(38, 70, 125, 0.12) !important;
  overflow: hidden !important;
}

/* Camera video */
.ru-discovery-camera video,
.ru-camera-frame video {
  width: 100% !important;
  height: 100% !important;
  object-fit: cover !important;
  display: block !important;
}

/* Remove accidental giant logo rendering */
.ru-discovery img[src*="reality_unknown_logo"] {
  max-width: 110px !important;
  max-height: 80px !important;
  width: auto !important;
  height: auto !important;
  object-fit: contain !important;
}

/* Header logo */
.ru-discovery-header-logo {
  width: 76px !important;
  height: auto !important;
  object-fit: contain !important;
}

/* Premium HUD */
.ru-discovery-hud {
  position: absolute !important;
  inset: 0 !important;
  pointer-events: none !important;
  z-index: 5 !important;
}

.ru-discovery-reticle {
  position: absolute !important;
  left: 50% !important;
  top: 50% !important;
  width: 150px !important;
  height: 150px !important;
  transform: translate(-50%, -50%) !important;
  border: 1px solid rgba(226, 190, 92, 0.35) !important;
  border-radius: 50% !important;
}

.ru-discovery-reticle::before,
.ru-discovery-reticle::after {
  content: "" !important;
  position: absolute !important;
  background: rgba(226, 190, 92, 0.45) !important;
}

.ru-discovery-reticle::before {
  width: 1px !important;
  height: 180px !important;
  left: 50% !important;
  top: -15px !important;
}

.ru-discovery-reticle::after {
  height: 1px !important;
  width: 180px !important;
  top: 50% !important;
  left: -15px !important;
}

/* Scan line */
.ru-discovery-scanline {
  position: absolute !important;
  left: 0 !important;
  right: 0 !important;
  top: 0 !important;
  height: 1px !important;
  background: rgba(227, 193, 102, 0.72) !important;
  box-shadow: 0 0 18px rgba(227, 193, 102, 0.65) !important;
  animation: ru-discovery-scan 3.2s ease-in-out infinite !important;
}

@keyframes ru-discovery-scan {
  0% {
    transform: translateY(30px);
    opacity: 0;
  }
  15% {
    opacity: 1;
  }
  50% {
    transform: translateY(470px);
    opacity: 1;
  }
  85% {
    opacity: 1;
  }
  100% {
    transform: translateY(30px);
    opacity: 0;
  }
}

/* Capture button */
.ru-discovery-capture {
  position: absolute !important;
  right: 22px !important;
  bottom: 22px !important;
  z-index: 10 !important;
  min-width: 190px !important;
  height: 58px !important;
  padding: 0 24px !important;
  border: 1px solid rgba(224, 185, 75, 0.75) !important;
  background: rgba(4, 11, 22, 0.88) !important;
  color: #f5e9ca !important;
  font-family: "Manrope", Arial, sans-serif !important;
  font-size: 11px !important;
  font-weight: 700 !important;
  letter-spacing: 0.18em !important;
  text-transform: uppercase !important;
  cursor: pointer !important;
  transition:
    transform 220ms ease,
    background 220ms ease,
    box-shadow 220ms ease !important;
}

.ru-discovery-capture:hover {
  transform: translateY(-3px) !important;
  background: rgba(221, 180, 70, 0.12) !important;
  box-shadow: 0 12px 35px rgba(205, 165, 55, 0.16) !important;
