    opacity: 0;
  }

  100% {
    transform: scale(1.5);
    opacity: 0;
  }
}


/* ============================================================
   SELECTED DISCOVERY — HERO STATE
   ============================================================ */

.rx2-map-shell [aria-current="true"],
.rx2-map-shell [data-selected="true"],
.rx2-map-stage [aria-current="true"],
.rx2-map-stage [data-selected="true"],
.rx2-route-map [aria-current="true"],
.rx2-route-map [data-selected="true"],
