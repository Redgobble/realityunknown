  justify-content: center;
  gap: 12px;
  margin-top: 34px;
}

.rx2-footer {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  padding-top: 22px;
  border-top: 1px solid rgba(220, 195, 132, 0.1);
