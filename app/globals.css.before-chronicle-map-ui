  border: 1px solid rgba(238, 203, 109, 0.22);
  backdrop-filter: blur(16px);
}

.ru-discovery-start-message span,
.ru-live-story-kicker,
.ru-live-mission > span {
  display: block;
  margin-bottom: 8px;
  font-family: var(--font-sans, "Manrope", sans-serif);
  font-size: 8px;
  font-weight: 800;
  letter-spacing: 0.28em;
  color: #e9c76c;
}

.ru-discovery-start-message strong {
  display: block;
  font-family: var(--font-display, "Cormorant Garamond", serif);
  font-size: 27px;
  font-weight: 600;
