.ru-discovery-header {
  position: relative;
  z-index: 1000;
  pointer-events: auto;
}

.ru-discovery-logo {
  position: relative;
  z-index: 1001;
  pointer-events: auto !important;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
}

.ru-discovery-logo img {
