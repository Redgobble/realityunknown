  }

  .ru-story-content,
  .ru-mission-panel {
    text-align: center;
    margin: auto;
  }

  .ru-dialogue {
    text-align: left;
  }

  .ru-objective,
  .ru-clue {
    text-align: left;
  }

  .ru-camera-bottom {
    align-items: center;
  }

  .ru-camera-bottom strong {
    display: none;
  }

  .ru-game-footer span:nth-child(2) {
    display: none;
  }
}

@media (max-width: 600px) {
  .ru-game-header {
    grid-template-columns: 1fr auto;
  }

  .ru-game-chapter {
    display: none;
  }

  .ru-game-xp span {
    font-size: 7px;
  }

  .ru-game-intro h1,
  .ru-analysis-screen h1,
  .ru-story-content h1,
