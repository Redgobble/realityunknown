   ------------------------------------------------------------ */

.rx3-leader {
  stroke: rgba(255, 215, 126, 0.58);
  stroke-width: 1;
  stroke-dasharray: 3 5;
  vector-effect: non-scaling-stroke;
  opacity: 0.72;
