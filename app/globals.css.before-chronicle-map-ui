/* =========================================================
   REALITY UNKNOWN — ROUTE EXPLORER
   ISOLATED FEATURE
   ========================================================= */

.ru-route-page {
  --route-bg: #020711;
  --route-bg-soft: #07111d;
  --route-cream: #f5eddb;
  --route-gold: #d8b568;
  --route-blue: #6ea9d6;
  --route-muted: #7d8994;
  --route-line: rgba(216, 181, 104, 0.24);

  position: relative;
  min-height: 100svh;
  overflow: hidden;
  color: var(--route-cream);
  background:
    radial-gradient(
      circle at 50% 25%,
      rgba(33, 72, 110, 0.18),
      transparent 34%
    ),
    radial-gradient(
      circle at 82% 70%,
      rgba(216, 181, 104, 0.07),
      transparent 28%
    ),
    var(--route-bg);

  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    sans-serif;
}

.ru-route-page::before {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: 0.16;
  background-image:
    linear-gradient(
      rgba(255, 255, 255, 0.025) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.025) 1px,
      transparent 1px
    );
  background-size: 56px 56px;
}

.ru-route-noise {
  position: fixed;
  inset: 0;
  z-index: 30;
  pointer-events: none;
  opacity: 0.035;
  background-image:
    url("/assets/backgrounds/hub-bg.png");
  mix-blend-mode: screen;
}

.ru-route-vignette {
  position: fixed;
  inset: 0;
  z-index: 20;
  pointer-events: none;
  box-shadow:
    inset 0 0 180px rgba(0, 0, 0, 0.9),
    inset 0 -120px 180px rgba(0, 0, 0, 0.7);
}

.ru-route-header {
  position: relative;
  z-index: 50;
  height: 92px;
  padding: 0 5vw;

  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;

  border-bottom:
    1px solid rgba(216, 181, 104, 0.12);
}

.ru-route-logo {
  display: inline-flex;
  width: max-content;
  align-items: center;
}

.ru-route-logo img {
  width: 76px;
  height: auto;
  filter:
    drop-shadow(0 0 16px rgba(110, 169, 214, 0.25));
}

.ru-route-header-status {
  display: flex;
  align-items: center;
  gap: 10px;

  font-size: 8px;
  letter-spacing: 0.32em;
  color: rgba(245, 237, 219, 0.42);
}

.ru-route-header-status strong {
  color: var(--route-gold);
  font-weight: 500;
}

.ru-route-status-dot {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: var(--route-gold);
  box-shadow:
    0 0 10px rgba(216, 181, 104, 0.8);
  animation: ru-route-pulse 2s infinite;
}

.ru-route-exit {
  justify-self: end;
  color: rgba(245, 237, 219, 0.5);
  font-size: 8px;
  letter-spacing: 0.3em;
  text-decoration: none;
  transition: color 0.25s ease;
}

.ru-route-exit:hover {
  color: var(--route-gold);
}

.ru-route-exit span {
  margin-left: 8px;
  color: var(--route-gold);
}

.ru-route-hero {
  position: relative;
  z-index: 10;
  min-height: calc(100svh - 92px);

  display: flex;
  flex-direction: column;
  align-items: center;

  text-align: center;
  padding:
    clamp(70px, 9vh, 120px)
    24px
    90px;
}

.ru-route-eyebrow {
  color: var(--route-gold);
  font-size: 8px;
  letter-spacing: 0.48em;
  margin-bottom: 25px;
}

.ru-route-hero h1 {
  margin: 0;
  max-width: 950px;

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size:
    clamp(62px, 9vw, 145px);

  font-weight: 400;
  line-height: 0.82;
  letter-spacing: -0.065em;
}

.ru-route-hero h1 em {
  display: block;
  color: rgba(245, 237, 219, 0.42);
  font-style: italic;
  padding-right: 0.45em;
}

.ru-route-hero > p {
  max-width: 620px;
  margin: 34px auto 0;

  color: rgba(245, 237, 219, 0.48);
  font-size: 13px;
  line-height: 1.8;
}

.ru-route-orbit {
  position: relative;
  width: 180px;
  height: 180px;
  margin: 40px auto 32px;
}

.ru-route-orbit-ring {
  position: absolute;
  inset: 0;
  border:
    1px solid rgba(216, 181, 104, 0.18);
  border-radius: 50%;
}

.ru-route-orbit-ring-a {
  animation:
    ru-route-orbit 12s linear infinite;
}

.ru-route-orbit-ring-b {
  inset: 25px;
  border-color: rgba(110, 169, 214, 0.2);
  animation:
    ru-route-orbit-reverse 8s linear infinite;
}

.ru-route-orbit-core {
  position: absolute;
  inset: 52px;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  border:
    1px solid rgba(216, 181, 104, 0.35);
  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      rgba(216, 181, 104, 0.11),
      rgba(2, 7, 17, 0.8)
    );

  box-shadow:
    0 0 45px rgba(216, 181, 104, 0.07);
}

.ru-route-orbit-core span {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: var(--route-gold);
  box-shadow:
    0 0 12px rgba(216, 181, 104, 0.9);
}

.ru-route-orbit-core small {
  margin-top: 7px;
  font-size: 6px;
  letter-spacing: 0.35em;
  color: rgba(245, 237, 219, 0.4);
}

.ru-route-orbit-core b {
  margin-top: 1px;
  font-size: 19px;
  font-weight: 300;
  color: var(--route-gold);
}

.ru-route-primary,
.ru-route-finish {
  position: relative;

  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 35px;

  min-width: 225px;
  height: 54px;
  padding: 0 22px;

  border:
    1px solid rgba(216, 181, 104, 0.65);
  border-radius: 999px;

  color: var(--route-cream);
  background:
    rgba(3, 10, 19, 0.76);

  font-size: 9px;
  letter-spacing: 0.28em;

  cursor: pointer;
  overflow: hidden;

  box-shadow:
    0 0 40px rgba(216, 181, 104, 0.05);

  transition:
    background 0.3s ease,
    box-shadow 0.3s ease,
    border-color 0.3s ease;
}

.ru-route-primary:hover,
.ru-route-finish:hover {
  border-color: var(--route-gold);
  background: rgba(216, 181, 104, 0.08);
  box-shadow:
    0 0 45px rgba(216, 181, 104, 0.14);
}

.ru-route-primary b,
.ru-route-finish b {
  color: var(--route-gold);
  font-size: 16px;
  font-weight: 400;
}

.ru-route-button-pulse {
  position: absolute;
  left: 19px;
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: var(--route-gold);
  box-shadow:
    0 0 14px rgba(216, 181, 104, 0.9);
}

.ru-route-processing {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 15px;
}

.ru-route-loader {
  display: flex;
  gap: 6px;
  margin-bottom: 16px;
}

.ru-route-loader i {
  display: block;
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: var(--route-gold);
  animation:
    ru-route-loading 1.2s infinite ease-in-out;
}

.ru-route-loader i:nth-child(2) {
  animation-delay: 0.15s;
}

.ru-route-loader i:nth-child(3) {
  animation-delay: 0.3s;
}

.ru-route-processing > span {
  font-size: 9px;
  letter-spacing: 0.3em;
  color: var(--route-gold);
}

.ru-route-processing small {
  margin-top: 10px;
  color: rgba(245, 237, 219, 0.28);
  font-size: 7px;
  letter-spacing: 0.24em;
}

.ru-route-travelling {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ru-route-live-card {
  display: flex;
  align-items: center;
  gap: 16px;

  max-width: 440px;
  padding: 18px 24px;

  border:
    1px solid rgba(216, 181, 104, 0.16);

  background:
    rgba(4, 13, 23, 0.72);

  text-align: left;
}

.ru-route-live-icon {
  color: #79b5d9;
  font-size: 9px;
  animation: ru-route-pulse 1.5s infinite;
}

.ru-route-live-card small {
  display: block;
  margin-bottom: 5px;

  color: var(--route-gold);
  font-size: 7px;
  letter-spacing: 0.28em;
}

.ru-route-live-card strong {
  color: rgba(245, 237, 219, 0.7);
  font-size: 12px;
  font-weight: 400;
}

.ru-route-finish {
  margin-top: 20px;
}

.ru-route-travel-hint {
  margin-top: 20px;
  color: rgba(245, 237, 219, 0.27);
  font-size: 9px;
  letter-spacing: 0.08em;
}

.ru-route-error {
  max-width: 420px;
  padding: 22px 28px;
  border: 1px solid rgba(214, 90, 82, 0.3);
  background: rgba(50, 12, 14, 0.32);
}

.ru-route-error > span {
  color: #d76e67;
  font-size: 18px;
}

.ru-route-error p {
  margin: 12px 0;
  color: rgba(245, 237, 219, 0.62);
  font-size: 11px;
  line-height: 1.7;
}

.ru-route-error button {
  border: 0;
  background: transparent;
  color: var(--route-gold);
  font-size: 8px;
  letter-spacing: 0.25em;
  cursor: pointer;
}

.ru-route-results {
  position: relative;
  z-index: 10;

  max-width: 1180px;
  margin: -20px auto 0;
  padding:
    70px 5vw
    130px;
}

.ru-route-results-head {
  display: grid;
  grid-template-columns: 1fr auto auto;
  gap: 60px;
  align-items: end;
}

.ru-route-results-head > div:first-child > span,
.ru-route-discoveries-title > span {
  color: var(--route-gold);
  font-size: 7px;
  letter-spacing: 0.38em;
}

.ru-route-results-head h2 {
  margin: 15px 0 0;

  font-family: Georgia, serif;
  font-size: clamp(42px, 5vw, 72px);
  font-weight: 400;
  line-height: 0.9;
  letter-spacing: -0.055em;
}

.ru-route-results-head h2 em {
  display: block;
  color: rgba(245, 237, 219, 0.4);
  font-style: italic;
}

.ru-route-stat {
  min-width: 110px;
  padding-left: 18px;
  border-left:
    1px solid rgba(216, 181, 104, 0.18);
}

.ru-route-stat small {
  display: block;
  color: rgba(245, 237, 219, 0.3);
  font-size: 7px;
  letter-spacing: 0.25em;
}

.ru-route-stat strong {
  display: block;
  margin-top: 7px;
  color: var(--route-cream);
  font-family: Georgia, serif;
  font-size: 29px;
  font-weight: 400;
}

.ru-route-map-panel {
  position: relative;
  height: 300px;
  margin-top: 70px;

  overflow: hidden;

  border:
    1px solid rgba(216, 181, 104, 0.14);

  background:
    radial-gradient(
      ellipse at 20% 70%,
      rgba(110, 169, 214, 0.1),
      transparent 35%
    ),
    radial-gradient(
      ellipse at 80% 20%,
      rgba(216, 181, 104, 0.08),
      transparent 35%
    ),
    #030b14;
}

.ru-route-map-grid {
  position: absolute;
  inset: 0;
  opacity: 0.4;

  background-image:
    linear-gradient(
      rgba(110, 169, 214, 0.08) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(110, 169, 214, 0.08) 1px,
      transparent 1px
    );

  background-size: 42px 42px;

  transform: perspective(500px)
    rotateX(48deg)
    scale(1.3);
  transform-origin: center bottom;
}

.ru-route-line {
  position: absolute;
  left: 10%;
  right: 10%;
  top: 53%;

  display: flex;
  align-items: center;
}

.ru-route-line-start,
.ru-route-line-end {
  position: relative;
  width: 10px;
  height: 10px;
  flex: 0 0 auto;
  border-radius: 50%;
  border: 1px solid var(--route-gold);
  background: #030b14;
  box-shadow:
    0 0 18px rgba(216, 181, 104, 0.4);
}

.ru-route-line-start::after,
.ru-route-line-end::after {
  content: "";
  position: absolute;
  inset: 3px;
  border-radius: 50%;
  background: var(--route-gold);
}

.ru-route-line-path {
  position: relative;
  height: 1px;
  flex: 1;
  background:
    repeating-linear-gradient(
      90deg,
      rgba(216, 181, 104, 0.22) 0 7px,
      transparent 7px 13px
    );
}

.ru-route-line-path i {
  display: block;
  height: 2px;
  background: linear-gradient(
    90deg,
    rgba(110, 169, 214, 0.1),
    var(--route-gold)
  );
  box-shadow:
    0 0 14px rgba(216, 181, 104, 0.5);
  transition: width 1s ease;
}

.ru-route-map-copy {
  position: absolute;
  left: 7%;
  top: 15%;
}

.ru-route-map-copy span {
  display: block;
  color: var(--route-gold);
  font-size: 7px;
  letter-spacing: 0.35em;
}

.ru-route-map-copy strong {
  display: block;
  margin-top: 7px;
  font-family: Georgia, serif;
  font-size: 36px;
  font-weight: 400;
}

.ru-route-map-copy small {
  display: block;
  margin-top: 4px;
  color: rgba(245, 237, 219, 0.32);
  font-size: 8px;
  letter-spacing: 0.1em;
}

.ru-route-map-scan {
  position: absolute;
  right: 7%;
  bottom: 15%;

  color: rgba(245, 237, 219, 0.25);
  font-size: 7px;
  letter-spacing: 0.3em;
}

.ru-route-map-scan span {
  display: inline-block;
  width: 5px;
  height: 5px;
  margin-right: 8px;
  border-radius: 50%;
  background: var(--route-gold);
  box-shadow:
    0 0 12px rgba(216, 181, 104, 0.8);
}

.ru-route-discoveries {
  margin-top: 75px;
}

.ru-route-discoveries-title {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 30px;
}

.ru-route-discoveries-title p {
  max-width: 360px;
  margin: 0;
  color: rgba(245, 237, 219, 0.32);
  font-size: 10px;
  line-height: 1.7;
}

.ru-route-place-list {
  margin-top: 30px;
  border-top:
    1px solid rgba(216, 181, 104, 0.12);
}

.ru-route-place {
  width: 100%;
  min-height: 92px;
  padding: 16px 4px;

  display: grid;
  grid-template-columns: 48px 10px 1fr 30px;
  align-items: center;
  gap: 17px;

  border: 0;
  border-bottom:
    1px solid rgba(216, 181, 104, 0.1);

  color: var(--route-cream);
  background: transparent;

  text-align: left;
  cursor: pointer;

  transition:
    padding 0.3s ease,
    background 0.3s ease;
}

.ru-route-place:hover,
.ru-route-place.is-active {
  padding-left: 18px;
  padding-right: 18px;
  background:
    linear-gradient(
      90deg,
      rgba(216, 181, 104, 0.06),
      transparent
    );
}

.ru-route-place-number {
  color: rgba(245, 237, 219, 0.2);
  font-family: Georgia, serif;
  font-size: 17px;
}

.ru-route-place-dot {
  width: 7px;
  height: 7px;
  border:
    1px solid var(--route-gold);
  border-radius: 50%;
  box-shadow:
    0 0 10px rgba(216, 181, 104, 0.3);
}

.ru-route-place-copy small {
  display: block;
  color: var(--route-gold);
  font-size: 6px;
  letter-spacing: 0.3em;
}

.ru-route-place-copy strong {
  display: block;
  margin-top: 6px;
  font-family: Georgia, serif;
  font-size: 21px;
  font-weight: 400;
}

.ru-route-place-copy p {
  margin: 5px 0 0;
  color: rgba(245, 237, 219, 0.27);
  font-size: 8px;
}

.ru-route-place > b {
  color: var(--route-gold);
  font-size: 14px;
  font-weight: 300;
}

.ru-route-place-detail {
  display: grid;
  grid-template-columns: 70px 1fr;
  gap: 24px;
  margin-top: 28px;
  padding: 28px;

  border:
    1px solid rgba(216, 181, 104, 0.16);

  background:
    linear-gradient(
      135deg,
      rgba(216, 181, 104, 0.06),
      rgba(5, 13, 23, 0.8)
    );
}

.ru-route-detail-mark {
  width: 58px;
  height: 58px;

  display: grid;
  place-items: center;

  border:
    1px solid rgba(216, 181, 104, 0.3);
  color: var(--route-gold);
  font-size: 20px;
}

.ru-route-place-detail span {
  color: var(--route-gold);
  font-size: 6px;
  letter-spacing: 0.3em;
}

.ru-route-place-detail h3 {
  margin: 8px 0;
  font-family: Georgia, serif;
  font-size: 28px;
  font-weight: 400;
}

.ru-route-place-detail p {
  max-width: 600px;
  margin: 0;
  color: rgba(245, 237, 219, 0.42);
  font-size: 10px;
  line-height: 1.7;
}

.ru-route-place-detail a {
  display: inline-block;
  margin-top: 16px;
  color: var(--route-gold);
  font-size: 7px;
  letter-spacing: 0.22em;
  text-decoration: none;
}

.ru-route-final-message {
  padding: 130px 0 20px;
  text-align: center;
}

.ru-route-final-message > span {
  color: rgba(245, 237, 219, 0.22);
  font-size: 7px;
  letter-spacing: 0.4em;
}

.ru-route-final-message h3 {
  margin: 20px 0 0;

  font-family: Georgia, serif;
  font-size: clamp(38px, 5vw, 68px);
  font-weight: 400;
  line-height: 0.95;
  letter-spacing: -0.05em;
}

.ru-route-final-message h3 em {
  display: block;
  color: rgba(245, 237, 219, 0.38);
  font-style: italic;
}

.ru-route-final-message p {
  margin-top: 20px;
  color: var(--route-gold);
  font-size: 9px;
  letter-spacing: 0.3em;
}

.ru-route-footer {
  position: relative;
  z-index: 10;

  display: flex;
  justify-content: space-between;

  padding: 24px 5vw;

  border-top:
    1px solid rgba(216, 181, 104, 0.1);

  color: rgba(245, 237, 219, 0.2);
  font-size: 6px;
  letter-spacing: 0.3em;
}

@keyframes ru-route-orbit {
  to {
    transform: rotate(360deg);
  }
}

@keyframes ru-route-orbit-reverse {
  to {
    transform: rotate(-360deg);
  }
}

@keyframes ru-route-pulse {
  0%,
  100% {
    opacity: 0.45;
  }

  50% {
    opacity: 1;
  }
}

@keyframes ru-route-loading {
  0%,
  80%,
  100% {
    transform: translateY(0);
    opacity: 0.25;
  }

  40% {
    transform: translateY(-5px);
    opacity: 1;
  }
}

@media (max-width: 720px) {
  .ru-route-header {
    height: 76px;
    padding: 0 22px;
  }

  .ru-route-logo img {
    width: 58px;
  }

  .ru-route-header-status {
    display: none;
  }

  .ru-route-hero {
    min-height: calc(100svh - 76px);
    padding-top: 65px;
  }

  .ru-route-eyebrow {
    font-size: 6px;
    letter-spacing: 0.32em;
  }

  .ru-route-hero h1 {
    font-size: clamp(58px, 19vw, 100px);
  }

  .ru-route-hero > p {
    font-size: 11px;
  }

  .ru-route-orbit {
    width: 140px;
    height: 140px;
    margin: 35px auto 25px;
  }

  .ru-route-orbit-core {
    inset: 42px;
  }

  .ru-route-results {
    padding: 55px 22px 90px;
  }

  .ru-route-results-head {
    grid-template-columns: 1fr 1fr;
    gap: 25px;
  }

  .ru-route-results-head > div:first-child {
    grid-column: 1 / -1;
  }

  .ru-route-results-head h2 {
    font-size: 48px;
  }

  .ru-route-stat {
    min-width: 0;
  }

  .ru-route-map-panel {
    height: 230px;
    margin-top: 45px;
  }

  .ru-route-discoveries {
    margin-top: 50px;
  }

  .ru-route-discoveries-title {
    display: block;
  }

  .ru-route-discoveries-title p {
    margin-top: 15px;
  }

  .ru-route-place {
    grid-template-columns: 30px 8px 1fr 20px;
    gap: 10px;
  }

  .ru-route-place-copy strong {
    font-size: 17px;
  }

  .ru-route-place-detail {
    grid-template-columns: 1fr;
    padding: 22px;
  }

  .ru-route-footer {
    gap: 15px;
    flex-wrap: wrap;
    padding: 20px 22px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .ru-route-page *,
  .ru-route-page *::before,
  .ru-route-page *::after {
    animation-duration: 0.001ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
  }
}

