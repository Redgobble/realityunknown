  }

  .ru-about-belief {
    min-height: 650px;
  }

  .ru-about-belief h2 {
    font-size:
      clamp(52px, 14vw, 76px);
  }

  .ru-about-belief p {
    width: 82vw;

    font-size: 12px;
  }

  .ru-about-journey-heading h2 {
    font-size:
      clamp(52px, 14vw, 76px);
  }

  .ru-about-chapters {
    margin-top: 65px;
  }

  .ru-about-chapter {
    min-height: 180px;

    display: block;

    padding: 30px 0;
  }

  .ru-about-chapter:hover {
    padding-left: 12px;
  }

  .ru-about-chapter-number {
    margin-bottom: 14px;
  }

  .ru-about-chapter-title {
    margin-bottom: 18px;
  }

  .ru-about-chapter p {
    max-width: 85%;

    font-size: 12px;
  }

  .ru-about-chapter-arrow {
    position: absolute;

    top: 30px;
    right: 0;
  }

  .ru-about-final {
    min-height: 620px;
  }

  .ru-about-final h2 {
    font-size:
      clamp(54px, 14vw, 76px);
  }

  .ru-about-final p {
    width: 82vw;

