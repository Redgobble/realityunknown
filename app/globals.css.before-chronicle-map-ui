/* ============================================================
   DISCOVERY HOTFIX — INTERACTION LAYER
   ============================================================ */

.ru-camera-overlay::before,
.ru-camera-overlay::after {
  pointer-events: none !important;
}

.ru-camera-overlay {
  pointer-events: none !important;
}

.ru-camera-overlay button,
.ru-camera-overlay .ru-camera-capture-button,
.ru-camera-overlay .ru-camera-close {
  pointer-events: auto !important;
}

.ru-camera-topbar,
.ru-camera-reticle,
.ru-camera-scanline,
.ru-camera-bottom {
  pointer-events: none !important;
}

.ru-camera-capture-button,
.ru-camera-close {
  position: absolute !important;
  z-index: 30 !important;
}

.ru-camera-capture-button {
  right: 20px !important;
  bottom: 20px !important;
}

.ru-camera-close {
  top: 55px !important;
  right: 18px !important;
}

/* Make the actual camera image feel cinematic */
.ru-camera-video {
  filter:
    saturate(.92)
    contrast(1.04)
    brightness(.82);
}

/* Stronger readable camera HUD */
.ru-camera-topbar,
.ru-camera-bottom {
  text-shadow:
    0 2px 8px rgba(0,0,0,.95),
    0 0 15px rgba(0,0,0,.8);
}

.ru-camera-capture-button {
  position: absolute !important;
  z-index: 50 !important;
  cursor: pointer !important;
  pointer-events: auto !important;
}

.ru-camera-capture-button:not(:disabled):hover {
  transform: translateY(-3px) scale(1.015);
}

.ru-camera-capture-button:not(:disabled):active {
  transform: translateY(0) scale(.98);
}

.ru-camera-capture-button:disabled {
  pointer-events: none !important;
}

.ru-camera-close {
  z-index: 50 !important;
  pointer-events: auto !important;
}

/* Camera focus animation */
.ru-camera-reticle {
  animation: ru-reticle-breathe 3s ease-in-out infinite;
}

@keyframes ru-reticle-breathe {
  0%,100% {
    transform: scale(.985);
    opacity: .75;
  }

  50% {
    transform: scale(1);
    opacity: 1;
  }
}

/* Strong capture flash */
.ru-camera-shell:has(
  .ru-camera-capture-button:active
)::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 45;
  pointer-events: none;
  background: white;
  animation: ru-camera-flash .22s ease-out forwards;
}

@keyframes ru-camera-flash {
  from {
    opacity: .8;
  }

  to {
    opacity: 0;
  }
}

