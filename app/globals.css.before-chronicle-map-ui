/* ============================================================
   DELHI / ORIGIN MARKER
   ============================================================ */

.rx2-map-shell [class*="origin"],
.rx2-map-stage [class*="origin"],
.rx2-route-map [class*="origin"],
.rx2-map [class*="origin"] {
