.ru-final-content {
  position: relative;
  z-index: 2;
}

.ru-final-content h2 {
  margin:
    0 0 48px;

  color:
    var(--ru-white);

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size:
    clamp(58px, 8vw, 118px);

  font-weight: 400;

  line-height: 0.88;

  letter-spacing: -0.06em;
}

.ru-final-content h2 em {
  color:
    rgba(244, 236, 217, 0.58);

  font-style: italic;
}


/* =========================================
   LANDING MOBILE
========================================= */

@media (max-width: 760px) {
  .ru-center-logo {
    width: 230px;
    height: 80px;
  }

  .ru-hero-logo {
    width: 230px;
  }

  .ru-hero-title {
    font-size:
      clamp(54px, 15vw, 82px);
  }

  .ru-hero-description br {
    display: none;
  }

  .ru-hero-corner {
    display: none;
  }

  .ru-hero-orbit-one {
    width: 500px;
  }

  .ru-hero-orbit-two {
    width: 650px;
  }

  .ru-story-section,
  .ru-journey-section,
  .ru-knowledge-section {
    padding:
      110px 24px;
  }

  .ru-journey-header {
    grid-template-columns: 1fr;
    gap: 30px;
    margin-bottom: 60px;
  }

  .ru-journey-row {
    grid-template-columns:
      42px
      1fr
      30px;

    min-height: 110px;
  }

  .ru-journey-row p {
    display: none;
  }

  .ru-journey-row h3 {
    font-size: 15px;
  }

  .ru-knowledge-section {
    background-attachment: scroll;
  }

  .ru-knowledge-overlay {
    background:
      linear-gradient(
        180deg,
        rgba(4, 12, 17, 0.94),
        rgba(4, 12, 17, 0.7)
      );
  }

  .ru-scroll-cue {
    bottom: 18px;
    font-size: 7px;
  }
}

html {
  scroll-behavior: smooth;
}

body {
  overflow-x: hidden;
}

/* =========================================================
   REALITY UNKNOWN — CINEMATIC SINGLE HERO
   ========================================================= */

.ru-home {
  position: relative;
  width: 100%;
  height: 100svh;
  min-height: 680px;
  overflow: hidden;
  background: #030913;
  color: #f7f0df;
}

/* BACKGROUND ART */
.ru-home-bg {
  position: absolute;
  inset: -2%;
  z-index: 0;

  background-image:
    url("/assets/backgrounds/landing-bg.png");

  background-size: cover;
  background-position: center center;
  background-repeat: no-repeat;

  transform: scale(1.025);

  animation: ru-home-bg-breathe 18s ease-in-out infinite;
}

@keyframes ru-home-bg-breathe {
  0%,
  100% {
    transform: scale(1.025);
  }

  50% {
    transform: scale(1.055);
  }
}

/* DEEP BLUE CINEMATIC TINT */
.ru-home-color {
  position: absolute;
  inset: 0;
  z-index: 1;

  background:
    linear-gradient(
      180deg,
      rgba(2, 7, 20, 0.28) 0%,
      rgba(4, 11, 30, 0.05) 35%,
      rgba(3, 8, 20, 0.18) 65%,
      rgba(1, 6, 13, 0.78) 100%
    );

  pointer-events: none;
}

/* CENTER ATMOSPHERE */
.ru-home-light {
  position: absolute;
  z-index: 2;

  width: 700px;
  height: 500px;

  left: 50%;
  top: 48%;

  transform: translate(-50%, -50%);

  background:
    radial-gradient(
      ellipse,
      rgba(65, 151, 216, 0.18) 0%,
      rgba(36, 86, 143, 0.08) 38%,
      transparent 72%
    );

  filter: blur(25px);

  pointer-events: none;
}

/* VIGNETTE */
.ru-home-vignette {
  position: absolute;
  inset: 0;
  z-index: 3;

  background:
    radial-gradient(
      ellipse at center,
      transparent 35%,
      rgba(0, 3, 10, 0.14) 62%,
      rgba(0, 2, 7, 0.78) 100%
    );

  pointer-events: none;
}

/* FILM GRAIN */
.ru-home-grain {
  position: absolute;
  inset: 0;
  z-index: 20;

  opacity: 0.055;

  background-image:
    url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.45'/%3E%3C/svg%3E");

  pointer-events: none;
  mix-blend-mode: overlay;
}

/* =========================================================
   PARTICLES
   ========================================================= */

.ru-home-particles {
  position: absolute;
  inset: 0;
  z-index: 4;

  pointer-events: none;
}

.ru-home-particles span {
  position: absolute;

  width: 3px;
  height: 3px;

  border-radius: 50%;

  background: rgba(255, 226, 156, 0.85);

  box-shadow:
    0 0 10px rgba(255, 208, 112, 0.7);

  animation:
    ru-home-particle
    var(--duration, 7s)
    ease-in-out
    infinite;
}

.ru-home-particles span:nth-child(1) {
  left: 31%;
  top: 22%;
  --duration: 8s;
}

.ru-home-particles span:nth-child(2) {
  left: 57%;
  top: 17%;
  --duration: 6s;
}

.ru-home-particles span:nth-child(3) {
  left: 66%;
  top: 31%;
  --duration: 9s;
}

.ru-home-particles span:nth-child(4) {
  left: 44%;
  top: 43%;
  --duration: 7s;
}

.ru-home-particles span:nth-child(5) {
  left: 38%;
  top: 68%;
  --duration: 10s;
}

.ru-home-particles span:nth-child(6) {
  left: 73%;
  top: 67%;
  --duration: 8s;
}

.ru-home-particles span:nth-child(7) {
  left: 19%;
  top: 54%;
  --duration: 11s;
}

.ru-home-particles span:nth-child(8) {
  left: 83%;
  top: 39%;
  --duration: 7s;
}

@keyframes ru-home-particle {
  0%,
  100% {
    opacity: 0.15;
    transform: translate3d(0, 0, 0) scale(0.7);
  }

  50% {
    opacity: 1;
    transform: translate3d(0, -18px, 0) scale(1.4);
  }
}

/* =========================================================
   HEADER
   ========================================================= */

.ru-home-header {
  position: absolute;
  z-index: 50;

  top: 0;
  left: 0;
  right: 0;

  height: 96px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding:
    0 clamp(28px, 4vw, 64px);

  background:
    linear-gradient(
      180deg,
      rgba(0, 3, 12, 0.3),
      transparent
    );
}

.ru-home-brand {
  display: flex;
  align-items: center;

  transition:
    transform 300ms ease,
    filter 300ms ease;
}

.ru-home-brand:hover {
  transform: translateY(-1px);
  filter:
    drop-shadow(
      0 0 16px
      rgba(237, 205, 130, 0.2)
    );
}

.ru-home-brand img {
  width: 170px;
  height: auto;

  object-fit: contain;
}

.ru-home-nav {
  display: flex;
  align-items: center;

  gap: clamp(22px, 3vw, 48px);
}

.ru-home-nav > a:not(.ru-home-nav-button) {
  position: relative;

  color:
    rgba(249, 241, 224, 0.78);

  font-size: 9px;
  font-weight: 700;

  letter-spacing: 0.22em;

  text-decoration: none;

  transition:
    color 250ms ease;
}

.ru-home-nav > a:not(.ru-home-nav-button)::after {
  content: "";

  position: absolute;

  left: 0;
  right: 100%;
  bottom: -8px;

  height: 1px;

  background:
    #e4c681;

  transition:
    right 300ms ease;
}

.ru-home-nav > a:not(.ru-home-nav-button):hover {
  color: #fff8e9;
}

.ru-home-nav > a:not(.ru-home-nav-button):hover::after {
  right: 0;
}

/* HEADER CTA */
.ru-home-nav-button {
  display: inline-flex;
  align-items: center;
  gap: 16px;

  height: 44px;

  padding:
    0 20px;

  border:
    1px solid
    rgba(225, 195, 126, 0.72);

  border-radius: 999px;

  color: #f8edda;

  font-size: 9px;
  font-weight: 700;

  letter-spacing: 0.18em;

  text-decoration: none;

  background:
    rgba(5, 12, 25, 0.25);

  backdrop-filter: blur(8px);

  box-shadow:
    inset 0 0 0 1px
    rgba(255, 255, 255, 0.025);

  transition:
    background 250ms ease,
    box-shadow 250ms ease,
    transform 250ms ease;
}

.ru-home-nav-button:hover {
  transform: translateY(-2px);

  background:
    rgba(228, 198, 129, 0.12);

  box-shadow:
    0 0 24px
    rgba(225, 190, 112, 0.18);
}

.ru-home-nav-button span {
  font-size: 18px;
  line-height: 1;

  transition:
    transform 250ms ease;
}

.ru-home-nav-button:hover span {
  transform: translateX(4px);
}

/* MENU */
.ru-home-menu {
  display: none;

  width: 40px;
  height: 40px;

  border: 0;

  background: transparent;

  cursor: pointer;
}

.ru-home-menu span {
  display: block;

  width: 23px;
  height: 1px;

  margin: 5px auto;

  background:
    rgba(248, 237, 218, 0.8);
}

/* =========================================================
   MAIN HERO
   ========================================================= */

.ru-home-hero {
  position: absolute;
  inset: 0;

  z-index: 10;

  display: flex;
  align-items: center;
  justify-content: center;

  padding:
    100px 220px 80px 100px;

  text-align: center;

  pointer-events: none;
}

.ru-home-center {
  position: relative;

  display: flex;
  flex-direction: column;
  align-items: center;

  width: min(760px, 100%);

  pointer-events: auto;
}

/* LOGO */
.ru-home-center-logo {
  position: relative;

  width: 390px;
  max-width: 46vw;

  margin-bottom: 8px;
}

.ru-home-main-logo {
  position: relative;
  z-index: 2;

  width: 100%;
  height: auto;

  object-fit: contain;

  filter:
    drop-shadow(
      0 0 18px
      rgba(82, 188, 255, 0.32)
    )
    drop-shadow(
      0 12px 30px
      rgba(0, 0, 0, 0.45)
    );
}

.ru-home-logo-glow {
  position: absolute;

  width: 65%;
  height: 65%;

  left: 50%;
  top: 50%;

  transform: translate(-50%, -50%);

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      rgba(78, 187, 255, 0.23),
      transparent 68%
    );

  filter: blur(22px);

  animation:
    ru-logo-pulse
    4s
    ease-in-out
    infinite;
}

@keyframes ru-logo-pulse {
  0%,
  100% {
    opacity: 0.4;
    transform:
      translate(-50%, -50%)
      scale(0.85);
  }

  50% {
    opacity: 0.85;
    transform:
      translate(-50%, -50%)
      scale(1.08);
  }
}

/* EYEBROW */
.ru-home-eyebrow {
  display: flex;
  align-items: center;

  gap: 13px;

  margin-top: 8px;
  margin-bottom: 18px;

  color:
    #e7cf98;

  font-size: 9px;
  font-weight: 700;

  letter-spacing: 0.3em;

  white-space: nowrap;
}

.ru-home-eyebrow span {
  display: block;

  width: 34px;
  height: 1px;

  background:
    rgba(230, 204, 142, 0.6);
}

/* TITLE */
.ru-home-title {
  margin: 0;

  color:
    #fffdf7;

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size:
    clamp(58px, 6vw, 98px);

  font-weight: 400;

  line-height: 0.89;

  letter-spacing:
    -0.065em;

  text-shadow:
    0 8px 35px
    rgba(0, 0, 0, 0.28);
}

.ru-home-title em {
  color:
    #e9c875;

  font-style: italic;

  text-shadow:
    0 0 30px
    rgba(231, 192, 103, 0.13);
}

/* DIVIDER */
.ru-home-divider {
  height: 1px;

  margin:
    25px 0 18px;

  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(236, 195, 105, 0.9),
      transparent
    );

  box-shadow:
    0 0 12px
    rgba(237, 193, 91, 0.45);
}

/* DESCRIPTION */
.ru-home-description {
  margin: 0 0 25px;

  color:
    rgba(250, 244, 232, 0.82);

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size:
    clamp(13px, 1.1vw, 16px);

  line-height: 1.55;

  text-shadow:
    0 2px 12px
    rgba(0, 0, 0, 0.5);
}

/* MAIN CTA */
.ru-home-cta {
  position: relative;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  gap: 26px;

  min-width: 270px;
  height: 62px;

  padding:
    0 28px;

  border:
    1px solid
    rgba(239, 202, 123, 0.9);

  border-radius: 999px;

  color:
    #fff4d8;

  font-size: 10px;
  font-weight: 800;

  letter-spacing: 0.22em;

  text-decoration: none;

  overflow: hidden;

  background:
    rgba(3, 10, 21, 0.44);

  backdrop-filter:
    blur(12px);

  box-shadow:
    0 0 0 1px
    rgba(255, 255, 255, 0.025),
    0 0 30px
    rgba(231, 192, 104, 0.13),
    inset 0 0 20px
    rgba(231, 192, 104, 0.035);

  transition:
    transform 300ms ease,
    box-shadow 300ms ease,
    background 300ms ease;
}

.ru-home-cta::before {
  content: "";

  position: absolute;

  inset: 0;

  background:
    linear-gradient(
      105deg,
      transparent 25%,
      rgba(255,255,255,0.13) 48%,
      transparent 70%
    );

  transform:
    translateX(-120%);

  transition:
    transform 700ms ease;
}

.ru-home-cta:hover {
  transform:
    translateY(-3px);

  background:
    rgba(231, 192, 104, 0.1);

  box-shadow:
    0 0 0 1px
    rgba(255, 255, 255, 0.04),
    0 0 45px
    rgba(231, 192, 104, 0.27),
    inset 0 0 25px
    rgba(231, 192, 104, 0.07);
}

.ru-home-cta:hover::before {
  transform:
    translateX(120%);
}

.ru-home-cta-arrow {
  position: relative;
  z-index: 2;

  font-size: 20px;

  transition:
    transform 250ms ease;
}

.ru-home-cta:hover .ru-home-cta-arrow {
  transform:
    translateX(5px);
}

/* =========================================================
   RIGHT JOURNEY
   ========================================================= */

.ru-home-journey {
  position: absolute;

  z-index: 30;

  top: 50%;
  right: 42px;

  transform: translateY(-50%);

  display: flex;
  flex-direction: column;

  gap: 26px;
}

.ru-home-journey-line {
  position: absolute;

  left: 50%;

  top: 16px;
  bottom: 16px;

  width: 1px;

  transform: translateX(-50%);

  background:
    linear-gradient(
      180deg,
      transparent,
      rgba(232, 199, 129, 0.65) 10%,
      rgba(232, 199, 129, 0.65) 90%,
      transparent
    );
}

.ru-home-journey-item {
  position: relative;

  z-index: 2;

  display: flex;
  flex-direction: column;
  align-items: center;

  width: 62px;

  gap: 5px;
}

.ru-home-journey-dot {
  display: grid;
  place-items: center;

  width: 28px;
  height: 28px;

  border:
    1px solid
    rgba(244, 226, 184, 0.72);

  border-radius: 50%;

  color:
    #f4e5c0;

  background:
    rgba(5, 12, 25, 0.7);

  backdrop-filter: blur(6px);

  font-size: 12px;

  transition:
    transform 250ms ease,
    background 250ms ease,
    box-shadow 250ms ease;
}

.ru-home-journey-item:hover .ru-home-journey-dot {
  transform: scale(1.15);

  background:
    rgba(229, 193, 111, 0.16);

  box-shadow:
    0 0 20px
    rgba(230, 195, 119, 0.24);
}

.ru-home-journey-label {
  color:
    rgba(247, 237, 216, 0.72);

  font-size: 7px;
  font-weight: 700;

  letter-spacing: 0.14em;

  text-align: center;
}

/* =========================================================
   BOTTOM DETAILS
   ========================================================= */

.ru-home-bottom-left,
.ru-home-bottom-right {
  position: absolute;

  z-index: 30;

  bottom: 29px;

  display: flex;
  flex-direction: column;

  gap: 3px;

  color:
    rgba(249, 238, 213, 0.62);

  font-size: 7px;
  font-weight: 700;

  letter-spacing: 0.18em;

  line-height: 1.4;
}

.ru-home-bottom-left {
  left: 32px;
}

.ru-home-bottom-right {
  right: 105px;

  text-align: right;
}

/* =========================================================
   SCROLL
   ========================================================= */

.ru-home-scroll {
  position: absolute;

  z-index: 30;

  left: 50%;
  bottom: 24px;

  transform: translateX(-50%);

  display: flex;
  flex-direction: column;
  align-items: center;

  gap: 7px;

  color:
    rgba(249, 239, 218, 0.7);

  font-size: 7px;
  font-weight: 700;

  letter-spacing: 0.22em;

  text-align: center;
}

.ru-home-scroll-mouse {
  width: 16px;
  height: 25px;

  border:
    1px solid
    rgba(245, 232, 204, 0.65);

  border-radius: 10px;

  display: flex;
  justify-content: center;

  padding-top: 5px;
}

.ru-home-scroll-mouse span {
  width: 2px;
  height: 5px;

  border-radius: 2px;

  background:
    rgba(245, 232, 204, 0.9);
}

.ru-home-scroll b {
  color:
    #e6c982;

  font-size: 13px;

  font-weight: 400;
}

/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 1000px) {
  .ru-home-journey {
    display: none;
  }

  .ru-home-hero {
    padding:
