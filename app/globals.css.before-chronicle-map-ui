/* ---- LIVE CINEMATIC MAP BACKGROUND ------------------------ */

.rx2-map-shell,
.rx2-map-stage,
.rx2-route-map,
.rx2-map {
  position: relative;
  overflow: hidden;
  isolation: isolate;
  background:
    linear-gradient(
      180deg,
      rgba(3, 7, 15, 0.18) 0%,
      rgba(2, 6, 14, 0.04) 42%,
      rgba(1, 4, 10, 0.42) 100%
    ),
    url("/assets/map_bg/map.png") center center / cover no-repeat !important;
}

/* Cinematic map color grade */
.rx2-map-shell::before,
.rx2-map-stage::before,
.rx2-route-map::before,
.rx2-map::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;

  background:
    radial-gradient(
      circle at 48% 42%,
      rgba(29, 55, 105, 0.08),
      transparent 38%
    ),
    radial-gradient(
      circle at 52% 48%,
      transparent 38%,
      rgba(0, 0, 0, 0.48) 100%
    ),
    linear-gradient(
      180deg,
      rgba(2, 7, 17, 0.16),
      rgba(0, 0, 0, 0.34)
    );

  mix-blend-mode: normal;
}

/* Soft blue atmospheric wash */
.rx2-map-shell::after,
.rx2-map-stage::after,
.rx2-route-map::after,
.rx2-map::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;

  background:
    radial-gradient(
      ellipse at 18% 30%,
      rgba(43, 92, 173, 0.08),
      transparent 35%
    ),
    radial-gradient(
      ellipse at 82% 70%,
      rgba(21, 111, 150, 0.07),
      transparent 35%
    );

  animation: rx2-map-atmosphere 9s ease-in-out infinite alternate;
}

@keyframes rx2-map-atmosphere {
  from {
    opacity: 0.55;
  }

  to {
    opacity: 1;
  }
}

/* Keep actual map/SVG content above the background */
.rx2-map-shell > *,
.rx2-map-stage > *,
.rx2-route-map > *,
.rx2-map > * {
  position: relative;
  z-index: 1;
}


/* ============================================================
   ROUTE — make the existing generated route feel illuminated
   ============================================================ */

/* Broad golden atmospheric glow */
.rx2-map-shell svg path,
.rx2-map-stage svg path,
.rx2-route-map svg path,
.rx2-map svg path {
  filter:
    drop-shadow(0 0 3px rgba(255, 214, 112, 0.92))
    drop-shadow(0 0 10px rgba(255, 197, 72, 0.44));
}

/* Target likely route paths without touching background paths */
.rx2-map-shell svg path[class*="route"],
.rx2-map-stage svg path[class*="route"],
.rx2-route-map svg path[class*="route"],
.rx2-map svg path[class*="route"],
.rx2-map-shell svg path[id*="route"],
.rx2-map-stage svg path[id*="route"],
.rx2-route-map svg path[id*="route"],
.rx2-map svg path[id*="route"] {
  stroke-dasharray: 9 7 !important;
  animation:
    rx2-route-flow 2.2s linear infinite,
    rx2-route-glow 3.2s ease-in-out infinite;
}

@keyframes rx2-route-flow {
  to {
    stroke-dashoffset: -32;
  }
}

@keyframes rx2-route-glow {
  0%,
  100% {
    filter:
      drop-shadow(0 0 3px rgba(255, 220, 130, 0.75))
      drop-shadow(0 0 8px rgba(255, 194, 66, 0.32));
  }

  50% {
    filter:
      drop-shadow(0 0 5px rgba(255, 231, 157, 1))
      drop-shadow(0 0 18px rgba(255, 194, 66, 0.58));
  }
}


/* ============================================================
   DISCOVERY MARKERS
   ============================================================ */

/* Existing SVG circles/nodes get a living signal */
.rx2-map-shell svg circle,
.rx2-map-stage svg circle,
.rx2-route-map svg circle,
.rx2-map svg circle {
  filter:
    drop-shadow(0 0 4px rgba(255, 213, 113, 0.8));
}

/* Classes containing node / marker / discovery */
.rx2-map-shell [class*="node"],
.rx2-map-shell [class*="marker"],
.rx2-map-shell [class*="discovery"],
.rx2-map-stage [class*="node"],
.rx2-map-stage [class*="marker"],
.rx2-map-stage [class*="discovery"],
.rx2-route-map [class*="node"],
.rx2-route-map [class*="marker"],
.rx2-route-map [class*="discovery"],
.rx2-map [class*="node"],
.rx2-map [class*="marker"],
.rx2-map [class*="discovery"] {
