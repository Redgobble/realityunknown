  }
}


/* ============================================================
   PREMIUM MARKER HALO
   ============================================================ */

.rx2-map-shell [class*="node"]::before,
.rx2-map-shell [class*="marker"]::before,
.rx2-map-shell [class*="discovery"]::before,
.rx2-map-stage [class*="node"]::before,
.rx2-map-stage [class*="marker"]::before,
.rx2-map-stage [class*="discovery"]::before,
.rx2-route-map [class*="node"]::before,
.rx2-route-map [class*="marker"]::before,
.rx2-route-map [class*="discovery"]::before,
.rx2-map [class*="node"]::before,
.rx2-map [class*="marker"]::before,
.rx2-map [class*="discovery"]::before {
  content: "";
  position: absolute;
  inset: -10px;
  border: 1px solid rgba(255, 214, 116, 0.26);
