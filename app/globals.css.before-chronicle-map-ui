}

.ru-game-error button {
  border: 0;
  background: none;
  color: #dc9a9a;
  font-size: 18px;
  cursor: pointer;
}

.ru-game-footer {
  position: fixed;
  z-index: 60;
  left: 0;
  right: 0;
  bottom: 0;
  height: 43px;
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  padding: 0 30px;
