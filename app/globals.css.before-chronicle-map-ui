    rgba(255,255,255,.09);

  transition:
    padding .4s ease,
    background .4s ease;
}

.ru-about-chapter:hover {
  padding-left: 25px;

  background:
    linear-gradient(
      90deg,
      rgba(215,181,107,.055),
      transparent 75%
    );
}

.ru-about-chapter-number {
  color: var(--about-gold);

  font-size: 8px;

  letter-spacing: .25em;
}

.ru-about-chapter-title {
  font-size: 12px;

  font-weight: 700;

  letter-spacing: .24em;
}

.ru-about-chapter p {
  max-width: 540px;

  margin: 0;

  color:
    rgba(231,226,216,.48);

  font-size: 13px;

  line-height: 1.7;
}

.ru-about-chapter-arrow {
  color: var(--about-gold);

  font-size: 20px;

  transition:
    transform .3s ease;
}

.ru-about-chapter:hover .ru-about-chapter-arrow {
  transform:
    translate(5px, -5px);
}


/* =========================================================
   FINAL
   ========================================================= */

.ru-about-final {
  position: relative;

  z-index: 2;

  min-height: 760px;

  display: flex;
  align-items: center;
  justify-content: center;

  text-align: center;

  overflow: hidden;
}

.ru-about-final-bg {
  position: absolute;

  inset: 0;

  background:
    linear-gradient(
      180deg,
      #06111a 0%,
      rgba(4,13,23,.35),
      #06111a 100%
    ),
    url("/assets/backgrounds/landing-bg.png");

  background-size: cover;
  background-position: center;

  opacity: .48;

  transition:
    transform 2s ease;
}

.ru-about-final:hover .ru-about-final-bg {
  transform: scale(1.04);
}

.ru-about-final::after {
  content: "";

  position: absolute;
  inset: 0;

  background:
    radial-gradient(
      circle at center,
      transparent,
      rgba(3,9,16,.72)
    );
}

.ru-about-final-content {
  position: relative;

  z-index: 3;

  max-width: 900px;
}

.ru-about-final h2 {
  margin:
    30px 0 0;

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size:
    clamp(70px, 8vw, 125px);

  font-weight: 400;

  line-height: .84;

  letter-spacing: -.07em;
}

.ru-about-final h2 em {
  color:
    rgba(229,221,207,.55);

  font-style: italic;
}

.ru-about-final p {
  max-width: 470px;

  margin:
    45px auto 0;

  color:
    rgba(235,229,217,.62);

  font-size: 14px;

  line-height: 1.8;
}

.ru-about-final-button {
  display: inline-flex;

  align-items: center;
  justify-content: center;

  gap: 30px;

  min-width: 275px;

  height: 58px;

  margin-top: 48px;

  padding: 0 28px;

  border:
    1px solid
    rgba(222,190,119,.75);

  border-radius: 999px;

  color: var(--about-cream);

  text-decoration: none;

  font-size: 8px;
  font-weight: 700;

  letter-spacing: .25em;

  background:
    rgba(5,13,22,.45);

  backdrop-filter:
    blur(12px);

  box-shadow:
    0 0 0 rgba(215,181,107,0);

  transition:
    transform .35s ease,
    background .35s ease,
    box-shadow .35s ease;
}

.ru-about-final-button strong {
  color: var(--about-gold);

  font-size: 19px;

  transition:
    transform .3s ease;
}

.ru-about-final-button:hover {
  transform: translateY(-4px);

  background:
    rgba(215,181,107,.08);

  box-shadow:
    0 12px 45px
    rgba(215,181,107,.14);
}

.ru-about-final-button:hover strong {
  transform: translateX(6px);
}


/* =========================================================
   FOOTER
   ========================================================= */

.ru-about-footer {
  position: relative;

  z-index: 5;

  min-height: 100px;

  padding:
    0 clamp(28px, 5vw, 78px);

  display: flex;

  justify-content: space-between;
  align-items: center;

  border-top:
    1px solid rgba(255,255,255,.06);

  color:
    rgba(231,226,216,.35);

  font-size: 7px;

  letter-spacing: .28em;
}

.ru-about-footer a {
  color:
    rgba(231,226,216,.5);

  text-decoration: none;

  transition:
    color .25s ease;
}

.ru-about-footer a:hover {
  color: var(--about-gold);
}


