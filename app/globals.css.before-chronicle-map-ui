/* ============================================================
   ERROR / BUSY / FOOTER
   ============================================================ */

.ru-global-busy {
  position: fixed;
  top: 100px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 100;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 16px;
  border: 1px solid rgba(217,182,94,.2);
  background: rgba(3,8,18,.9);
  backdrop-filter: blur(15px);
  color: var(--ru-gold);
  font-size: 7px;
  font-weight: 800;
  letter-spacing: .25em;
}

.ru-global-busy i {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--ru-gold);
  animation: ru-core-pulse 1s infinite;
}

.ru-game-error {
  position: fixed;
  left: 50%;
  bottom: 75px;
  transform: translateX(-50%);
  z-index: 100;
  width: min(760px,calc(100% - 30px));
  display: flex;
  align-items: center;
  gap: 15px;
  padding: 13px 17px;
  border: 1px solid rgba(180,83,83,.4);
  background: rgba(30,9,13,.92);
  color: #c99191;
  font-size: 10px;
}

