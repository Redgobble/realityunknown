}

.ru-discovery-start-message p {
  margin: 7px 0 0;
  font-family: var(--font-sans, "Manrope", sans-serif);
  font-size: 11px;
  line-height: 1.65;
  color: rgba(230, 234, 241, 0.6);
}

.ru-analysis-screen,
.ru-live-story,
.ru-live-mission {
  position: relative;
  width: 100%;
  min-height: 560px;
  overflow: hidden;
  background:
    radial-gradient(
      circle at 50% 42%,
      rgba(36, 58, 98, 0.34),
      transparent 46%
    ),
    linear-gradient(
      135deg,
      #071022,
      #030711
    );
  border: 1px solid rgba(238, 203, 109, 0.28);
}

.ru-analysis-screen {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.ru-analysis-orbit {
  position: absolute;
  width: 300px;
  height: 300px;
  border: 1px solid rgba(238, 203, 109, 0.1);
  border-radius: 50%;
  animation: ruAnalysisOrbit 18s linear infinite;
}

.ru-analysis-orbit span {
  position: absolute;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #e8c66d;
  box-shadow: 0 0 18px rgba(232, 198, 109, 0.9);
}

.ru-analysis-orbit span:nth-child(1) {
  top: -3px;
  left: 50%;
}

.ru-analysis-orbit span:nth-child(2) {
  right: 14px;
  top: 24%;
}

.ru-analysis-orbit span:nth-child(3) {
  bottom: 25px;
  left: 19%;
}

@keyframes ruAnalysisOrbit {
  to {
    transform: rotate(360deg);
  }
}

.ru-analysis-core {
  position: relative;
  z-index: 2;
  width: 82px;
  height: 82px;
  display: grid;
  place-items: center;
  margin-bottom: 28px;
  border: 1px solid rgba(238, 203, 109, 0.5);
  border-radius: 50%;
  color: #eac86f;
  font-size: 24px;
  box-shadow:
    0 0 60px rgba(238, 203, 109, 0.08),
    inset 0 0 30px rgba(238, 203, 109, 0.04);
  animation: ruCorePulse 2s ease-in-out infinite;
}

@keyframes ruCorePulse {
  0%,
  100% {
    transform: scale(0.96);
  }

  50% {
    transform: scale(1.05);
  }
}

.ru-analysis-kicker {
  position: relative;
  z-index: 2;
  font-family: var(--font-sans, "Manrope", sans-serif);
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.3em;
  color: #e9c76c;
}

.ru-analysis-screen h2 {
  position: relative;
  z-index: 2;
  margin: 12px 0;
  font-family: var(--font-display, "Cormorant Garamond", serif);
  font-size: clamp(56px, 7vw, 92px);
  line-height: 0.82;
  font-weight: 600;
  color: #f5ecd9;
}

.ru-analysis-screen p {
  position: relative;
  z-index: 2;
  max-width: 460px;
  margin: 18px auto;
  font-family: var(--font-sans, "Manrope", sans-serif);
  font-size: 12px;
  line-height: 1.8;
  color: rgba(224, 229, 239, 0.65);
}

.ru-analysis-progress {
  position: relative;
